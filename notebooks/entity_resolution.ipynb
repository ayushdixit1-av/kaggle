    "candidate_lengths/cand_lens is missing; do not continue"

def get_candidate_doc_len(cid):
    if isinstance(candidate_lengths_obj, dict):
        return int(candidate_lengths_obj.get(cid, 1))
    if cid < len(candidate_lengths_obj):
        v = int(candidate_lengths_obj[cid])
        return v if v > 0 else 1
    return 1

