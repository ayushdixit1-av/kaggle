}

for fold, (train_q_idx, val_q_idx) in enumerate(kf.split(unique_q)):
    train_queries = set(unique_q[train_q_idx])
    val_queries = set(unique_q[val_q_idx])

    train_mask = np.isin(q_indices, list(train_queries))
    val_mask = np.isin(q_indices, list(val_queries))

    dtrain = lgb.Dataset(X[train_mask], label=y[train_mask])
    dval = lgb.Dataset(X[val_mask], label=y[val_mask], reference=dtrain)

    bst = lgb.train(
        params,
        dtrain,
        num_boost_round=500,
        valid_sets=[dval],
        callbacks=[lgb.early_stopping(50, verbose=False)]
    )

    oof_preds[val_mask] = bst.predict(X[val_mask], num_iteration=bst.best_iteration)
    accum_gain += bst.feature_importance(importance_type="gain")

