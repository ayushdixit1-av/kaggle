import os
import re
import math
import json
import unicodedata
import random
import numpy as np
import pandas as pd
import polars as pl
from collections import defaultdict
from pathlib import Path

BASE = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource")
TRAIN = BASE / "dataset" / "train"
OUT = Path("/kaggle/working/retrieval_benchmark_v1")
OUT.mkdir(parents=True, exist_ok=True)

S1_PATH = TRAIN / "train_source1.tsv"
S2_PATH = TRAIN / "train_source2.tsv"
S3_PATH = TRAIN / "train_source3.tsv"
GT_PATH = TRAIN / "train_ground_truth.tsv"

SEED = 42
random.seed(SEED)
np.random.seed(SEED)

N_CORPUS = 10000
N_QUERIES = 100
N_POS = 80
N_NEG = 20

K_EXACT = 5
K_BM25 = 10
K_COMPOSITE = 5
K_ADDRESS = 5

RRF_K = 60.0

def normalize(x):
    if pd.isna(x):
        return ""
    x = unicodedata.normalize("NFKC", str(x)).lower()
    x = re.sub(r"[^a-z0-9\u0900-\u097f]+", " ", x)
    return re.sub(r"\s+", " ", x).strip()

def tokenize(x):
    return normalize(x).split()

def ngrams(x, n=3):
    x = normalize(x).replace(" ", "")
    if len(x) < n:
        return [x] if x else []
    return [x[i:i+n] for i in range(len(x)-n+1)]

def zip3(x):
    m = re.search(r"\b\d{3}", str(x))
    return m.group(0) if m else ""

def first_token(x):
    t = tokenize(x)
    return t[0] if t else ""

def first3_address(x):
    return normalize(x).replace(" ", "")[:3]

def rrf(rank):
    return 1.0 / (RRF_K + rank)

s1 = pd.read_csv(S1_PATH, sep="\t", dtype=str, keep_default_na=False)
s2 = pd.read_csv(S2_PATH, sep="\t", dtype=str, keep_default_na=False)
s3 = pd.read_csv(S3_PATH, sep="\t", dtype=str, keep_default_na=False)
gt = pd.read_csv(GT_PATH, sep="\t", dtype=str, keep_default_na=False)

s1 = s1.fillna("")
s2 = s2.fillna("")
s3 = s3.fillna("")
gt = gt.fillna("")

gt["matched_entity_ids"] = gt["matched_entity_ids"].fillna("")
gt["truth_list"] = gt["matched_entity_ids"].map(
    lambda x: [v.strip() for v in str(x).split(",") if v.strip()]
)

gt_map = dict(zip(gt["source1_entity_id"], gt["truth_list"]))

s2["source"] = 2
s3["source"] = 3
corpus = pd.concat([s2, s3], ignore_index=True)

positive_queries = [
    x for x in s1["entity_id"]
    if len(gt_map.get(x, [])) > 0
]

negative_queries = [
    x for x in s1["entity_id"]
    if len(gt_map.get(x, [])) == 0
]

if len(positive_queries) < N_POS:
    raise RuntimeError("Insufficient positive queries")

if len(negative_queries) < N_NEG:
    raise RuntimeError("Insufficient negative queries")

positive_selected = random.sample(positive_queries, N_POS)
negative_selected = random.sample(negative_queries, N_NEG)
query_raw_ids = positive_selected + negative_selected

query_df = s1[s1["entity_id"].isin(query_raw_ids)].copy()
query_order = {x: i for i, x in enumerate(query_raw_ids)}
query_df["query_id"] = query_df["entity_id"].map(query_order).astype(np.uint32)
query_df = query_df.sort_values("query_id").reset_index(drop=True)

forced_raw_ids = set()

for qid in positive_selected:
    forced_raw_ids.update(gt_map[qid])

corpus_id_to_row = dict(zip(corpus["entity_id"], corpus.index))

missing_forced = [
    x for x in forced_raw_ids
    if x not in corpus_id_to_row
]

if missing_forced:
    raise RuntimeError(f"Missing GT corpus entities: {len(missing_forced)}")

negative_targets = set()
for qid in negative_selected:
    negative_targets.update(gt_map[qid])

if forced_raw_ids.intersection(negative_targets):
    raise RuntimeError("Negative targets overlap forced positive targets")

forced_indices = [corpus_id_to_row[x] for x in forced_raw_ids]

remaining_indices = np.setdiff1d(
    np.arange(len(corpus), dtype=np.int64),
    np.asarray(forced_indices, dtype=np.int64),
    assume_unique=False
)

random.shuffle(remaining_indices)

need_random = N_CORPUS - len(forced_indices)

if need_random < 0:
    raise RuntimeError("Forced targets exceed Stage 0 corpus size")

random_indices = remaining_indices[:need_random]

selected_indices = np.concatenate([
    np.asarray(forced_indices, dtype=np.int64),
    random_indices
])

selected_indices = np.unique(selected_indices)

if len(selected_indices) != N_CORPUS:
    raise RuntimeError(f"Unexpected corpus size: {len(selected_indices)}")

stage0_corpus = corpus.iloc[selected_indices].copy().reset_index(drop=True)

if negative_targets.intersection(set(stage0_corpus["entity_id"])):
    raise RuntimeError("Negative target leaked into Stage 0 corpus")

query_mapping = pd.DataFrame({
    "query_id": np.arange(len(query_df), dtype=np.uint32),
    "raw_s1_id": query_df["entity_id"].astype(str).values
})

corpus_mapping = pd.DataFrame({
    "candidate_id": np.arange(len(stage0_corpus), dtype=np.uint32),
    "raw_s2_s3_id": stage0_corpus["entity_id"].astype(str).values,
    "source": stage0_corpus["source"].astype(np.uint8).values
})

query_mapping_pl = pl.from_pandas(query_mapping)
corpus_mapping_pl = pl.from_pandas(corpus_mapping)

query_mapping_pl.write_parquet(
    OUT / "query_id_mapping.parquet",
    compression="zstd"
)

corpus_mapping_pl.write_parquet(
    OUT / "corpus_id_mapping.parquet",
    compression="zstd"
)

raw_to_query = dict(
    zip(
        query_mapping["raw_s1_id"],
        query_mapping["query_id"].astype(np.uint32)
    )
)

raw_to_candidate = dict(
    zip(
        corpus_mapping["raw_s2_s3_id"],
        corpus_mapping["candidate_id"].astype(np.uint32)
    )
)

gt_edges = []

for raw_qid in query_raw_ids:
    qid = raw_to_query[raw_qid]
    for raw_cid in gt_map.get(raw_qid, []):
        if raw_cid in raw_to_candidate:
            gt_edges.append(
                (
                    np.uint32(qid),
                    np.uint32(raw_to_candidate[raw_cid])
                )
            )

gt_edges_df = pl.DataFrame(
    gt_edges,
    schema={
        "query_id": pl.UInt32,
        "candidate_id": pl.UInt32
    }
)

positive_query_ids = set(
    query_mapping[
        query_mapping["raw_s1_id"].isin(positive_selected)
    ]["query_id"].astype(int)
)

negative_query_ids = set(
    query_mapping[
        query_mapping["raw_s1_id"].isin(negative_selected)
    ]["query_id"].astype(int)
)

if set(gt_edges_df["query_id"].to_list()).intersection(negative_query_ids):
    raise RuntimeError("Negative query found in translated GT")

if gt_edges_df.height == 0:
    raise RuntimeError("Stage 0 GT has zero edges")

if gt_edges_df["query_id"].n_unique() != N_POS:
    raise RuntimeError("Not every positive query has a corpus GT target")

corpus_names = stage0_corpus["business_name"].map(normalize).tolist()
corpus_addresses = stage0_corpus["business_address"].map(normalize).tolist()
corpus_countries = stage0_corpus["country"].map(normalize).tolist()

query_names = query_df["business_name"].map(normalize).tolist()
query_addresses = query_df["business_address"].map(normalize).tolist()
query_countries = query_df["country"].map(normalize).tolist()

name_index = defaultdict(list)
address_index = defaultdict(list)
composite_index = defaultdict(list)

for cid in range(len(stage0_corpus)):
    name = corpus_names[cid]
    address = corpus_addresses[cid]
    country = corpus_countries[cid]

    if name:
        name_index[name].append(cid)

    if address:
        address_index[(country, address)].append(cid)

    key = (
        country,
        zip3(address),
        first_token(name)
    )

    if any(key):
        composite_index[key].append(cid)

token_postings = defaultdict(list)
doc_lengths = np.zeros(len(stage0_corpus), dtype=np.int32)
df = defaultdict(int)

for cid in range(len(stage0_corpus)):
    tokens = tokenize(
        corpus_names[cid] + " " + corpus_addresses[cid]
    )
    counts = defaultdict(int)

    for token in tokens:
        counts[token] += 1

    doc_lengths[cid] = len(tokens)

    for token in counts:
        token_postings[token].append(cid)
        df[token] += 1

avgdl = float(doc_lengths.mean())

N_DOCS = len(stage0_corpus)
bm25_k1 = 1.2
bm25_b = 0.75

bm25_postings = {}

for token, posting_ids in token_postings.items():
    idf = math.log(
        1.0 +
        (N_DOCS - df[token] + 0.5) /
        (df[token] + 0.5)
    )
    bm25_postings[token] = (
        np.asarray(posting_ids, dtype=np.uint32),
        idf
    )

def bm25_search(query):
    tokens = tokenize(
        query["business_name"] + " " + query["business_address"]
    )

    if not tokens:
        return []

    query_terms = list(dict.fromkeys(tokens))
    scores = defaultdict(float)

    for token in query_terms:
        if token not in bm25_postings:
            continue

        posting_ids, idf = bm25_postings[token]

        for cid in posting_ids:
            cid = int(cid)

            tf = 1
            dl = int(doc_lengths[cid])

            score = idf * (
                tf * (bm25_k1 + 1.0)
            ) / (
                tf +
                bm25_k1 * (
                    1.0 - bm25_b +
                    bm25_b * dl / max(avgdl, 1.0)
                )
            )

            scores[cid] += score

    ranked = sorted(
        scores.items(),
        key=lambda x: (-x[1], x[0])
    )

    return ranked[:K_BM25]

def deterministic_exact(query):
    name = normalize(query["business_name"])
    if not name:
        return []

    ids = name_index.get(name, [])

    return sorted(
        ids,
        key=lambda x: x
    )[:K_EXACT]

def deterministic_composite(query):
    key = (
        normalize(query["country"]),
        zip3(query["business_address"]),
        first_token(query["business_name"])
    )

    ids = composite_index.get(key, [])

    scored = []

    for cid in ids:
        score = 0.0

        if normalize(query["country"]) == corpus_countries[cid]:
            score += 1.0

        if zip3(query["business_address"]) == zip3(
            corpus_addresses[cid]
        ):
            score += 1.0

        if first_token(query["business_name"]) == first_token(
            corpus_names[cid]
        ):
            score += 1.0

        scored.append((cid, score))

    scored.sort(key=lambda x: (-x[1], x[0]))

    return scored[:K_COMPOSITE]

def deterministic_address(query):
    key = (
        normalize(query["country"]),
        normalize(query["business_address"])
    )

    ids = address_index.get(key, [])

    return sorted(ids)[:K_ADDRESS]

def retrieve_one(query):
    channel_rows = []

    exact_ids = deterministic_exact(query)

    for cid in exact_ids:
        channel_rows.append(
            (
                cid,
                1,
                rrf(1),
                0.0
            )
        )

    bm25_rows = bm25_search(query)

    for rank, (cid, score) in enumerate(bm25_rows, start=1):
        channel_rows.append(
            (
                int(cid),
                2,
                rrf(rank),
                float(score)
            )
        )

    composite_rows = deterministic_composite(query)

    for cid, score in composite_rows:
        channel_rows.append(
            (
                int(cid),
                4,
                rrf(1),
                0.0
            )
        )

    address_ids = deterministic_address(query)

    for cid in address_ids:
        channel_rows.append(
            (
                int(cid),
                8,
                rrf(1),
                0.0
            )
        )

    merged = {}

    for cid, mask, rrf_value, bm25_value in channel_rows:
        if cid not in merged:
            merged[cid] = {
                "channel_mask": int(mask),
                "rrf_score": float(rrf_value),
                "bm25_score": float(bm25_value)
            }
        else:
            merged[cid]["channel_mask"] |= int(mask)
            merged[cid]["rrf_score"] += float(rrf_value)
            merged[cid]["bm25_score"] = max(
                merged[cid]["bm25_score"],
                float(bm25_value)
            )

    rows = []

    for cid, values in merged.items():
        rows.append({
            "candidate_id": np.uint32(cid),
            "rrf_score": np.float32(values["rrf_score"]),
            "bm25_score": np.float32(values["bm25_score"]),
            "channel_mask": np.uint8(values["channel_mask"])
        })

    rows.sort(
        key=lambda x: (
            -float(x["rrf_score"]),
            -float(x["bm25_score"]),
            int(x["candidate_id"])
        )
    )

    return rows

candidate_rows = []

for query_id in range(len(query_df)):
    query = query_df.iloc[query_id]
    retrieved = retrieve_one(query)

    seen = set()

    for row in retrieved:
        cid = int(row["candidate_id"])

        if cid in seen:
            raise RuntimeError(
                f"Duplicate candidate emitted for query {query_id}"
            )

        seen.add(cid)

        candidate_rows.append({
            "query_id": np.uint32(query_id),
            "candidate_id": np.uint32(cid),
            "rrf_score": np.float32(row["rrf_score"]),
            "bm25_score": np.float32(row["bm25_score"]),
            "channel_mask": np.uint8(row["channel_mask"])
        })

candidate_df = pl.DataFrame(
    candidate_rows,
    schema={
        "query_id": pl.UInt32,
        "candidate_id": pl.UInt32,
        "rrf_score": pl.Float32,
        "bm25_score": pl.Float32,
        "channel_mask": pl.UInt8
    }
)

expected_unique = candidate_df.select(
    ["query_id", "candidate_id"]
).unique().height

if expected_unique != candidate_df.height:
    raise RuntimeError("Candidate primary key violation")

candidate_df.write_parquet(
    OUT / "candidate_results.parquet",
    compression="zstd"
)

gt_key = set(
    zip(
        gt_edges_df["query_id"].to_list(),
        gt_edges_df["candidate_id"].to_list()
    )
)

candidate_key = set(
    zip(
        candidate_df["query_id"].to_list(),
        candidate_df["candidate_id"].to_list()
    )
)

recovered_edges = len(gt_key.intersection(candidate_key))
total_gt_edges = gt_edges_df.height

if total_gt_edges <= 0:
    raise RuntimeError("Invalid positive GT denominator")

match_coverage = recovered_edges / total_gt_edges

positive_recall = 0

for qid in positive_query_ids:
    gt_for_query = {
        cid
        for q, cid in gt_key
        if int(q) == int(qid)
    }

    candidates_for_query = {
        cid
        for q, cid in candidate_key
        if int(q) == int(qid)
    }

    if gt_for_query.intersection(candidates_for_query):
        positive_recall += 1

union_candidate_recall = positive_recall / N_POS

candidate_counts = (
    candidate_df
    .group_by("query_id")
    .len()
    .get_column("len")
    .to_numpy()
)

if len(candidate_counts) == 0:
    raise RuntimeError("No retrieval candidates produced")

negative_scores = []

for qid in negative_query_ids:
    rows = candidate_df.filter(
        pl.col("query_id") == qid
    )

    if rows.height:
        negative_scores.append(
            float(rows["rrf_score"].max())
        )

report = {
    "stage": 0,
    "seed": SEED,
    "corpus_rows": int(len(stage0_corpus)),
    "query_rows": int(len(query_df)),
    "positive_queries": N_POS,
    "negative_queries": N_NEG,
    "gt_edges_positive": int(total_gt_edges),
    "recovered_gt_edges": int(recovered_edges),
    "union_candidate_recall": float(union_candidate_recall),
    "match_coverage_micro": float(match_coverage),
    "candidate_mean": float(np.mean(candidate_counts)),
    "candidate_p50": float(np.percentile(candidate_counts, 50)),
    "candidate_p95": float(np.percentile(candidate_counts, 95)),
    "candidate_max": int(np.max(candidate_counts)),
    "negative_queries_with_candidates": int(len(negative_scores)),
    "negative_max_rrf_mean": float(
        np.mean(negative_scores)
    ) if negative_scores else 0.0,
    "candidate_rows": int(candidate_df.height),
    "candidate_unique_rows": int(expected_unique),
    "artifacts": {
        "query_mapping": str(OUT / "query_id_mapping.parquet"),
        "corpus_mapping": str(OUT / "corpus_id_mapping.parquet"),
        "candidate_results": str(OUT / "candidate_results.parquet")
    }
}

with open(OUT / "benchmark_report.json", "w") as f:
    json.dump(report, f, indent=2)

print(json.dumps(report, indent=2))


from pathlib import Path
import polars as pl

DATA_DIR = Path("dataset/train")

def load_source(path: Path) -> pl.DataFrame:
    """Loads a .tsv source file with strict types and tab separators."""
    return pl.read_csv(
        path,
        separator="\t",
        has_header=True,
        schema={
            "entity_id": pl.Utf8,
            "business_name": pl.Utf8,
            "business_address": pl.Utf8,
            "country": pl.Utf8,
        },
        null_values=["", "NA", "null", "None"]
    )

def load_ground_truth(path: Path) -> pl.DataFrame:
    """Loads the ground truth file and expands matched IDs for pair profiling."""
    return pl.read_csv(
        path,
        separator="\t",
        has_header=True,
        schema={
            "source1_entity_id": pl.Utf8,
            "matched_entity_ids": pl.Utf8,
        }
    )

def audit_dataset():
    print("=" * 60)
    print("LOADING DATASET...")
    print("=" * 60)

    df_s1 = load_source(DATA_DIR / "train_source1.tsv")
    df_s2 = load_source(DATA_DIR / "train_source2.tsv")
    df_s3 = load_source(DATA_DIR / "train_source3.tsv")
    df_gt = load_ground_truth(DATA_DIR / "train_ground_truth.tsv")

    # -------------------------------------------------------------
    # 1. Volume and Null Audits
    # -------------------------------------------------------------
    sources = {"S1": df_s1, "S2": df_s2, "S3": df_s3}
    stats = []

    for name, df in sources.items():
        stats.append({
            "Source": name,
            "Total Records": df.height,
            "Unique IDs": df["entity_id"].n_unique(),
            "Null Names": df["business_name"].null_count(),
            "Null Addresses": df["business_address"].null_count(),
            "Countries Present": df["country"].unique().to_list(),
        })

    print("\n--- SOURCE FILE SUMMARY ---")
    print(pl.DataFrame(stats))

    # -------------------------------------------------------------
    # 2. Country Distributions
    # -------------------------------------------------------------
    print("\n--- COUNTRY DISTRIBUTION PER SOURCE ---")
    for name, df in sources.items():
        dist = (
            df.group_by("country")
            .agg(pl.len().alias("count"))
            .with_columns((pl.col("count") / df.height * 100).round(2).alias("pct"))
        )
        print(f"\n{name}:")
        print(dist)

    # -------------------------------------------------------------
    # 3. Ground Truth & Cardinality Profiling (1-to-N & Singletons)
    # -------------------------------------------------------------
    # Clean matches: explode comma-separated IDs to inspect link topologies
    gt_exploded = (
        df_gt.with_columns(
            pl.col("matched_entity_ids")
            .fill_null("")
            .str.split(",")
        )
        .explode("matched_entity_ids")
        .filter(pl.col("matched_entity_ids") != "")
    )

    # Per-S1 match counts
    match_counts = (
        df_gt.with_columns(
            pl.when(pl.col("matched_entity_ids").is_null() | (pl.col("matched_entity_ids") == ""))
            .then(0)
            .otherwise(pl.col("matched_entity_ids").str.count_matches(",") + 1)
            .alias("num_matches")
        )
    )

    total_s1 = df_s1.height
    gt_s1_count = df_gt.height
    singletons = match_counts.filter(pl.col("num_matches") == 0).height
    positive_queries = total_s1 - singletons

    print("\n--- GROUND TRUTH TOPOLOGY ---")
    print(f"Total S1 Reference Records:      {total_s1}")
    print(f"Total GT Rows:                  {gt_s1_count}")
    print(f"True Singletons (0 matches):     {singletons} ({singletons / total_s1 * 100:.2f}%)")
    print(f"Positive Queries (>=1 match):   {positive_queries} ({positive_queries / total_s1 * 100:.2f}%)")
    print(f"Total Valid Positive Edges:     {gt_exploded.height}")

    print("\nMatch Cardinality Distribution (Matches per S1 entity):")
    card_dist = (
        match_counts.group_by("num_matches")
        .agg(pl.len().alias("query_count"))
        .sort("num_matches")
        .with_columns((pl.col("query_count") / total_s1 * 100).round(2).alias("pct_of_queries"))
    )
    print(card_dist)

    # -------------------------------------------------------------
    # 4. Source Target Breakdown in Ground Truth
    # -------------------------------------------------------------
    gt_targets = gt_exploded.with_columns(
        pl.col("matched_entity_ids").str.slice(0, 2).alias("target_source")
    )
    target_summary = (
        gt_targets.group_by("target_source")
        .agg(pl.len().alias("edge_count"))
        .with_columns((pl.col("edge_count") / gt_exploded.height * 100).round(2).alias("pct_edges"))
    )
    print("\nMatches Distributed by Target Source (S2 vs S3):")
    print(target_summary)

    # -------------------------------------------------------------
    # 5. Format Sanity Invariant Checks
    # -------------------------------------------------------------
    print("\n--- RUNNING INVARIANT CHECKS ---")
    # Invariant 1: S1 count in GT must match S1 source rows exactly
    assert total_s1 == gt_s1_count, f"Mismatch: S1 has {total_s1} rows but GT has {gt_s1_count} rows!"
    print("[PASS] Every S1 entity has exactly one GT row.")

    # Invariant 2: No S1 self-matches in GT
    s1_self_hits = gt_targets.filter(pl.col("target_source") == "S1").height
    assert s1_self_hits == 0, f"Violation: Found {s1_self_hits} S1 self-matches in GT!"
    print("[PASS] Zero S1->S1 self-matches detected.")

    # Invariant 3: Check duplicate IDs within the same list
    dupe_edges = gt_exploded.height - gt_exploded.unique(subset=["source1_entity_id", "matched_entity_ids"]).height
    assert dupe_edges == 0, f"Violation: Found {dupe_edges} duplicate edge entries in GT lists!"
    print("[PASS] Zero duplicate candidate IDs inside Ground Truth lists.")

    print("\nAll database checks passed.")

if __name__ == "__main__":
    audit_dataset()


