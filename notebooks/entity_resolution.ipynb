    cands_b = get_postings(buf_sorted, off_sorted, q["k_so"]) if q.get("k_so") else []
    
    # Retrieve Channel C (Top-2 IDF tokens)
    name_part = q.get("k_ex", "").split("§")[-1]
    q_toks = set(canonical_tokens(name_part))
    valid_tokens = [t for t in q_toks if f"{q['cntry']}§{t}" in word_idf_map]
    ranked_tokens = sorted(valid_tokens, key=lambda t: word_idf_map[f"{q['cntry']}§{t}"], reverse=True)[:2]
    
