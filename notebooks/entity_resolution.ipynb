import gc
import math
import resource
import time
from collections import Counter, defaultdict
import numpy as np
import polars as pl

def ram():
    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0

DATA_DIR = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train")

print("=" * 110)
print("FAST BENCHMARK 2A — CANDIDATE RETRIEVAL CHANNEL C")
print("=" * 110)

s2 = pl.read_csv(
    DATA_DIR / "train_source2.tsv",
    separator="\t",
    columns=["business_name", "country"]
)

s3 = pl.read_csv(
    DATA_DIR / "train_source3.tsv",
    separator="\t",
    columns=["business_name", "country"]
)

cand_df = pl.concat([s2, s3])
del s2, s3
gc.collect()

N = cand_df.height

print(f"Candidates: {N:,}")
print(f"Initial RAM: {ram():.1f} MB")

word_df = Counter()

for row in cand_df.iter_rows():
    country = norm_country(row["country"])
    toks = canonical_tokens(row["business_name"] or "")
    for t in set(toks):
        if len(t) >= 3:
            word_df[f"{country}§{t}"] += 1

print(f"Vocabulary: {len(word_df):,}")

stop_n = max(50, int(len(word_df) * 0.002))
stop_words = {k for k, _ in word_df.most_common(stop_n)}

word_idf = {
    k: math.log((N + 1.0) / (v + 1.0))
    for k, v in word_df.items()
    if k not in stop_words and v <= 5000
}

del word_df, stop_words
gc.collect()

print(f"Active words: {len(word_idf):,}")
print(f"RAM after DF: {ram():.1f} MB")

builder = defaultdict(list)

for i, row in enumerate(cand_df.iter_rows()):
    country = norm_country(row["country"])
    toks = canonical_tokens(row["business_name"] or "")

    for t in set(toks):
        if len(t) < 3:
            continue

        key = f"{country}§{t}"

        if key in word_idf:
            builder[key].append(i)

buf_c, off_c = flatten_store(builder)

del builder, cand_df
gc.collect()

print(f"Channel C ready. RAM: {ram():.1f} MB")

q_b2 = []

addr_map = {
    r["entity_id"]: r["business_address"]
    for r in df_sample_a.select(["entity_id", "business_address"]).to_dicts()
}

for q in queries_sample_a:
    x = dict(q)
    raw_addr = addr_map.get(q["qid"])
    x["a_tokens"] = canonical_tokens(raw_addr) if raw_addr else []
    q_b2.append(x)

del addr_map
gc.collect()

def evaluate_c(depth):
    edge = []
    any_hit = []
    complete = []
    cand_counts = []

    tp = 0
    total_candidates = 0

    for q in q_b2:
        slices = []

        if q["k_ex"]:
            sl = get_postings(buf_exact, off_exact, q["k_ex"])
            if len(sl):
                slices.append(sl)

        if q["k_so"]:
            sl = get_postings(buf_sorted, off_sorted, q["k_so"])
            if len(sl):
                slices.append(sl)

        country = q["cntry"]

        toks = q["k_ex"].split("§")[-1].split() if q["k_ex"] else []

        valid = [
            t for t in toks
            if f"{country}§{t}" in word_idf
        ]

        valid.sort(
            key=lambda t: word_idf[f"{country}§{t}"],
            reverse=True
        )

        for t in valid[:depth]:
            sl = get_postings(
                buf_c,
                off_c,
                f"{country}§{t}"
            )

            if 0 < len(sl) <= 200:
                slices.append(sl)

        if not slices:
            cands = np.empty(0, dtype=np.uint32)
        elif len(slices) == 1:
            cands = slices[0]
        else:
            cands = np.unique(np.concatenate(slices))

        n = len(cands)
        cand_counts.append(n)

        if q["match_count"] == 0:
            continue

        gt = q["gt_set"]
        hits = len(set(cands) & gt)

        r = hits / len(gt)

        edge.append(r)
        any_hit.append(hits > 0)
        complete.append(hits == len(gt))

        tp += hits
        total_candidates += n

    return {
        "depth": depth,
        "edge_recall": np.mean(edge),
        "any_match": np.mean(any_hit),
        "complete": np.mean(complete),
        "precision": tp / total_candidates if total_candidates else 0,
        "mean_candidates": np.mean(cand_counts),
        "p95": np.percentile(cand_counts, 95),
        "p99": np.percentile(cand_counts, 99)
    }

results = []

for depth in [1, 2, 3, 4]:
    t0 = time.time()

    r = evaluate_c(depth)
    r["seconds"] = time.time() - t0

    results.append(r)

    print(
        f"C top{depth} | "
        f"edge={r['edge_recall']:.2%} | "
        f"any={r['any_match']:.2%} | "
        f"complete={r['complete']:.2%} | "
        f"precision={r['precision']:.2%} | "
        f"mean={r['mean_candidates']:.1f} | "
        f"P95={r['p95']:.0f} | "
        f"P99={r['p99']:.0f} | "
        f"time={r['seconds']:.1f}s"
    )

print("\nDONE")


import gc
import math
import re
import resource
import time
from pathlib import Path
from collections import Counter, defaultdict

import numpy as np
import polars as pl

DATA_DIR = Path(
    "/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train"
)

print("=" * 110)
print("STANDALONE BENCHMARK 2A — A + B + CHANNEL C")
print("=" * 110)

def ram():
    return resource.getrusage(
        resource.RUSAGE_SELF
    ).ru_maxrss / 1024.0

def norm_country(x):
    if x is None:
        return ""
    return str(x).strip().upper()

def normalize_text(x):
    if x is None:
        return ""
    x = str(x).lower()
    x = re.sub(r"[^a-z0-9]+", " ", x)
    return " ".join(x.split())

def canonical_tokens(x):
    x = normalize_text(x)
    if not x:
        return []
    return [
        t for t in x.split()
        if len(t) >= 2
    ]

def exact_key(name, country):
    return (
        f"{country}§{normalize_text(name)}"
    )

def sorted_key(name, country):
    toks = canonical_tokens(name)
    return (
        f"{country}§{' '.join(sorted(set(toks)))}"
    )

def flatten_store(builder):
    keys = list(builder.keys())

    offsets = np.zeros(
        len(keys) + 1,
        dtype=np.uint64
    )

    total = 0

    for i, key in enumerate(keys):
        total += len(builder[key])
        offsets[i + 1] = total

    values = np.empty(
        total,
        dtype=np.uint32
    )

    key_to_offset = {}

    pos = 0

    for i, key in enumerate(keys):

        vals = np.asarray(
            builder[key],
            dtype=np.uint32
        )

        n = len(vals)

        values[
            pos:pos+n
        ] = vals

        key_to_offset[key] = i

        pos += n

    return {
        "keys": key_to_offset,
        "offsets": offsets,
        "values": values
    }

def get_postings(store, key):

    idx = store["keys"].get(key)

    if idx is None:
        return np.empty(
            0,
            dtype=np.uint32
        )

    a = int(
        store["offsets"][idx]
    )

    b = int(
        store["offsets"][idx + 1]
    )

    return store["values"][a:b]


print("\nLoading train sources...")

s1 = pl.read_csv(
    DATA_DIR / "train_source1.tsv",
    separator="\t"
)

s2 = pl.read_csv(
    DATA_DIR / "train_source2.tsv",
    separator="\t"
)

s3 = pl.read_csv(
