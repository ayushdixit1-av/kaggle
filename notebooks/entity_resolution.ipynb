print(f"Retained Inverted Lists: {len(usable_postings):,}")
log_telemetry("Channel C postings materialized")

# --- [5/5] Sample-A Pool Scoring & Single-Pass Deterministic Sorting ---
print("\n[5/5] Scoring and pre-sorting candidate pools...")
raw_reachable_edges = 0
total_gt_edges = sum(len(q["gt_set"]) for q in SAMPLE if q["match_count"] > 0)
query_macro_reachable = []

true_pair_scores, hard_negative_scores, singleton_scores = [], [], []
query_payloads = []

for q in SAMPLE:
    cntry = q["cntry"]
    gt_set = q["gt_set"]
    is_singleton = q["match_count"] == 0

    exact_set = set(get_postings(buf_exact, off_exact, q["k_ex"])) if q.get("k_ex") else set()
    sorted_set = set(get_postings(buf_sorted, off_sorted, q["k_so"])) if q.get("k_so") else set()

    q_tokens = set(canonical_tokens(q["k_ex"].split("§")[-1])) if q.get("k_ex") else set()
    q_len = max(1, len(q_tokens))

    valid_tokens = [t for t in q_tokens if f"{cntry}§{t}" in word_idf_map]
    ranked_tokens = sorted(valid_tokens, key=lambda t: word_idf_map[f"{cntry}§{t}"], reverse=True)[:2]

    cand_idfs = defaultdict(list)
    for tok in ranked_tokens:
        key = f"{cntry}§{tok}"
        postings = usable_postings.get(key)
        if postings is None:
            continue
        idf = word_idf_map[key]
        for cid in postings:
            cand_idfs[int(cid)].append(idf)

    c_set = set(cand_idfs.keys())
    unified = exact_set | sorted_set | c_set

    if not is_singleton:
        hits = len(unified & gt_set)
        raw_reachable_edges += hits
        query_macro_reachable.append(hits / len(gt_set))

    scored = []
    for cid in unified:
        is_exact = cid in exact_set
        is_sorted = cid in sorted_set
        idfs = cand_idfs.get(cid)

        if idfs:
            raw_idf_sum = sum(idfs)
            doc_len = int(candidate_lengths[cid])
            s_norm = raw_idf_sum / (0.5 + 0.5 * (doc_len / AVG_DOC_LEN))
            coverage = len(idfs) / q_len
            lexical_score = s_norm * (0.5 + 0.5 * coverage)
        else:
            lexical_score = 0.0

        boost = (8.0 if is_exact else 0.0) + (4.0 if is_sorted else 0.0)
        score = boost + lexical_score
        src = 2 if cid < N_S2 else 3

        scored.append((cid, score, src))

        if is_singleton and len(singleton_scores) < 10_000:
            singleton_scores.append(score)
        elif not is_singleton:
            if cid in gt_set and len(true_pair_scores) < 10_000:
                true_pair_scores.append(score)
            elif cid not in gt_set and len(hard_negative_scores) < 10_000:
                hard_negative_scores.append(score)

    # Deterministic sort once per query: highest score first, tie-break by lowest candidate ID
    scored.sort(key=lambda x: (-x[1], x[0]))

    s2_ids = [x[0] for x in scored if x[2] == 2]
    s3_ids = [x[0] for x in scored if x[2] == 3]
    combined_ids = [x[0] for x in scored]

    query_payloads.append({
        "qid": q["qid"],
        "match_count": q["match_count"],
        "gt_set": gt_set,
        "combined": combined_ids,
        "s2": s2_ids,
        "s3": s3_ids
    })

raw_micro_ceiling = (raw_reachable_edges / total_gt_edges) if total_gt_edges else 0.0
raw_macro_ceiling = float(np.mean(query_macro_reachable)) if query_macro_reachable else 0.0

print(f"\nRAW A+B+C CEILING (Micro Edge Recall): {raw_micro_ceiling:.2%}")
print(f"RAW A+B+C CEILING (Macro Query Recall): {raw_macro_ceiling:.2%}")

# --- Distribution Summary ---
