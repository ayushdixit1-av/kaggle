    c_alpha_set = set(c_alpha_list)
    
    same_country = (q_cntry == c_cntry) and (q_cntry != "UNK")
    clean_q_exact = norm_address_exact(q_addr)
    clean_c_exact = norm_address_exact(c_addr)

    # 1. Exact Address Match
    if clean_q_exact and clean_c_exact and (clean_q_exact == clean_c_exact) and same_country:
        address_recovery_signals["E1: Exact Normalized Address Match"] += 1

    # 2. Postal Compounds
    if q_post is not None and c_post is not None and (q_post == c_post):
        address_recovery_signals["Raw Postal Match (Any Country)"] += 1
        
        if same_country:
            address_recovery_signals["S1: Country § Postal Match"] += 1
            
            # S2: Country § Postal § First Alpha Token
            if q_alpha_list and c_alpha_list and (q_alpha_list[0] == c_alpha_list[0]):
                address_recovery_signals["S2: Country § Postal § 1st Alpha Match"] += 1
                
            # S3: Country § Postal § First Two Alpha Tokens
            if len(q_alpha_list) >= 2 and len(c_alpha_list) >= 2:
                if (q_alpha_list[0] == c_alpha_list[0]) and (q_alpha_list[1] == c_alpha_list[1]):
                    address_recovery_signals["S3: Country § Postal § 1st 2 Alpha Match"] += 1
            
            # Broad Diagnostic Overlap (Upper bound for any token under postal)
            if q_alpha_set & c_alpha_set:
                address_recovery_signals["Diagnostic: Country § Postal + Any Shared Alpha Token"] += 1

    # 3. Address Token Overlap independent of postal
    if q_alpha_set & c_alpha_set:
        address_recovery_signals["Address Alpha Token Overlap (>= 1 token)"] += 1
    if len(q_alpha_set & c_alpha_set) >= 2:
        address_recovery_signals["Address Alpha Token Overlap (>= 2 tokens)"] += 1

