    )
    .rename({"country": "m_country"})
    .with_columns([
        pl.col("q_country")
        .map_elements(norm_country, return_dtype=pl.Utf8)
        .alias("q_country_norm"),

        pl.col("m_country")
        .map_elements(norm_country, return_dtype=pl.Utf8)
        .alias("m_country_norm")
    ])
    .select([
        pl.len().alias("total_edges"),

        (
            (pl.col("q_country_norm") != "") &
            (pl.col("m_country_norm") != "") &
            (pl.col("q_country_norm") == pl.col("m_country_norm"))
        ).sum().alias("same_country"),

        (
            (pl.col("q_country_norm") != "") &
            (pl.col("m_country_norm") != "") &
            (pl.col("q_country_norm") != pl.col("m_country_norm"))
        ).sum().alias("cross_country"),

        (
            (pl.col("q_country_norm") == "") |
            (pl.col("m_country_norm") == "")
        ).sum().alias("null_involved")
    ])
