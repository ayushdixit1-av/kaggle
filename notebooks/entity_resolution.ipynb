    sorted_set = set(
        get_postings(buf_sorted, off_sorted, q["k_so"])
    ) if q.get("k_so") else set()

    name_part = q["k_ex"].split("§")[-1] if q.get("k_ex") else ""
    q_tokens = set(canonical_tokens(name_part))
    q_len = max(1, len(q_tokens))
    cntry = q["cntry"]

    valid_tokens = [
        t for t in q_tokens
        if f"{cntry}§{t}" in word_idf_map
    ]

    ranked_tokens = sorted(
        valid_tokens,
        key=lambda t: word_idf_map[f"{cntry}§{t}"],
        reverse=True
    )[:2]

    cand_matched_idfs = defaultdict(list)

    for tok in ranked_tokens:
        key = f"{cntry}§{tok}"
        p = usable_postings.get(key)

        if p is not None:
            idf = word_idf_map[key]
            for cid in p:
                cand_matched_idfs[int(cid)].append(idf)

    c_set = set(cand_matched_idfs.keys())
    unified = exact_set | sorted_set | c_set

    scored = []

    for cid in unified:
        is_exact = cid in exact_set
        is_sorted = cid in sorted_set
        idfs = cand_matched_idfs.get(cid)

        if idfs:
            raw_idf_sum = sum(idfs)
            doc_len = get_candidate_doc_len(cid)

            s_norm = raw_idf_sum / (
                0.5 + 0.5 * (doc_len / 5.0)
            )

            coverage = len(idfs) / q_len

            lexical_score = s_norm * (
                0.5 + 0.5 * coverage
            )
        else:
            lexical_score = 0.0

        boost = (
            8.0 if is_exact else 0.0
        ) + (
            4.0 if is_sorted else 0.0
        )

        score = boost + lexical_score
        src = 2 if cid < N_S2_REBUILD else 3

        scored.append((cid, score, src))

    scored.sort(
        key=lambda x: (-x[1], x[0])
    )

    query_payloads_b.append({
        "qid": q["qid"],
        "match_count": q["match_count"],
        "gt_set": set(
            int(x) for x in gt_int_map.get(
                q["qid"],
                np.empty(0, dtype=np.uint32)
            )
        ),
        "combined": [x[0] for x in scored],
        "s2": [x[0] for x in scored if x[2] == 2],
        "s3": [x[0] for x in scored if x[2] == 3]
    })

