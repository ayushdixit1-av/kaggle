POSTAL_REGEX = __import__("re").compile(
    r'\b(?:[0-9]{5,6}|[A-Z][0-9][A-Z]\s?[0-9][A-Z][0-9]|[A-Z]{1,2}[0-9R][0-9A-Z]?\s?[0-9][A-Z]{2})\b',
    __import__("re").IGNORECASE
)

ADDR_STOPWORDS = {
    "ROAD",
    "STREET",
    "AVENUE",
    "LANE",
    "DRIVE",
    "BLVD",
    "SUITE",
    "STE",
    "FLOOR",
    "FL",
    "BLOCK",
    "SECTOR",
    "PLOT",
    "NEAR",
    "OPP",
    "CITY",
    "STATE",
    "INDIA",
    "USA",
    "UNITED",
    "STATES",
    "DIST",
    "NAGAR",
    "MARG"
}

def clean_address_string(s):
    if not s:
        return ""
    s = str(s).upper()
    for ch in ",.-/#;:()\"'[]\t\n":
        s = s.replace(ch, " ")
    return " ".join(s.split())

def extract_postal_code(s):
    if not s:
        return None
    m = POSTAL_REGEX.findall(str(s))
    return m[-1].upper().replace(" ", "") if m else None

def get_meaningful_alpha_tokens(s):
    if not s:
        return []
    cleaned = clean_address_string(s)
    return [
        t for t in cleaned.split()
        if len(t) >= 3 and not t.isdigit() and t not in ADDR_STOPWORDS
    ]

def jaro_winkler_safe(s1, s2):
    if s1 == s2:
        return 1.0
    if not s1 or not s2:
        return 0.0

    l1 = len(s1)
    l2 = len(s2)
    max_d = max(0, max(l1, l2) // 2 - 1)

    m1 = [False] * l1
    m2 = [False] * l2
    matches = 0

    for i in range(l1):
        start = max(0, i - max_d)
        end = min(i + max_d + 1, l2)

        for j in range(start, end):
            if not m2[j] and s1[i] == s2[j]:
                m1[i] = True
                m2[j] = True
                matches += 1
                break

    if matches == 0:
        return 0.0

    t = 0
    k = 0

    for i in range(l1):
        if m1[i]:
            while not m2[k]:
                k += 1
            if s1[i] != s2[k]:
                t += 1
            k += 1

    jaro = (
        matches / l1
        + matches / l2
        + (matches - t / 2.0) / matches
    ) / 3.0

    prefix_len = 0

    for i in range(min(4, min(l1, l2))):
        if s1[i] == s2[i]:
            prefix_len += 1
        else:
            break

    return float(
        jaro + prefix_len * 0.1 * (1.0 - jaro)
    )

def levenshtein_ratio(s1, s2):
    if s1 == s2:
        return 1.0
    if not s1 or not s2:
        return 0.0

    if len(s1) < len(s2):
        s1, s2 = s2, s1

    if not s2:
        return 0.0

    previous = list(range(len(s2) + 1))

    for i, c1 in enumerate(s1):
        current = [i + 1] + [0] * len(s2)

        for j, c2 in enumerate(s2):
            current[j + 1] = min(
                previous[j + 1] + 1,
                current[j] + 1,
                previous[j] + (c1 != c2)
            )

        previous = current

    return float(
        1.0 - previous[-1] / max(len(s1), len(s2))
    )

def char_trigram_jaccard(s1, s2):
    if s1 == s2:
        return 1.0
    if len(s1) < 3 or len(s2) < 3:
        return 0.0

    a = {s1[i:i+3] for i in range(len(s1) - 2)}
    b = {s2[i:i+3] for i in range(len(s2) - 2)}

    u = len(a | b)

    return float(len(a & b) / u) if u else 0.0

