print("\n[5/7] Building Sample-B feature matrix...")

payload_by_qid_b = {
    str(p["qid"]): p
    for p in query_payloads_b
}

rows = []
query_offsets_b = []

feature_build_start = time.time()

for q_idx, q in enumerate(
    SAMPLE_B
):

    qid = q["qid"]
    qid_str = str(qid)

    item = payload_by_qid_b.get(
        qid_str
    )

    if item is None:
        raise RuntimeError(
            f"Missing payload for {qid}"
        )

    gt_set = set(
        item["gt_set"]
    )

    raw_q_name = (
        q.get("k_ex", "")
        .split("§")[-1]
    )

    q_tok_list = canonical_tokens(
        raw_q_name
    )

    q_name = " ".join(
        q_tok_list
    )

    q_toks = set(
        q_tok_list
    )

    q_cntry = norm_country(
        q.get("cntry", "UNK")
    )

    q_len = max(
        1,
        len(q_name)
    )

    q_tok_count = max(
        1,
        len(q_tok_list)
    )

    raw_q_addr = str(
        s1_addrs_map_b.get(
            qid_str,
            ""
        )
        or ""
    ).strip()

    clean_q_addr = (
        clean_address_string(
            raw_q_addr
        )
    )

    q_postal = (
        extract_postal_code(
            raw_q_addr
        )
    )

    q_addr_toks = set(
        get_meaningful_alpha_tokens(
            raw_q_addr
        )
    )

    exact_list = (
        get_postings(
            buf_exact,
            off_exact,
            q["k_ex"]
        )
        if q.get("k_ex")
        else []
    )

    sorted_list = (
        get_postings(
            buf_sorted,
            off_sorted,
            q["k_so"]
        )
        if q.get("k_so")
        else []
    )

    exact_rank_map = {
        int(cid): rank
        for rank, cid
        in enumerate(
            exact_list,
            start=1
        )
    }

    sorted_rank_map = {
        int(cid): rank
        for rank, cid
        in enumerate(
            sorted_list,
            start=1
        )
    }

    valid_tokens = [
        t
        for t in q_toks
        if f"{q_cntry}§{t}"
        in word_idf_map
    ]

    ranked_tokens = sorted(
        valid_tokens,
        key=lambda t:
        word_idf_map[
            f"{q_cntry}§{t}"
        ],
        reverse=True
    )[:2]

    cand_c_evidence = defaultdict(
        list
    )

    for tok in ranked_tokens:

        key = (
            f"{q_cntry}§{tok}"
        )

        postings = (
            usable_postings.get(
                key
            )
        )

        if postings is None:
            continue

        idf = float(
            word_idf_map[key]
        )

        for cid in postings:
            cand_c_evidence[
                int(cid)
            ].append(idf)

    key_a = q_keys_e1a_b.get(
        qid_str
    )

    key_c = q_keys_e1c_b.get(
        qid_str
    )

    e1a_cids = set(
        int(x)
        for x in (
            usable_post_e1a_b.get(
                key_a,
                []
            )
            if key_a
            else []
        )
    )

    e1c_cids = set(
        int(x)
        for x in (
            usable_post_e1c_b.get(
                key_c,
                []
            )
            if key_c
            else []
        )
    )

    base_abc = [
        int(x)
        for x in item["combined"]
    ]

    abc_rank_map = {
        cid: rank
        for rank, cid
        in enumerate(
            base_abc,
            start=1
        )
    }

    all_candidate_cids = (
        set(base_abc)
        | e1a_cids
        | e1c_cids
    )

    def candidate_priority(cid):

        in_a = (
            cid in exact_rank_map
        )

        in_b = (
            cid in sorted_rank_map
        )

        in_e1a = (
            cid in e1a_cids
        )

        in_e1c = (
            cid in e1c_cids
        )

        if (
            (in_e1a or in_e1c)
            and
            (in_a or in_b)
        ):
            tier = 0
            sub_rank = min(
                exact_rank_map.get(
                    cid,
                    999
                ),
                sorted_rank_map.get(
                    cid,
                    999
                )
            )

        elif in_a:
            tier = 1
            sub_rank = (
                exact_rank_map[cid]
            )

        elif in_e1a:
            tier = 1
            sub_rank = 1

        elif in_b:
            tier = 2
            sub_rank = (
                sorted_rank_map[cid]
            )

        elif in_e1c:
            tier = 2
            sub_rank = 1

        else:
            tier = 3
            sub_rank = (
                abc_rank_map.get(
                    cid,
                    9999
                )
            )

        return (
            tier,
            sub_rank,
            abc_rank_map.get(
                cid,
                9999
            ),
            cid
        )

    sorted_cands = sorted(
        all_candidate_cids,
        key=candidate_priority
    )[:MAX_K]

    start_pos = len(rows)

    for rank, cid in enumerate(
        sorted_cands,
        start=1
    ):

        (
            c_raw_name,
            c_raw_addr,
            c_cntry,
            src
        ) = get_cand_full(cid)

        c_raw_name = str(
            c_raw_name or ""
        )

        c_raw_addr = str(
            c_raw_addr or ""
        )

        c_tok_list = canonical_tokens(
            c_raw_name
        )

        c_name = " ".join(
            c_tok_list
        )

        c_toks = set(
            c_tok_list
        )

        c_len = max(
            1,
            len(c_name)
        )

        c_tok_count = len(
            c_tok_list
        )

        in_a = cid in exact_rank_map
        in_b = cid in sorted_rank_map

        c_idfs = (
            cand_c_evidence.get(cid)
        )

        in_c = (
            c_idfs is not None
        )

        in_e1a = cid in e1a_cids
        in_e1c = cid in e1c_cids

        r_a = float(
            exact_rank_map.get(
                cid,
                0
            )
        )

        r_b = float(
            sorted_rank_map.get(
                cid,
                0
            )
        )

        c_overlap_cnt = (
            float(len(c_idfs))
            if in_c
            else 0.0
        )

        c_idf_sum = (
            float(sum(c_idfs))
            if in_c
            else 0.0
        )

        c_max_idf = (
            float(max(c_idfs))
            if in_c
            else 0.0
        )

        c_coverage = (
            c_overlap_cnt
            / q_tok_count
            if in_c
            else 0.0
        )

        shared_toks = (
            q_toks & c_toks
        )

        n_shared = len(
            shared_toks
        )

        union_toks = (
            q_toks | c_toks
        )

        token_jaccard = (
            n_shared
            / len(union_toks)
            if union_toks
            else 0.0
        )

        token_containment = (
            1.0
            if (
                q_toks
                and (
                    q_toks.issubset(
                        c_toks
                    )
                    or
                    c_toks.issubset(
                        q_toks
                    )
                )
            )
            else 0.0
        )

        token_set_equal = (
            1.0
            if (
                q_toks == c_toks
                and q_toks
            )
            else 0.0
        )

        jw = jaro_winkler_safe(
            q_name,
            c_name
        )

        lev = levenshtein_ratio(
            q_name,
            c_name
        )

        tri = char_trigram_jaccard(
            q_name,
            c_name
        )

        exact_name = (
            1.0
            if q_name == c_name
            else 0.0
        )

        first_tok_match = (
            1.0
            if (
                q_tok_list
                and c_tok_list
                and
                q_tok_list[0]
                ==
                c_tok_list[0]
            )
            else 0.0
        )

        last_tok_match = (
            1.0
            if (
                q_tok_list
                and c_tok_list
                and
                q_tok_list[-1]
                ==
                c_tok_list[-1]
            )
            else 0.0
        )

        clean_c_addr = (
            clean_address_string(
                c_raw_addr
            )
        )

        c_postal = (
            extract_postal_code(
                c_raw_addr
            )
        )

        c_addr_toks = set(
            get_meaningful_alpha_tokens(
                c_raw_addr
            )
        )

        address_exact_match = (
            1.0
            if (
                clean_q_addr
                and clean_c_addr
                and
                clean_q_addr
                ==
                clean_c_addr
            )
            else 0.0
        )

        postal_match = (
            1.0
            if (
                q_postal
                and c_postal
                and
                q_postal
                ==
                c_postal
            )
            else 0.0
        )

        shared_addr = (
            q_addr_toks
            &
            c_addr_toks
        )

        union_addr = (
            q_addr_toks
            |
            c_addr_toks
        )

        addr_token_jaccard = (
            len(shared_addr)
            /
            len(union_addr)
            if union_addr
            else 0.0
        )

        country_match = (
            1.0
            if (
                q_cntry
                ==
                norm_country(
                    c_cntry
                )
                and
                q_cntry != "UNK"
            )
            else 0.0
        )

        e_name_match = (
            1.0
            if (
                (in_e1a or in_e1c)
                and
                (
                    exact_name == 1.0
                    or
                    jw >= 0.85
                )
            )
            else 0.0
        )

        feature_values = [
            float(rank),
            1.0 if in_a else 0.0,
            1.0 if in_b else 0.0,
            1.0 if in_c else 0.0,
            1.0 if in_e1a else 0.0,
            1.0 if in_e1c else 0.0,
            r_a,
            r_b,
            1.0 if (
                in_a and in_b
            ) else 0.0,
            1.0 if (
                in_a and in_c
            ) else 0.0,
            1.0 if (
                in_b and in_c
            ) else 0.0,
            e_name_match,
            c_overlap_cnt,
            c_idf_sum,
            c_max_idf,
            c_coverage,
            jw,
            lev,
            tri,
            exact_name,
            token_jaccard,
            token_containment,
            token_set_equal,
            float(n_shared),
            first_tok_match,
            last_tok_match,
            float(q_tok_count),
            float(c_tok_count),
            float(
                abs(
                    q_tok_count
                    -
                    c_tok_count
                )
            ),
            float(
                abs(
                    q_len
                    -
                    c_len
                )
                /
                max(
                    q_len,
                    c_len
                )
            ),
            address_exact_match,
            postal_match,
            addr_token_jaccard,
            float(
                len(shared_addr)
            ),
            country_match,
            1.0 if src == 2 else 0.0
        ]

        if len(feature_values) != 36:
            raise RuntimeError(
                f"Feature count != 36: "
                f"{len(feature_values)}"
            )

        rows.append(
            [
                q_idx,
                cid,
                1 if cid in gt_set else 0,
                *feature_values
            ]
        )

    end_pos = len(rows)

    query_offsets_b.append(
        (
            q_idx,
            qid,
            len(gt_set),
            gt_set,
            start_pos,
            end_pos
        )
    )

    if (
        (q_idx + 1) % 2000 == 0
    ):
        print(
            f"Processed "
            f"{q_idx + 1:,}/"
            f"{N_QUERIES_B:,} | "
            f"Rows: {len(rows):,}"
        )

df_features_b = pl.DataFrame(
    rows,
    schema=[
        "q_idx",
        "cid",
        "label",
        *MODEL_FEATURE_NAMES
    ],
    orient="row"
)

del rows
