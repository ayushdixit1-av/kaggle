# Reusable pure-python Jaro-Winkler
def jaro_winkler_similarity(s1, s2):
    if s1 == s2:
        return 1.0
    if not s1 or not s2:
        return 0.0
    len1, len2 = len(s1), len(s2)
    max_dist = max(len1, len2) // 2 - 1
    match1, match2 = [False] * len1, [False] * len2
    matches = 0
    for i in range(len1):
        start = max(0, i - max_dist)
        end = min(i + max_dist + 1, len2)
        for j in range(start, end):
            if not match2[j] and s1[i] == s2[j]:
                match1[i] = True
                match2[j] = True
                matches += 1
                break
    if matches == 0:
        return 0.0
    t, k = 0, 0
    for i in range(len1):
        if match1[i]:
            while not match2[k]:
                k += 1
            if s1[i] != s2[k]:
                t += 1
            k += 1
    jaro = (matches / len1 + matches / len2 + (matches - (t / 2.0)) / matches) / 3.0
    prefix_len = 0
    for i in range(min(4, min(len1, len2))):
        if s1[i] == s2[i]:
            prefix_len += 1
        else:
            break
    return jaro + prefix_len * 0.1 * (1.0 - jaro)

POSTAL_REGEX = re.compile(
    r'\b(?:[0-9]{5,6}|[A-Z][0-9][A-Z]\s?[0-9][A-Z][0-9]|[A-Z]{1,2}[0-9R][0-9A-Z]?\s?[0-9][A-Z]{2})\b', 
    re.IGNORECASE
)

def extract_postal(addr):
    if not addr:
        return None
    m = POSTAL_REGEX.findall(addr)
    return m[-1].upper().replace(" ", "") if m else None

def get_clean_addr_tokens(s):
    if not s:
        return set()
    s = s.upper()
    for ch in ",.-/#;:()\"'[]":
        s = s.replace(ch, " ")
    return {t for t in s.split() if len(t) >= 3 and not t.isdigit()}

