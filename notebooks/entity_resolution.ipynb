import gc
import math
import os
import re
import resource
import time
import unicodedata
from collections import Counter, defaultdict
from pathlib import Path
import numpy as np
import polars as pl

# -------------------------------------------------------------------------
# Telemetry & Timing Helpers
# -------------------------------------------------------------------------
def get_peak_ram_mb() -> float:
    # ru_maxrss reports high-water mark in kilobytes on Linux
    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0

def log_telemetry(step_name: str):
    gc.collect()
    print(f"  [RAM Telemetry] {step_name:<45} | Peak RSS: {get_peak_ram_mb():.2f} MB")

START_TIME = time.time()
print("=" * 115)
print(f"BENCHMARK 2: RESIDUAL BRIDGE (PROGRESSIVE RETRIEVAL LADDER) | Peak RSS: {get_peak_ram_mb():.2f} MB")
print("=" * 115)

DATA_DIR = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train")

# -------------------------------------------------------------------------
# Step 1: Ingest Candidate Records
# -------------------------------------------------------------------------
print("\n[B2 Stage 1/5] Ingesting Candidates & Materializing Corpus Features...")
df_s2_text = pl.read_csv(DATA_DIR / "train_source2.tsv", separator="\t", columns=["business_name", "business_address", "country"])
df_s3_text = pl.read_csv(DATA_DIR / "train_source3.tsv", separator="\t", columns=["business_name", "business_address", "country"])
df_cands_text = pl.concat([df_s2_text, df_s3_text])
del df_s2_text, df_s3_text
gc.collect()

c_names = df_cands_text["business_name"].fill_null("").to_list()
c_addrs = df_cands_text["business_address"].fill_null("").to_list()
c_countries = df_cands_text["country"].to_list()
del df_cands_text
gc.collect()

N_CANDS = len(c_names)

# -------------------------------------------------------------------------
# Step 2: Corpus-Wide Document Frequency & Calibrated IDF
# -------------------------------------------------------------------------
print("\n[B2 Stage 2/5] Building Exact Corpus Document Frequency (DF) & IDF Tables...")

word_df = Counter()
ngram_df = Counter()
addr_token_df = Counter()

print("  Extracting token and subword frequencies across 10.3M records...")
for i in range(N_CANDS):
    cntry = norm_country(c_countries[i])
    n_toks = canonical_tokens(c_names[i])
    
    # 1. Word DF (tokens >= 3 chars)
    for t in set(n_toks):
        if len(t) >= 3:
            word_df[f"{cntry}§{t}"] += 1
            
    # 2. 3-Gram DF
    joined = "".join(n_toks)
    if len(joined) >= 3:
        grams = {joined[j:j+3] for j in range(len(joined) - 2)}
        for g in grams:
            ngram_df[f"{cntry}§{g}"] += 1
            
    # 3. Address Token DF (tokens >= 4 chars, non-numeric)
    if c_addrs[i]:
        a_toks = canonical_tokens(c_addrs[i])
        for at in set(a_toks):
            if len(at) >= 4 and not at.isdigit():
                addr_token_df[f"{cntry}§{at}"] += 1

# Calibrated Stop-Word & Stop-Gram Ceilings
N_WORDS = len(word_df)
N_GRAMS = len(ngram_df)
STOP_WORDS = {k for k, _ in word_df.most_common(max(50, int(N_WORDS * 0.002)))}
STOP_GRAMS = {k for k, _ in ngram_df.most_common(max(100, int(N_GRAMS * 0.005)))}

def calc_idf(df_val: int) -> float:
    return math.log((N_CANDS + 1.0) / (df_val + 1.0))

word_idf_map = {k: calc_idf(v) for k, v in word_df.items() if k not in STOP_WORDS and v <= 5000}
ngram_idf_map = {k: calc_idf(v) for k, v in ngram_df.items() if k not in STOP_GRAMS and v <= 10000}

# Distinctive Address Tokens: Frequency between 5 and 2,500 in full corpus
DISTINCTIVE_ADDR_TOKENS = {k for k, v in addr_token_df.items() if 5 <= v <= 2500}

print(f"  Vocabulary: {len(word_idf_map):,} active words | {len(ngram_idf_map):,} active 3-grams | {len(DISTINCTIVE_ADDR_TOKENS):,} distinctive address tokens.")
del word_df, ngram_df, addr_token_df
log_telemetry("After Corpus DF/IDF Computation")

# -------------------------------------------------------------------------
# Step 3: Sequential Index Construction (Channels C, D, E)
# -------------------------------------------------------------------------
print("\n[B2 Stage 3/5] Building Channel C (Word Index)...")
builder_word = defaultdict(list)
for i in range(N_CANDS):
    cntry = norm_country(c_countries[i])
    n_toks = canonical_tokens(c_names[i])
    for t in set(n_toks):
        if len(t) >= 3:
            k_w = f"{cntry}§{t}"
            if k_w in word_idf_map:
                builder_word[k_w].append(i)

buf_word, off_word = flatten_store(builder_word)
del builder_word
log_telemetry("Channel C (Word Index) Flattened")

print("  Building Channel D (Character 3-Gram Index)...")
builder_ngram = defaultdict(list)
for i in range(N_CANDS):
    cntry = norm_country(c_countries[i])
    n_toks = canonical_tokens(c_names[i])
    joined = "".join(n_toks)
    if len(joined) >= 3:
        grams = {joined[j:j+3] for j in range(len(joined) - 2)}
        for g in grams:
            k_g = f"{cntry}§{g}"
            if k_g in ngram_idf_map:
                builder_ngram[k_g].append(i)

buf_ngram, off_ngram = flatten_store(builder_ngram)
del builder_ngram
log_telemetry("Channel D (Char 3-Gram Index) Flattened")

print("  Building Channel E (Distinctive Address Token Index)...")
builder_addr = defaultdict(list)
for i in range(N_CANDS):
    if c_addrs[i]:
        cntry = norm_country(c_countries[i])
        a_toks = canonical_tokens(c_addrs[i])
        for at in set(a_toks):
            k_at = f"{cntry}§{at}"
            if k_at in DISTINCTIVE_ADDR_TOKENS:
                builder_addr[k_at].append(i)

buf_addr, off_addr = flatten_store(builder_addr)
del builder_addr
del c_names, c_addrs, c_countries
log_telemetry("All Expanded Indexes Materialized")

# -------------------------------------------------------------------------
# Step 4: Re-package Sample A Queries with Address Tokens
# -------------------------------------------------------------------------
print("\n[B2 Stage 4/5] Preprocessing Sample A Queries with Explicit Address Tokens...")

q_prepped_b2 = []
# Ensure raw addresses from df_sample_a are cleanly bound to each query item
sample_a_raw_addrs = df_sample_a.select(["entity_id", "business_address"]).to_dicts()
sample_a_addr_lookup = {r["entity_id"]: r["business_address"] for r in sample_a_raw_addrs}

for q in queries_sample_a:
    raw_addr = sample_a_addr_lookup.get(q["qid"])
    a_tokens = canonical_tokens(raw_addr) if raw_addr else []
    
    q_copy = dict(q)
    q_copy["a_tokens"] = a_tokens  # Explicit, canonicalized address tokens
    q_prepped_b2.append(q_copy)

del sample_a_raw_addrs, sample_a_addr_lookup
gc.collect()

# -------------------------------------------------------------------------
# Step 5: Core Evaluation Kernel with Parameter Sweeps
# -------------------------------------------------------------------------
print("\n[B2 Stage 5/5] Executing Progressive Strategy Ladder on Sample A (N=20,000)...")

def evaluate_progressive_pipeline(queries: list[dict], strat_tag: str, c_depth: int = 2, e_cap: int = 150):
    edge_recalls = []
    any_hits = []
    comp_hits = []
    cand_counts = []
    overall_f05_bounds = []
    singleton_flags = []
    
    total_tp = 0
    total_positive_cands = 0

    for q in queries:
        slices = []
        cntry = q["cntry"]
        
        # Channel A: Exact Name
        if "A" in strat_tag and q["k_ex"]:
            sl = get_postings(buf_exact, off_exact, q["k_ex"])
            if len(sl) > 0: slices.append(sl)
            
        # Channel B: Token-Sorted Name
        if "B" in strat_tag and q["k_so"]:
            sl = get_postings(buf_sorted, off_sorted, q["k_so"])
            if len(sl) > 0: slices.append(sl)
            
        # Channel C: IDF-Ranked Word Index (Top 1, 2, 3, or 4 rarest words)
        if "C" in strat_tag:
            n_toks = q["k_ex"].split("§")[-1].split() if q["k_ex"] else []
            valid_words = [t for t in n_toks if f"{cntry}§{t}" in word_idf_map]
            if valid_words:
                ranked_words = sorted(valid_words, key=lambda w: word_idf_map[f"{cntry}§{w}"], reverse=True)
                for w in ranked_words[:c_depth]:
                    sl = get_postings(buf_word, off_word, f"{cntry}§{w}")
                    if 0 < len(sl) <= 200:
                        slices.append(sl)
                        
        # Channel D: IDF-Weighted 3-Gram Overlap (Intermediate Computation Guardrail)
        if "D" in strat_tag:
            raw_n = q["k_ex"].split("§")[-1].replace(" ", "") if q["k_ex"] else ""
            if len(raw_n) >= 3:
                q_grams = [raw_n[j:j+3] for j in range(len(raw_n) - 2)]
                
                # Sort query n-grams descending by IDF
                valid_grams = [g for g in q_grams if f"{cntry}§{g}" in ngram_idf_map]
                valid_grams.sort(key=lambda g: ngram_idf_map[f"{cntry}§{g}"], reverse=True)
                
                candidate_mass = defaultdict(float)
                # Cap grams evaluated to top 15 most discriminative to prevent intermediate explosion
                for g in valid_grams[:15]:
                    k_g = f"{cntry}§{g}"
                    idf = ngram_idf_map[k_g]
                    sl = get_postings(buf_ngram, off_ngram, k_g)
                    # Skip common n-gram buckets that exceed 2,000 postings
                    if 0 < len(sl) <= 2000:
                        for cid in sl:
                            candidate_mass[cid] += idf
                            
                if candidate_mass:
                    top_30 = sorted(candidate_mass, key=candidate_mass.get, reverse=True)[:30]
                    slices.append(np.array(top_30, dtype=np.uint32))
                    
        # Channel Postal: Postal Code
        if "Postal" in strat_tag and q["k_p"]:
            sl = get_postings(buf_postal, off_postal, q["k_p"])
            if len(sl) > 0: slices.append(sl)
            
        # Channel E: Distinctive Address Token Inverted Index
        if "E" in strat_tag and q["has_addr"]:
            for at in q["a_tokens"]:
                k_at = f"{cntry}§{at}"
                if k_at in DISTINCTIVE_ADDR_TOKENS:
                    sl = get_postings(buf_addr, off_addr, k_at)
                    if 0 < len(sl) <= e_cap:
                        slices.append(sl)

        # Merge slices (Fast zero-copy path for single slices)
        if len(slices) == 0:
            cands = np.empty(0, dtype=np.uint32)
        elif len(slices) == 1:
            cands = slices[0]
        else:
            cands = np.unique(np.concatenate(slices))

        nc = len(cands)
        cand_counts.append(nc)
        
        is_singleton = (q["match_count"] == 0)
        if is_singleton:
            singleton_flags.append(1 if nc > 0 else 0)
            overall_f05_bounds.append(1.0)
        else:
            total_positive_cands += nc
            gt_set = q["gt_set"]
            n_gt = len(gt_set)
            hits = len(set(cands) & gt_set)
            total_tp += hits
            
            rec = hits / n_gt
            edge_recalls.append(rec)
            any_hits.append(1.0 if hits > 0 else 0.0)
            comp_hits.append(1.0 if hits == n_gt else 0.0)
            
            f05 = (1.25 * rec) / (0.25 + rec) if rec > 0 else 0.0
            overall_f05_bounds.append(f05)

    return {
        "Strategy": strat_tag,
        "Mean Edge Recall": f"{float(np.mean(edge_recalls)):.2%}",
        "Any-Match Recall": f"{float(np.mean(any_hits)):.2%}",
        "Complete Recall": f"{float(np.mean(comp_hits)):.2%}",
        "Overall F0.5 Bound": f"{float(np.mean(overall_f05_bounds)):.4f}",
        "Positive Micro Precision": f"{float(total_tp / total_positive_cands):.2%}" if total_positive_cands > 0 else "0.00%",
        "Singleton Contam.": f"{float(np.mean(singleton_flags)):.2%}",
        "Mean Cands": f"{float(np.mean(cand_counts)):.1f}",
        "P50": int(np.percentile(cand_counts, 50)),
        "P95": int(np.percentile(cand_counts, 95)),
        "P99": int(np.percentile(cand_counts, 99)),
        "Max": int(np.max(cand_counts))
    }

# -------------------------------------------------------------------------
# Step 6: Progressive Strategy Ladder Execution (Complete Sweeps)
# -------------------------------------------------------------------------
PROGRESSIVE_LADDER = [
    ("A: Exact Name Baseline", "A", 0, 150),
    ("A + B: Token-Sorted", "A+B", 0, 150),
    ("A + B + C(top1): + Top-1 Word", "A+B+C", 1, 150),
    ("A + B + C(top2): + Top-2 Words", "A+B+C", 2, 150),
    ("A + B + C(top3): + Top-3 Words", "A+B+C", 3, 150),
    ("A + B + C(top4): + Top-4 Words", "A+B+C", 4, 150),
    ("A + B + D: + 3-Gram IDF Top30", "A+B+D", 0, 150),
    ("A + B + C(top3) + D: Name Fusion", "A+B+C+D", 3, 150),
    ("A + B + C(top3) + D + Postal", "A+B+C+D+Postal", 3, 150),
    ("Union + E(cap=50): Conservative Address", "A+B+C+D+Postal+E", 3, 50),
    ("Union + E(cap=150): Moderate Address", "A+B+C+D+Postal+E", 3, 150),
    ("Union + E(cap=300): Aggressive Address", "A+B+C+D+Postal+E", 3, 300),
]

ladder_results = []
for label, tag, depth, e_cap in PROGRESSIVE_LADDER:
    t0 = time.time()
    res = evaluate_progressive_pipeline(q_prepped_b2, tag, c_depth=depth, e_cap=e_cap)
    res["Strategy Label"] = label
    res["Latency (s)"] = round(time.time() - t0, 1)
    ladder_results.append(res)

pl.Config.set_tbl_rows(30)
pl.Config.set_tbl_cols(15)
pl.Config.set_tbl_width_chars(175)

print("\n" + "=" * 145)
print("BENCHMARK 2: PROGRESSIVE RESIDUAL EXPANSION LADDER RESULTS")
print("=" * 145)
