CHUNK = 100_000
MIN_TOKEN_LEN = 3
TRIGRAM_N = 3

RE_NON_ALPHANUM = re.compile(r"[^A-Z0-9]+")
RE_SPACE = re.compile(r"\s+")


def normalize_text(x):
    if x is None:
        return ""
    nfkd = unicodedata.normalize("NFKD", str(x))
    ascii_norm = "".join(
        c for c in nfkd
        if not unicodedata.combining(c)
    ).upper()
    return RE_SPACE.sub(
        " ",
        RE_NON_ALPHANUM.sub(" ", ascii_norm)
    ).strip()


def tokens(x):
    s = normalize_text(x)
    if not s:
        return []
    return [t for t in s.split() if t]


def char_ngrams(x, n=TRIGRAM_N):
    s = normalize_text(x).replace(" ", "")
    if len(s) < n:
        return []
    return [
        s[i:i+n]
        for i in range(len(s) - n + 1)
    ]


def update_percentile_values(values, counter):
    for v in values:
        counter[v] += 1


def profile_file(path):
    print()
    print("=" * 100)
    print(f"PROFILING: {path.name}")
    print("=" * 100)

    schema = pl.read_csv(
        path,
        separator="\t",
        has_header=True,
        n_rows=1
    ).columns

    required = [
        "entity_id",
        "business_name",
        "business_address",
        "country"
    ]

    missing = [
        c for c in required
        if c not in schema
    ]

    if missing:
        raise RuntimeError(
            f"Missing columns in {path.name}: {missing}"
        )

    total = 0

    name_null = 0
    address_null = 0
    country_null = 0

    name_empty = 0
    address_empty = 0
    country_empty = 0

    address_exact = Counter()
    address_token_df = Counter()
    trigram_df = Counter()

    address_token_count_dist = Counter()
    name_token_count_dist = Counter()

    has_digit_component = 0
    numeric_postal_like = 0

    country_counts = Counter()

    reader = pl.read_csv_batched(
        path,
        separator="\t",
        has_header=True,
        batch_size=CHUNK,
        columns=[
            "entity_id",
            "business_name",
            "business_address",
            "country"
        ],
        null_values=["", "NULL", "null"]
    )

    batch_number = 0

    while True:
        batches = reader.next_batches(1)

        if not batches:
            break

        df = batches[0]

        batch_number += 1
        total += df.height

        names = df["business_name"].to_list()
        addresses = df["business_address"].to_list()
        countries = df["country"].to_list()

        for name, address, country in zip(
            names,
            addresses,
            countries
        ):
            if name is None:
                name_null += 1
            else:
                if not str(name).strip():
                    name_empty += 1

            if address is None:
                address_null += 1
            else:
                if not str(address).strip():
                    address_empty += 1

            if country is None:
                country_null += 1
            else:
                if not str(country).strip():
                    country_empty += 1

                country_counts[
                    str(country).strip().upper()
                ] += 1

            name_tokens = tokens(name)
            address_tokens = tokens(address)

            name_token_count_dist[
                len(name_tokens)
            ] += 1

            address_token_count_dist[
                len(address_tokens)
            ] += 1

            if address_tokens:
                addr_norm = " ".join(address_tokens)

                address_exact[addr_norm] += 1

                for tok in set(address_tokens):
                    if len(tok) >= MIN_TOKEN_LEN:
                        address_token_df[tok] += 1

                for tri in set(
                    char_ngrams(
                        address,
                        TRIGRAM_N
                    )
                ):
                    trigram_df[tri] += 1

                digit_tokens = [
                    t
                    for t in address_tokens
                    if any(c.isdigit() for c in t)
                ]

                if digit_tokens:
                    has_digit_component += 1

                postal_candidates = [
                    t
                    for t in address_tokens
                    if re.fullmatch(
                        r"[0-9]{4,6}",
                        t
                    )
                ]

                if postal_candidates:
                    numeric_postal_like += 1

        if batch_number % 10 == 0:
            print(
                f"Processed {total:,} records..."
            )

        del df
        del names
        del addresses
        del countries
        gc.collect()

    print()
    print(f"Total records: {total:,}")

    return {
        "total": total,
        "name_null": name_null,
        "address_null": address_null,
        "country_null": country_null,
        "name_empty": name_empty,
        "address_empty": address_empty,
        "country_empty": country_empty,
        "address_exact": address_exact,
        "address_token_df": address_token_df,
        "trigram_df": trigram_df,
        "name_token_count_dist": name_token_count_dist,
        "address_token_count_dist": address_token_count_dist,
        "has_digit_component": has_digit_component,
        "numeric_postal_like": numeric_postal_like,
        "country_counts": country_counts,
    }


