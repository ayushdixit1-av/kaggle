from pathlib import Path
import json
import pickle
import time
import numpy as np
import polars as pl
import pandas as pd

REPO = Path("/kaggle/working/entity_resolution_repo")
CKPT = REPO / "checkpoints"
CKPT.mkdir(parents=True, exist_ok=True)

def save_state_to(path, obj):
    path = Path(path)

    if isinstance(obj, pl.DataFrame):
        path = path.with_suffix(".parquet")
        obj.write_parquet(path, compression="zstd")
        test = pl.read_parquet(path)
        assert test.height == obj.height
        assert test.columns == obj.columns
        del test
        return path

    if isinstance(obj, pd.DataFrame):
        path = path.with_suffix(".parquet")
        obj.to_parquet(path, index=False)
        test = pd.read_parquet(path)
        assert len(test) == len(obj)
        del test
        return path

    if isinstance(obj, np.ndarray):
        path = path.with_suffix(".npy")
        np.save(path, obj, allow_pickle=False)
        test = np.load(path, mmap_mode="r")
        assert test.shape == obj.shape
        del test
        return path

    path = path.with_suffix(".pkl")
    with open(path, "wb") as f:
        pickle.dump(obj, f, protocol=pickle.HIGHEST_PROTOCOL)

    with open(path, "rb") as f:
        pickle.load(f)

    return path

def checkpoint(names, stage):
    stage_dir = CKPT / stage
    stage_dir.mkdir(parents=True, exist_ok=True)

    manifest = {
        "stage": stage,
        "status": "verified",
        "timestamp_utc": time.strftime(
            "%Y-%m-%dT%H:%M:%SZ",
            time.gmtime()
        ),
        "files": {}
    }

    for name in names:
        if name not in globals():
            raise KeyError(f"{name} not found in globals()")

        obj = globals()[name]
        path = save_state_to(stage_dir / name, obj)

        manifest["files"][name] = {
            "path": str(path.relative_to(REPO)),
            "type": type(obj).__name__,
            "size_bytes": path.stat().st_size
        }

    manifest_path = stage_dir / "manifest.json"
    manifest_path.write_text(
        json.dumps(manifest, indent=2)
    )

    test_manifest = json.loads(manifest_path.read_text())
    assert test_manifest["status"] == "verified"

    return manifest


