import gc
import json
import math
import pickle
import resource
import time
from collections import defaultdict
from pathlib import Path

import numpy as np
import polars as pl

REPO = Path("/kaggle/working/entity_resolution_repo")
A_DIR = REPO / "checkpoints" / "stage3_exact"
B_DIR = REPO / "checkpoints" / "stage3_sorted"
C_DIR = REPO / "checkpoints" / "stage4_channel_c"

START = time.time()

N_S2 = 5_034_616
N_S3 = 5_285_603
N_CANDS = N_S2 + N_S3
MAX_POSTINGS = 1500

with open(C_DIR / "queries_sample_a.pkl", "rb") as f:
    SAMPLE = pickle.load(f)

with open(C_DIR / "word_idf.pkl", "rb") as f:
    word_idf_map = pickle.load(f)

with open(C_DIR / "query_token_keys.pkl", "rb") as f:
    query_token_keys = pickle.load(f)

with open(A_DIR / "off_exact.pkl", "rb") as f:
    off_exact = pickle.load(f)

with open(B_DIR / "off_sorted.pkl", "rb") as f:
    off_sorted = pickle.load(f)

with open(C_DIR / "off_word.pkl", "rb") as f:
    off_word_raw = pickle.load(f)

buf_exact = np.load(A_DIR / "buf_exact.npy", mmap_mode="r")
buf_sorted = np.load(B_DIR / "buf_sorted.npy", mmap_mode="r")
buf_word = np.load(C_DIR / "buf_word.npy", mmap_mode="r")
candidate_lengths = np.load(
    C_DIR / "candidate_lengths.npy",
    mmap_mode="r"
)

word_keys = off_word_raw["keys"]
word_offsets = off_word_raw["offsets"]

word_pos = {k: i for i, k in enumerate(word_keys)}

def get_postings_dict(buffer, offsets, key):
    entry = offsets.get(key)
    if entry is None:
        return np.empty(0, dtype=np.uint32)
    start, length = entry
    return buffer[start:start + length]

def get_postings_word(key):
    pos = word_pos.get(key)
    if pos is None:
        return np.empty(0, dtype=np.uint32)
    start = int(word_offsets[pos])
    end = int(word_offsets[pos + 1])
    return buf_word[start:end]

def candidate_source(cid):
    return 2 if cid < N_S2 else 3

idf_meta_path = C_DIR / "idf_meta.json"
avg_doc_len = None

if idf_meta_path.exists():
    try:
        meta = json.loads(idf_meta_path.read_text())
        for key in ["avg_doc_len", "avg_token_count", "mean_token_count", "avg_name_tokens"]:
            value = meta.get(key)
            if isinstance(value, (int, float)) and value > 0:
                avg_doc_len = float(value)
                break
    except Exception:
        pass

if avg_doc_len is None:
    nz = candidate_lengths[candidate_lengths > 0]
    assert len(nz) > 0
    avg_doc_len = float(np.mean(nz))

print("=" * 120)
print("BENCHMARK 4D: A+B+C UNIFIED RETRIEVAL / COMPRESSION")
print("=" * 120)
print(f"Sample A queries: {len(SAMPLE):,}")
print(f"Candidates: {N_CANDS:,}")
print(f"AVG_DOC_LEN used: {avg_doc_len:.4f}")

K_VALUES = [5, 10, 15, 20, 30, 40, 50, 75, 100]

results = []

raw_total_gt_edges = sum(
    len(q["gt_set"])
    for q in SAMPLE
    if q["match_count"] > 0
)

raw_abc_edges = 0

for q_idx, q in enumerate(SAMPLE):

    cntry = q["cntry"]
    gt_set = q["gt_set"]

    exact_set = set()

    if q.get("k_ex"):
        sl = get_postings_dict(
            buf_exact,
            off_exact,
            q["k_ex"]
        )
        if len(sl):
            exact_set.update(map(int, sl))

    sorted_set = set()

    if q.get("k_so"):
        sl = get_postings_dict(
            buf_sorted,
            off_sorted,
            q["k_so"]
        )
        if len(sl):
            sorted_set.update(map(int, sl))

    base_cands = exact_set | sorted_set

    q_name = ""
    if q.get("k_ex"):
        q_name = q["k_ex"].split("§", 1)[1]

    q_tokens = set(canonical_tokens(q_name))

    valid_words = [
        t for t in q_tokens
        if f"{cntry}§{t}" in word_idf_map
    ]

    ranked_words = sorted(
        valid_words,
        key=lambda t: word_idf_map[f"{cntry}§{t}"],
        reverse=True
    )[:2]

    cand_idfs = defaultdict(list)

    for word in ranked_words:
        key = f"{cntry}§{word}"
        idf = word_idf_map[key]

        sl = get_postings_word(key)

        if len(sl):
            for cid in sl:
                cand_idfs[int(cid)].append(idf)

    reachable = base_cands | set(cand_idfs.keys())

    if q["match_count"] > 0:
        raw_abc_edges += len(reachable & gt_set)

    if not cand_idfs:
        for k in K_VALUES:
            final_cands = base_cands

            hits = len(final_cands & gt_set)

            if q["match_count"] == 0:
                continue

            rec = hits / len(gt_set)

        continue

    scored_global = []
    scored_s2 = []
    scored_s3 = []

    q_len = max(1, len(q_tokens))

    for cid, idf_list in cand_idfs.items():

        raw_idf = float(sum(idf_list))
        matched = len(idf_list)

        doc_len = int(candidate_lengths[cid])
        if doc_len <= 0:
            doc_len = 1

        len_norm = raw_idf / (
            0.5 + 0.5 * (doc_len / avg_doc_len)
        )

        coverage = len_norm * (matched / q_len)

        evidence = (
            len_norm
            + (5.0 if cid in exact_set else 0.0)
            + (3.0 if cid in sorted_set else 0.0)
        )

        scored_global.append((evidence, cid))
        src = candidate_source(cid)

        if src == 2:
            scored_s2.append((evidence, cid))
        else:
            scored_s3.append((evidence, cid))

    scored_global.sort(reverse=True)
    scored_s2.sort(reverse=True)
    scored_s3.sort(reverse=True)

    for k in K_VALUES:

        selected_global = {
            cid for _, cid in scored_global[:k]
        }

        k_half = max(1, k // 2)

        selected_balanced = {
            cid for _, cid in scored_s2[:k_half]
        }

        selected_balanced.update(
            cid for _, cid in scored_s3[:k_half]
        )

        for policy, selected_c in [
            ("global", selected_global),
            ("balanced", selected_balanced)
        ]:

            final_cands = base_cands | selected_c
            nc = len(final_cands)

            if q["match_count"] == 0:
                hit = 0
                rec = 0.0
                any_hit = 0.0
                complete = 0.0
            else:
                hit = len(final_cands & gt_set)
                rec = hit / len(gt_set)
                any_hit = 1.0 if hit > 0 else 0.0
                complete = 1.0 if hit == len(gt_set) else 0.0

            results.append({
                "policy": policy,
                "K": k,
                "qid_idx": q_idx,
                "match_count": q["match_count"],
                "candidate_count": nc,
                "hits": hit,
                "recall": rec,
                "any_hit": any_hit,
                "complete": complete,
                "is_singleton": q["match_count"] == 0
            })

    if (q_idx + 1) % 2000 == 0:
        print(f"Processed {q_idx + 1:,} / {len(SAMPLE):,}")

raw_abc_recall = (
    raw_abc_edges / raw_total_gt_edges
    if raw_total_gt_edges else 0.0
)

print("\nRaw A+B+C ceiling:")
print(
    f"{raw_abc_recall:.4%} "
    f"({raw_abc_edges:,} / {raw_total_gt_edges:,})"
)

df_results = pl.DataFrame(results)

summary = (
    df_results
    .group_by(["policy", "K"])
    .agg([
        pl.col("recall").mean().alias("edge_recall"),
        pl.col("any_hit").mean().alias("any_match"),
        pl.col("complete").mean().alias("complete_recall"),
        pl.col("candidate_count").mean().alias("mean_candidates"),
        pl.col("candidate_count").median().alias("p50"),
        pl.col("candidate_count").quantile(0.95).alias("p95"),
        pl.col("candidate_count").quantile(0.99).alias("p99"),
        pl.col("candidate_count").max().alias("max_candidates"),
        pl.when(pl.col("is_singleton"))
          .then(pl.col("candidate_count") > 0)
          .otherwise(None)
          .drop_nulls()
          .mean()
          .alias("singleton_contamination")
    ])
    .sort(["policy", "K"])
)

print("\n" + "=" * 120)
print("A+B+C COMPRESSION MATRIX")
print("=" * 120)

print(
    summary.with_columns([
        (pl.col("edge_recall") * 100).round(3).alias("edge_recall_pct"),
        (pl.col("any_match") * 100).round(3).alias("any_match_pct"),
        (pl.col("complete_recall") * 100).round(3).alias("complete_pct"),
        (pl.col("singleton_contamination") * 100).round(3).alias("singleton_contam_pct")
    ]).select([
        "policy",
        "K",
        "edge_recall_pct",
        "any_match_pct",
        "complete_pct",
        "mean_candidates",
        "p50",
        "p95",
        "p99",
        "max_candidates",
        "singleton_contam_pct"
    ])
)

out_dir = C_DIR / "benchmarks"
out_dir.mkdir(parents=True, exist_ok=True)

summary.write_parquet(
    out_dir / "abc_compression_summary.parquet"
)

(out_dir / "abc_compression_summary.json").write_text(
    json.dumps(summary.to_dicts(), indent=2)
)

print(
    f"\nBenchmark runtime: {time.time() - START:.1f}s"
)
print(f"Saved: {out_dir / 'abc_compression_summary.parquet'}")
print(f"Saved: {out_dir / 'abc_compression_summary.json'}")

gc.collect()


import gc
import json
import pickle
import time
from pathlib import Path
from collections import defaultdict

import numpy as np
import polars as pl

REPO = Path("/kaggle/working/entity_resolution_repo")
A_DIR = REPO / "checkpoints" / "stage3_exact"
B_DIR = REPO / "checkpoints" / "stage3_sorted"
C_DIR = REPO / "checkpoints" / "stage4_channel_c"

with open(C_DIR / "queries_sample_a.pkl", "rb") as f:
    SAMPLE = pickle.load(f)

with open(A_DIR / "off_exact.pkl", "rb") as f:
    off_exact = pickle.load(f)

with open(B_DIR / "off_sorted.pkl", "rb") as f:
    off_sorted = pickle.load(f)

with open(C_DIR / "off_word.pkl", "rb") as f:
    off_word = pickle.load(f)

with open(C_DIR / "word_idf.pkl", "rb") as f:
    word_idf_map = pickle.load(f)

buf_exact = np.load(A_DIR / "buf_exact.npy", mmap_mode="r")
buf_sorted = np.load(B_DIR / "buf_sorted.npy", mmap_mode="r")
buf_word = np.load(C_DIR / "buf_word.npy", mmap_mode="r")

candidate_lengths = np.load(
    C_DIR / "candidate_lengths.npy",
    mmap_mode="r"
)

word_keys = off_word["keys"]
word_offsets = off_word["offsets"]

word_pos = {k: i for i, k in enumerate(word_keys)}

def get_postings_dict(buffer, offsets, key):
    entry = offsets.get(key)
    if entry is None:
        return np.empty(0, dtype=np.uint32)

    start, length = entry
    return buffer[start:start + length]

def get_word_postings(key):
    p = word_pos.get(key)
    if p is None:
        return np.empty(0, dtype=np.uint32)

    start = int(word_offsets[p])
    end = int(word_offsets[p + 1])

    return buf_word[start:end]

print("=" * 110)
print("AUDIT: A+B+C RETRIEVAL METRIC CONSISTENCY + SINGLETON CONTAMINATION")
print("=" * 110)

n_singletons = sum(q["match_count"] == 0 for q in SAMPLE)
n_positive = len(SAMPLE) - n_singletons

print(f"Sample A: {len(SAMPLE):,}")
print(f"Singleton queries: {n_singletons:,}")
print(f"Positive queries: {n_positive:,}")

total_gt_edges = sum(
    len(q["gt_set"])
    for q in SAMPLE
    if q["match_count"] > 0
)

raw_micro_hits = 0
raw_query_recalls = []

ab_singleton_nonzero = 0
abc_singleton_nonzero = 0

singleton_ab_counts = []
singleton_abc_counts = []

K_VALUES = [5, 20, 50, 100]

compression_stats = {
    ("global", k): {"hits": 0, "recalls": [], "counts": []}
    for k in K_VALUES
}

compression_stats.update({
    ("balanced", k): {"hits": 0, "recalls": [], "counts": []}
    for k in K_VALUES
})

for i, q in enumerate(SAMPLE):

    exact_set = set()

    if q.get("k_ex"):
        sl = get_postings_dict(
            buf_exact,
            off_exact,
            q["k_ex"]
        )
        exact_set.update(map(int, sl))

    sorted_set = set()

    if q.get("k_so"):
        sl = get_postings_dict(
            buf_sorted,
            off_sorted,
            q["k_so"]
        )
        sorted_set.update(map(int, sl))

    base = exact_set | sorted_set

    if q["match_count"] == 0:
        singleton_ab_counts.append(len(base))

        if len(base) > 0:
            ab_singleton_nonzero += 1

    q_name = ""

    if q.get("k_ex"):
        parts = q["k_ex"].split("§", 1)
        if len(parts) == 2:
            q_name = parts[1]

    q_tokens = set(canonical_tokens(q_name))

    valid_words = [
        t for t in q_tokens
        if f"{q['cntry']}§{t}" in word_idf_map
    ]

    ranked_words = sorted(
        valid_words,
        key=lambda t: word_idf_map[f"{q['cntry']}§{t}"],
        reverse=True
    )[:2]

    cand_scores = defaultdict(float)

    for word in ranked_words:

        key = f"{q['cntry']}§{word}"
        idf = word_idf_map[key]

        sl = get_word_postings(key)

        for cid in sl:
            cid = int(cid)

            doc_len = int(candidate_lengths[cid])
            if doc_len <= 0:
                doc_len = 1

            score = idf / (
                0.5 + 0.5 * (doc_len / 3.9740)
            )

            if cid in exact_set:
                score += 5.0

            if cid in sorted_set:
                score += 3.0

            if score > cand_scores[cid]:
                cand_scores[cid] = score

    abc = base | set(cand_scores.keys())

    if q["match_count"] == 0:

        singleton_abc_counts.append(len(abc))

        if len(abc) > 0:
            abc_singleton_nonzero += 1

    else:

        hits = len(abc & q["gt_set"])

        raw_micro_hits += hits

        raw_query_recalls.append(
            hits / len(q["gt_set"])
        )

    ranked = sorted(
        cand_scores.items(),
        key=lambda x: x[1],
        reverse=True
    )

    for policy in ["global", "balanced"]:

        if policy == "global":

            ranked_selected = {
                cid
                for _, cid in ranked[:100]
            }

            selections = {
                k: {
                    cid
                    for _, cid in ranked[:k]
                }
                for k in K_VALUES
            }

        else:

            s2 = [
                (score, cid)
                for score, cid in ranked
                if cid < 5_034_616
            ]

            s3 = [
                (score, cid)
                for score, cid in ranked
                if cid >= 5_034_616
            ]

            selections = {}

            for k in K_VALUES:

                half = max(1, k // 2)

                selections[k] = (
                    {cid for _, cid in s2[:half]}
                    |
                    {cid for _, cid in s3[:half]}
                )

        for k in K_VALUES:

            final = base | selections[k]

            compression_stats[(policy, k)]["counts"].append(
                len(final)
            )

            if q["match_count"] > 0:

                hits = len(final & q["gt_set"])

                compression_stats[(policy, k)]["hits"] += hits

                compression_stats[(policy, k)]["recalls"].append(
                    hits / len(q["gt_set"])
                )

    if (i + 1) % 5000 == 0:
        print(f"Processed {i + 1:,} / {len(SAMPLE):,}")

raw_micro = raw_micro_hits / total_gt_edges
raw_macro = float(np.mean(raw_query_recalls))

print("\n" + "=" * 110)
print("RAW ABC RECALL — SAME DENOMINATOR AUDIT")
print("=" * 110)

print(
    f"Micro edge recall : {raw_micro:.4%} "
    f"({raw_micro_hits:,} / {total_gt_edges:,})"
)

print(
    f"Macro query recall: {raw_macro:.4%}"
)

print("\n" + "=" * 110)
print("SINGLETON CONTAMINATION AUDIT")
print("=" * 110)

print(
    f"A+B singleton contaminated : "
    f"{ab_singleton_nonzero:,} / {n_singletons:,} "
    f"= {ab_singleton_nonzero / n_singletons:.4%}"
)

print(
    f"A+B singleton mean candidates: "
    f"{np.mean(singleton_ab_counts):.3f}"
)

print(
    f"A+B+C singleton contaminated: "
    f"{abc_singleton_nonzero:,} / {n_singletons:,} "
    f"= {abc_singleton_nonzero / n_singletons:.4%}"
)

print(
    f"A+B+C singleton mean candidates: "
    f"{np.mean(singleton_abc_counts):.3f}"
)

print(
    f"A+B singleton P50/P95/P99: "
    f"{np.percentile(singleton_ab_counts,50):.0f} / "
    f"{np.percentile(singleton_ab_counts,95):.0f} / "
    f"{np.percentile(singleton_ab_counts,99):.0f}"
)

print(
    f"A+B+C singleton P50/P95/P99: "
    f"{np.percentile(singleton_abc_counts,50):.0f} / "
    f"{np.percentile(singleton_abc_counts,95):.0f} / "
    f"{np.percentile(singleton_abc_counts,99):.0f}"
)

print("\n" + "=" * 110)
print("COMPRESSION — MICRO + MACRO ON POSITIVE QUERIES")
print("=" * 110)

for policy in ["global", "balanced"]:

    for k in K_VALUES:

        st = compression_stats[(policy, k)]

        micro = st["hits"] / total_gt_edges
        macro = float(np.mean(st["recalls"]))

        retention_micro = (
            st["hits"] / raw_micro_hits
            if raw_micro_hits
            else 0.0
        )

        retention_macro = (
            macro / raw_macro
            if raw_macro
            else 0.0
        )

        counts = st["counts"]

        print(
            f"{policy:9s} K={k:3d} | "
            f"micro={micro:.4%} | "
            f"macro={macro:.4%} | "
            f"micro_ret={retention_micro:.4%} | "
            f"macro_ret={retention_macro:.4%} | "
            f"mean_cands={np.mean(counts):.2f} | "
            f"P95={np.percentile(counts,95):.0f}"
        )

print("\n" + "=" * 110)
print("AUDIT COMPLETE")
print("=" * 110)

gc.collect()


import gc
import json
import pickle
import time
from collections import defaultdict
from pathlib import Path

import numpy as np
import polars as pl

REPO = Path("/kaggle/working/entity_resolution_repo")

A_DIR = REPO / "checkpoints" / "stage3_exact"
B_DIR = REPO / "checkpoints" / "stage3_sorted"
C_DIR = REPO / "checkpoints" / "stage4_channel_c"

with open(C_DIR / "queries_sample_a.pkl", "rb") as f:
    SAMPLE = pickle.load(f)

with open(A_DIR / "off_exact.pkl", "rb") as f:
    off_exact = pickle.load(f)

with open(B_DIR / "off_sorted.pkl", "rb") as f:
    off_sorted = pickle.load(f)

with open(C_DIR / "off_word.pkl", "rb") as f:
    off_word = pickle.load(f)

with open(C_DIR / "word_idf.pkl", "rb") as f:
    word_idf_map = pickle.load(f)

buf_exact = np.load(
    A_DIR / "buf_exact.npy",
    mmap_mode="r"
)

buf_sorted = np.load(
    B_DIR / "buf_sorted.npy",
    mmap_mode="r"
)

buf_word = np.load(
    C_DIR / "buf_word.npy",
    mmap_mode="r"
)

candidate_lengths = np.load(
    C_DIR / "candidate_lengths.npy",
    mmap_mode="r"
)

word_keys = off_word["keys"]
word_offsets = off_word["offsets"]

word_pos = {
    k: i for i, k in enumerate(word_keys)
}

N_S2 = 5_034_616
N_S3 = 5_285_603
N_CANDS = N_S2 + N_S3

assert len(SAMPLE) == 20_000
assert buf_exact.dtype == np.uint32
assert buf_sorted.dtype == np.uint32
assert buf_word.dtype == np.uint32

def get_postings_dict(buffer, offsets, key):
    if not key:
        return np.empty(0, dtype=np.uint32)

    entry = offsets.get(key)

    if entry is None:
        return np.empty(0, dtype=np.uint32)

    start, length = entry

    return buffer[
        start:start + length
    ]

def get_word_postings(key):
    pos = word_pos.get(key)

    if pos is None:
        return np.empty(0, dtype=np.uint32)

    start = int(word_offsets[pos])
    end = int(word_offsets[pos + 1])

    return buf_word[start:end]

nz_lengths = candidate_lengths[
    candidate_lengths > 0
]

AVG_DOC_LEN = float(
    np.mean(nz_lengths)
)

K_VALUES = [
    5, 10, 15, 20, 30,
    40, 50, 75, 100
]

raw_micro_hits = 0
raw_macro_recalls = []

raw_any_hits = []
raw_complete_hits = []

raw_candidate_counts = []

singleton_raw_counts = []

results = []

START = time.time()

print("=" * 120)
print("CORRECTED BENCHMARK: STRICT UNIFIED A+B+C TOP-K")
print("=" * 120)

for qi, q in enumerate(SAMPLE):

    gt_set = q["gt_set"]
    is_singleton = q["match_count"] == 0
    cntry = q["cntry"]

    exact_set = set()

    if q.get("k_ex"):
        vals = get_postings_dict(
            buf_exact,
            off_exact,
            q["k_ex"]
        )

        if len(vals):
            exact_set.update(
                map(int, vals)
            )

    sorted_set = set()

    if q.get("k_so"):
        vals = get_postings_dict(
            buf_sorted,
            off_sorted,
            q["k_so"]
        )

        if len(vals):
            sorted_set.update(
                map(int, vals)
            )

    base = exact_set | sorted_set

    if q.get("k_ex"):
        parts = q["k_ex"].split("§", 1)

        if len(parts) == 2:
            q_name = parts[1]
        else:
            q_name = q["k_ex"]
    else:
        q_name = ""

    q_tokens = set(
        canonical_tokens(q_name)
    )

    q_len = max(
        1,
        len(q_tokens)
    )

    valid_tokens = [
        t
        for t in q_tokens
        if f"{cntry}§{t}" in word_idf_map
    ]

    ranked_tokens = sorted(
        valid_tokens,
        key=lambda t:
            word_idf_map[f"{cntry}§{t}"],
        reverse=True
    )[:2]

    cand_idfs = defaultdict(list)

    for token in ranked_tokens:

        key = f"{cntry}§{token}"

        idf = word_idf_map[key]

        vals = get_word_postings(key)

        for cid in vals:
            cand_idfs[int(cid)].append(idf)

    unified = base | set(
        cand_idfs.keys()
    )

    raw_candidate_counts.append(
        len(unified)
    )

    if is_singleton:

        singleton_raw_counts.append(
            len(unified)
        )

    else:

        hits = len(
            unified & gt_set
        )

        raw_micro_hits += hits

        rec = hits / len(gt_set)

        raw_macro_recalls.append(
            rec
        )

        raw_any_hits.append(
            1.0 if hits > 0 else 0.0
        )

        raw_complete_hits.append(
            1.0 if hits == len(gt_set) else 0.0
        )

    scored = []

    for cid in unified:

        idfs = cand_idfs.get(cid)

        if idfs:

            raw_idf_sum = float(
                sum(idfs)
            )

            doc_len = int(
                candidate_lengths[cid]
            )

            if doc_len <= 0:
                doc_len = 1

            s_norm = (
                raw_idf_sum
                /
                (
                    0.5
                    +
                    0.5 * (
                        doc_len
                        /
                        AVG_DOC_LEN
                    )
                )
            )

            coverage = (
                len(idfs)
                /
                q_len
            )

            lexical_score = (
                s_norm
                *
                (
                    0.5
                    +
                    0.5 * coverage
                )
            )

        else:

            lexical_score = 0.0

        boost = (
            8.0 if cid in exact_set else 0.0
        ) + (
            4.0 if cid in sorted_set else 0.0
        )

        score = boost + lexical_score

        scored.append(
            (
                float(score),
                int(cid)
            )
        )

    scored.sort(
        key=lambda x: (
            -x[0],
            x[1]
        )
    )

    global_ranked = [
        cid
        for _, cid in scored
    ]

    s2_ranked = [
        cid
        for _, cid in scored
        if cid < N_S2
    ]

    s3_ranked = [
        cid
        for _, cid in scored
        if cid >= N_S2
    ]

    for K in K_VALUES:

        global_selected = set(
            global_ranked[:K]
        )

        half = max(
            1,
            K // 2
        )

        balanced_selected = (
            set(s2_ranked[:half])
            |
            set(s3_ranked[:half])
        )

        policies = [
            (
                "global",
                global_selected
            ),
            (
                "balanced",
                balanced_selected
            )
        ]

        for policy, selected in policies:

            nc = len(selected)

            if is_singleton:

                hits = 0
                recall = 0.0
                any_hit = 0.0
                complete = 0.0

            else:

                hits = len(
                    selected & gt_set
                )

                recall = (
                    hits
                    /
                    len(gt_set)
                )

                any_hit = (
                    1.0
                    if hits > 0
                    else 0.0
                )

                complete = (
                    1.0
                    if hits == len(gt_set)
                    else 0.0
                )

            results.append(
                {
                    "policy": policy,
                    "K": K,
                    "candidate_count": nc,
                    "hits": hits,
                    "recall": recall,
                    "any_hit": any_hit,
                    "complete": complete,
                    "singleton": is_singleton
                }
            )

    if (qi + 1) % 2000 == 0:
        print(
            f"Processed {qi + 1:,} / {len(SAMPLE):,}"
        )

raw_micro = (
    raw_micro_hits
    /
    sum(
        len(q["gt_set"])
        for q in SAMPLE
        if q["match_count"] > 0
    )
)

raw_macro = float(
    np.mean(raw_macro_recalls)
)

raw_any = float(
    np.mean(raw_any_hits)
)

raw_complete = float(
    np.mean(raw_complete_hits)
)

raw_singleton_contam = (
    np.mean(
        np.asarray(
            singleton_raw_counts
        ) > 0
    )
)

raw_singleton_mean = float(
    np.mean(
        singleton_raw_counts
    )
)

df = pl.DataFrame(
    results
)

summary_rows = []

for policy in [
    "global",
    "balanced"
]:

    for K in K_VALUES:

        part = df.filter(
            (pl.col("policy") == policy)
            &
            (pl.col("K") == K)
        )

        pos = part.filter(
            ~pl.col("singleton")
        )

        sing = part.filter(
            pl.col("singleton")
        )

        micro_hits = int(
            pos["hits"].sum()
        )

        micro_recall = (
            micro_hits
            /
            raw_micro_hits
            *
            raw_micro
            if raw_micro_hits
            else 0.0
        )

        macro_recall = float(
            pos["recall"].mean()
        )

        any_recall = float(
            pos["any_hit"].mean()
        )

        complete_recall = float(
            pos["complete"].mean()
        )

        all_counts = (
            part["candidate_count"]
            .to_numpy()
        )

        singleton_counts = (
            sing["candidate_count"]
            .to_numpy()
        )

        retention_micro = (
            micro_hits
            /
            raw_micro_hits
            if raw_micro_hits
            else 0.0
        )

        retention_macro = (
            macro_recall
            /
            raw_macro
            if raw_macro
            else 0.0
        )

        summary_rows.append(
            {
                "policy": policy,
                "K": K,
                "micro_recall": micro_recall,
                "macro_recall": macro_recall,
                "micro_retention": retention_micro,
                "macro_retention": retention_macro,
                "any_match": any_recall,
                "complete_recall": complete_recall,
                "mean_candidates": float(
                    np.mean(all_counts)
                ),
                "p50": float(
                    np.percentile(
                        all_counts,
                        50
                    )
                ),
                "p95": float(
                    np.percentile(
                        all_counts,
                        95
                    )
                ),
                "p99": float(
                    np.percentile(
                        all_counts,
                        99
                    )
                ),
                "max_candidates": int(
                    np.max(all_counts)
                ),
                "singleton_contamination": float(
                    np.mean(
                        singleton_counts > 0
                    )
                ),
                "singleton_mean": float(
                    np.mean(singleton_counts)
                )
            }
        )

summary = pl.DataFrame(
    summary_rows
)

print("\n" + "=" * 120)
print("RAW A+B+C UNIFIED CEILING")
print("=" * 120)

print(
    f"Micro edge recall       : {raw_micro:.4%}"
)

print(
    f"Macro query recall     : {raw_macro:.4%}"
)

print(
    f"Any-match recall       : {raw_any:.4%}"
)

print(
    f"Complete query recall  : {raw_complete:.4%}"
)

print(
    f"Mean raw candidates    : "
    f"{np.mean(raw_candidate_counts):.2f}"
)

print(
    f"Raw candidate P95      : "
    f"{np.percentile(raw_candidate_counts,95):.0f}"
)

print(
    f"Raw candidate P99      : "
    f"{np.percentile(raw_candidate_counts,99):.0f}"
)

print(
    f"Singleton contamination: "
    f"{raw_singleton_contam:.4%}"
)

print(
    f"Singleton mean         : "
    f"{raw_singleton_mean:.2f}"
)

print("\n" + "=" * 120)
print("CORRECTED STRICT TOP-K MATRIX")
print("=" * 120)

display_df = summary.with_columns([
    (
        pl.col("micro_recall") * 100
    ).round(3).alias("micro_recall_pct"),

    (
        pl.col("macro_recall") * 100
    ).round(3).alias("macro_recall_pct"),

    (
        pl.col("micro_retention") * 100
    ).round(3).alias("micro_retention_pct"),

    (
        pl.col("macro_retention") * 100
    ).round(3).alias("macro_retention_pct"),

    (
        pl.col("any_match") * 100
    ).round(3).alias("any_match_pct"),

    (
        pl.col("complete_recall") * 100
    ).round(3).alias("complete_pct"),

    (
        pl.col("singleton_contamination") * 100
    ).round(3).alias("singleton_contam_pct")
])

print(
    display_df.select([
        "policy",
        "K",
        "micro_recall_pct",
        "macro_recall_pct",
        "micro_retention_pct",
        "macro_retention_pct",
        "any_match_pct",
        "complete_pct",
        "mean_candidates",
        "p50",
        "p95",
        "p99",
        "max_candidates",
        "singleton_contam_pct",
        "singleton_mean"
    ])
)

OUT = (
    C_DIR
    / "benchmarks"
    / "abc_strict_corrected"
)

OUT.mkdir(
    parents=True,
    exist_ok=True
)

summary.write_parquet(
    OUT / "summary.parquet"
)

(OUT / "summary.json").write_text(
    json.dumps(
        summary.to_dicts(),
        indent=2
    )
)

manifest = {
    "benchmark": "abc_strict_corrected",
    "sample_queries": len(SAMPLE),
    "n_s2": N_S2,
    "n_s3": N_S3,
    "avg_doc_len": AVG_DOC_LEN,
    "raw_micro_recall": raw_micro,
    "raw_macro_recall": raw_macro,
    "raw_any_match": raw_any,
    "raw_complete_recall": raw_complete,
    "raw_singleton_contamination": raw_singleton_contam,
    "raw_singleton_mean_candidates": raw_singleton_mean,
    "runtime_seconds": time.time() - START
}

(
    OUT / "manifest.json"
).write_text(
    json.dumps(
        manifest,
        indent=2
    )
)

print("\n" + "=" * 120)
print(
    f"CORRECTED BENCHMARK COMPLETE | "
