print("\n[7/7] Locked Sample-B evaluation...")

v_q_idx = (
    df_features_b["q_idx"]
    .to_numpy()
    .astype(np.int32)
)

v_label = (
    df_features_b["label"]
    .to_numpy()
    .astype(np.int8)
)

v_rank = (
    df_features_b["retrieval_rank"]
    .to_numpy()
    .astype(np.int16)
)

v_prob = ensemble_prob_b

query_n_gt = np.zeros(
    N_QUERIES_B,
    dtype=np.int32
)

for (
    q_idx,
    qid,
    match_count,
    _,
    _,
    _
) in query_offsets_b:

    query_n_gt[q_idx] = (
        int(match_count)
    )

is_singleton = (
    query_n_gt == 0
)

is_non_singleton = (
    query_n_gt > 0
)

n_singletons = int(
    np.count_nonzero(
        is_singleton
    )
)

def evaluate_locked(
    k_limit,
    threshold
):

    active = (
        (v_rank <= k_limit)
        &
        (v_prob >= threshold)
    )

    pred_counts = np.bincount(
        v_q_idx[active],
        minlength=N_QUERIES_B
    )

    tp_counts = np.bincount(
        v_q_idx[
            active
            &
            (v_label == 1)
        ],
        minlength=N_QUERIES_B
    )

    singleton_correct = (
        pred_counts[
            is_singleton
        ] == 0
    )

    singleton_acc = (
        float(
            np.mean(
                singleton_correct
            )
        )
        if n_singletons
        else 1.0
    )

    tp = tp_counts[
        is_non_singleton
    ]

    pred = pred_counts[
        is_non_singleton
    ]

    gt = query_n_gt[
        is_non_singleton
    ]

    fp = pred - tp
    fn = gt - tp

    denom = (
        1.25 * tp
        + 0.25 * fn
        + fp
    )

    f05_ns = np.zeros(
        len(denom),
        dtype=np.float64
    )

    valid = denom > 0

    f05_ns[valid] = (
        1.25
        * tp[valid]
        / denom[valid]
    )

    all_f05 = np.empty(
        N_QUERIES_B,
        dtype=np.float64
    )

    all_f05[
        is_singleton
    ] = singleton_correct.astype(
        np.float64
    )

    all_f05[
        is_non_singleton
    ] = f05_ns

    precision = np.zeros(
        len(pred),
        dtype=np.float64
    )

    has_pred = pred > 0

    precision[
        has_pred
    ] = (
        tp[has_pred]
        /
        pred[has_pred]
    )

    recall = (
        tp / gt
    )

    return {
        "K": k_limit,
        "Threshold": threshold,
        "Macro F0.5": float(
            np.mean(all_f05)
        ),
        "Precision": float(
            np.mean(precision)
        ),
        "Recall": float(
            np.mean(recall)
        ),
        "Non-Sing F0.5": float(
            np.mean(f05_ns)
        ),
        "Singleton Acc": float(
            singleton_acc
        ),
        "Singleton FPR": float(
            1.0 - singleton_acc
        )
    }

locked_results = [
    evaluate_locked(30, 0.50),
    evaluate_locked(50, 0.50),
    evaluate_locked(100, 0.50)
]

locked_df = pl.DataFrame(
    locked_results
)

print()
print("=" * 120)
print("LOCKED ZERO-SHOT GENERALIZATION RESULTS")
print("=" * 120)

print(locked_df)

print()
print(
    f"Sample-B singleton queries: "
    f"{n_singletons:,}"
)

print()
print("=" * 120)
print("REFERENCE GRID")
print("=" * 120)

reference_results = []

for k in [
    20,
    30,
    50,
    75,
    100
]:

    for tau in [
        0.20,
        0.35,
        0.50,
        0.65
    ]:

        reference_results.append(
            evaluate_locked(
                k,
                tau
            )
        )

reference_df = pl.DataFrame(
    reference_results
)

print(
    reference_df.pivot(
        values="Macro F0.5",
        index="Threshold",
        on="K"
    )
    .sort("Threshold")
)

print()
print("=" * 120)
print("SAMPLE-B CANDIDATE DIAGNOSTICS")
print("=" * 120)

candidate_counts = np.bincount(
    v_q_idx,
    minlength=N_QUERIES_B
)

print(
    f"Mean candidates: "
    f"{float(np.mean(candidate_counts)):.2f}"
)

print(
    f"P50 candidates: "
    f"{float(np.percentile(candidate_counts, 50)):.2f}"
)

print(
    f"P95 candidates: "
    f"{float(np.percentile(candidate_counts, 95)):.2f}"
)

print(
    f"P99 candidates: "
    f"{float(np.percentile(candidate_counts, 99)):.2f}"
)

print(
    f"Max candidates: "
    f"{int(np.max(candidate_counts)):,}"
)

print(
    f"Zero-candidate queries: "
    f"{int(np.count_nonzero(candidate_counts == 0)):,}"
)

locked_df.write_csv(
    "/kaggle/working/"
    "benchmark7_locked_results.tsv",
    separator="\t"
)

reference_df.write_csv(
    "/kaggle/working/"
    "benchmark7_reference_grid.tsv",
    separator="\t"
)

print()
print("=" * 120)
print(
    f"BENCHMARK 7 COMPLETE | "
