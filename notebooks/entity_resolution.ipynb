    idx = cid - N_S2
    return s3_names[idx], s3_cntry[idx], 3

# Boundary-Safe Fast Jaro-Winkler
def jaro_winkler_safe(s1, s2):
    if s1 == s2: return 1.0
    if not s1 or not s2: return 0.0
    l1, l2 = len(s1), len(s2)
    max_d = max(0, max(l1, l2) // 2 - 1)
    
    m1 = [False] * l1
    m2 = [False] * l2
    matches = 0
    
    for i in range(l1):
        start = max(0, i - max_d)
        end = min(i + max_d + 1, l2)
        for j in range(start, end):
            if not m2[j] and s1[i] == s2[j]:
                m1[i] = True
                m2[j] = True
                matches += 1
                break
                
    if matches == 0: 
        return 0.0
        
    t = 0
    k = 0
    for i in range(l1):
        if m1[i]:
            while not m2[k]: 
                k += 1
            if s1[i] != s2[k]: 
                t += 1
            k += 1
            
    jaro = (matches / l1 + matches / l2 + (matches - (t / 2.0)) / matches) / 3.0
    prefix_len = 0
    for i in range(min(4, min(l1, l2))):
        if s1[i] == s2[i]: 
            prefix_len += 1
        else: 
            break
            
    return float(jaro + prefix_len * 0.1 * (1.0 - jaro))

def levenshtein_ratio(s1, s2):
    if s1 == s2: return 1.0
    if not s1 or not s2: return 0.0
    if len(s1) < len(s2):
        s1, s2 = s2, s1
    if len(s2) == 0:
        return 0.0
    
    previous_row = list(range(len(s2) + 1))
    for i, c1 in enumerate(s1):
        current_row = [i + 1] + [0] * len(s2)
        for j, c2 in enumerate(s2):
            insertions = previous_row[j + 1] + 1
            deletions = current_row[j] + 1
            substitutions = previous_row[j] + (c1 != c2)
            current_row[j + 1] = min(insertions, deletions, substitutions)
        previous_row = current_row
        
    dist = previous_row[-1]
    return float(1.0 - (dist / max(len(s1), len(s2))))

def char_trigram_jaccard(s1, s2):
    if s1 == s2: return 1.0
    if len(s1) < 3 or len(s2) < 3: return 0.0
    t1 = {s1[i:i+3] for i in range(len(s1) - 2)}
    t2 = {s2[i:i+3] for i in range(len(s2) - 2)}
    union_len = len(t1 | t2)
    return float(len(t1 & t2) / union_len) if union_len > 0 else 0.0

