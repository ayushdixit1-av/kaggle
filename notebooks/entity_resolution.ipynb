import gc
import json
import pickle
import time
from collections import defaultdict
from pathlib import Path
import numpy as np
import polars as pl

REPO = Path("/kaggle/working/entity_resolution_repo")
STAGE4_DIR = REPO / "checkpoints" / "stage4_channel_c"

with open(STAGE4_DIR / "query_token_keys.pkl", "rb") as f:
    query_token_keys = pickle.load(f)

assert isinstance(query_token_keys, set)
assert len(query_token_keys) > 0

S2_PATH = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train/train_source2.tsv")
S3_PATH = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train/train_source3.tsv")

assert S2_PATH.exists()
assert S3_PATH.exists()

def _norm_country(x):
    return norm_country(x)

def _tokens(x):
    return canonical_tokens(x or "")

df_s2 = pl.read_csv(
    S2_PATH,
    separator="\t",
    columns=["entity_id", "business_name", "country"]
)

df_s3 = pl.read_csv(
    S3_PATH,
    separator="\t",
    columns=["entity_id", "business_name", "country"]
)

N_S2 = df_s2.height
N_S3 = df_s3.height
N_CANDS = N_S2 + N_S3
MAX_POSTINGS = 1500

assert N_S2 == 5_034_616
assert N_S3 == 5_285_603

t0 = time.time()

relevant_postings = defaultdict(list)
candidate_lengths = np.zeros(N_CANDS, dtype=np.uint16)

for source_id, frame in ((2, df_s2), (3, df_s3)):
    base_idx = 0 if source_id == 2 else N_S2

    for local_idx, (country, name) in enumerate(
        frame.select(["country", "business_name"]).iter_rows()
    ):
        cid = base_idx + local_idx
        cntry = _norm_country(country)
        tok_list = _tokens(name)

        matched_target = False

        for tok in set(tok_list):
            if len(tok) < 3:
                continue

            key = f"{cntry}§{tok}"

            if key not in query_token_keys:
                continue

            postings = relevant_postings[key]

            if len(postings) < MAX_POSTINGS:
                postings.append(cid)

            matched_target = True

        if matched_target:
            candidate_lengths[cid] = min(65535, max(1, len(tok_list)))

    print(f"source {source_id} complete")

keys = sorted(relevant_postings.keys())

offsets = np.zeros(len(keys) + 1, dtype=np.int64)

total = 0
for i, key in enumerate(keys):
    total += len(relevant_postings[key])
    offsets[i + 1] = total

buf_word = np.empty(total, dtype=np.uint32)

pos = 0
for key in keys:
    vals = relevant_postings[key]
    n = len(vals)
    if n:
        buf_word[pos:pos+n] = vals
        pos += n

assert pos == total

buf_path = STAGE4_DIR / "buf_word.npy"
off_path = STAGE4_DIR / "off_word.pkl"
len_path = STAGE4_DIR / "candidate_lengths.npy"
manifest_path = STAGE4_DIR / "channel_c_manifest.json"

np.save(buf_path, buf_word, allow_pickle=False)
np.save(len_path, candidate_lengths, allow_pickle=False)

with open(off_path, "wb") as f:
    pickle.dump(
        {
            "keys": keys,
            "offsets": offsets
        },
        f,
        protocol=pickle.HIGHEST_PROTOCOL
    )

manifest = {
    "stage": "stage4d_channel_c",
    "status": "verified",
    "n_s2": N_S2,
    "n_s3": N_S3,
    "n_candidates": N_CANDS,
    "n_query_token_keys": len(query_token_keys),
    "n_retained_keys": len(keys),
    "max_postings": MAX_POSTINGS,
    "total_postings": int(total),
    "runtime_seconds": round(time.time() - t0, 3),
    "files": {}
}

for path in [buf_path, off_path, len_path]:
    manifest["files"][path.name] = {
        "size_bytes": path.stat().st_size
    }

manifest_path.write_text(json.dumps(manifest, indent=2))

buf_check = np.load(buf_path, mmap_mode="r")
len_check = np.load(len_path, mmap_mode="r")

with open(off_path, "rb") as f:
    off_check = pickle.load(f)

assert buf_check.dtype == np.uint32
assert buf_check.shape == (total,)
assert len_check.shape == (N_CANDS,)
assert len(off_check["keys"]) == len(keys)
assert len(off_check["offsets"]) == len(keys) + 1
assert int(off_check["offsets"][-1]) == total
assert np.all(off_check["offsets"][1:] >= off_check["offsets"][:-1])

print("=" * 90)
print("STAGE 4D CHANNEL C VERIFIED")
print("=" * 90)
print(f"S2 candidates: {N_S2:,}")
print(f"S3 candidates: {N_S3:,}")
print(f"Query token keys: {len(query_token_keys):,}")
print(f"Retained posting keys: {len(keys):,}")
print(f"Total postings: {total:,}")
print(f"Max posting cap: {MAX_POSTINGS:,}")
print(f"Runtime: {time.time() - t0:.1f}s")

del relevant_postings
del buf_word
del offsets
del candidate_lengths
del buf_check
del len_check
del off_check
del df_s2
del df_s3
gc.collect()


