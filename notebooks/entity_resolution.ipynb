import gc
import pickle
import numpy as np
from collections import defaultdict
from pathlib import Path

REPO = Path("/kaggle/working/entity_resolution_repo")
CK = REPO / "checkpoints"

A_DIR = CK / "stage3_exact"
B_DIR = CK / "stage3_sorted"
P_DIR = CK / "stage3_postal"
C_DIR = CK / "stage4_channel_c"

with open(C_DIR / "queries_sample_a.pkl", "rb") as f:
    SAMPLE = pickle.load(f)

with open(A_DIR / "off_exact.pkl", "rb") as f:
    off_exact = pickle.load(f)

with open(B_DIR / "off_sorted.pkl", "rb") as f:
    off_sorted = pickle.load(f)

with open(P_DIR / "off_postal.pkl", "rb") as f:
    off_postal = pickle.load(f)

with open(C_DIR / "off_word.pkl", "rb") as f:
    off_word = pickle.load(f)

with open(C_DIR / "word_idf.pkl", "rb") as f:
    word_idf_map = pickle.load(f)

buf_exact = np.load(
    A_DIR / "buf_exact.npy",
    mmap_mode="r"
)

buf_sorted = np.load(
    B_DIR / "buf_sorted.npy",
    mmap_mode="r"
)

buf_postal = np.load(
    P_DIR / "buf_postal.npy",
    mmap_mode="r"
)

buf_word = np.load(
    C_DIR / "buf_word.npy",
    mmap_mode="r"
)

word_keys = off_word["keys"]
word_offsets = off_word["offsets"]

word_pos = {
    k: i
    for i, k in enumerate(word_keys)
}

N_S2 = 5_034_616

def get_postings_dict(buffer, offsets, key):
    if not key:
        return np.empty(0, dtype=np.uint32)

    entry = offsets.get(key)

    if entry is None:
        return np.empty(0, dtype=np.uint32)

    start, length = entry

    return buffer[
        start:start + length
    ]

def get_word_postings(key):
    pos = word_pos.get(key)

    if pos is None:
        return np.empty(0, dtype=np.uint32)

    start = int(word_offsets[pos])
    end = int(word_offsets[pos + 1])

    return buf_word[start:end]

total_gt_edges = sum(
    len(q["gt_set"])
    for q in SAMPLE
    if q["match_count"] > 0
)

abc_edges = 0
abc_postal_edges = 0

abc_counts = []
abc_postal_counts = []

new_edges = 0
new_queries = 0

print("=" * 105)
print("STAGE E0: CORRECTED ABC + POSTAL MARGINAL RETRIEVAL")
print("=" * 105)

for qi, q in enumerate(SAMPLE):

    if q["match_count"] == 0:
        continue

    cntry = q["cntry"]
    gt = q["gt_set"]

    exact = set()

    if q.get("k_ex"):
        vals = get_postings_dict(
            buf_exact,
            off_exact,
            q["k_ex"]
        )

        if len(vals):
            exact.update(map(int, vals))

    sorted_name = set()

    if q.get("k_so"):
        vals = get_postings_dict(
            buf_sorted,
            off_sorted,
            q["k_so"]
        )

        if len(vals):
            sorted_name.update(map(int, vals))

    base = exact | sorted_name

    if q.get("k_ex"):
        parts = q["k_ex"].split("§", 1)

        if len(parts) == 2:
            q_name = parts[1]
        else:
            q_name = q["k_ex"]
    else:
        q_name = ""

    q_tokens = set(
        canonical_tokens(q_name)
    )

    valid_tokens = [
        t
        for t in q_tokens
        if f"{cntry}§{t}" in word_idf_map
    ]

    ranked_tokens = sorted(
        valid_tokens,
        key=lambda t:
            word_idf_map[f"{cntry}§{t}"],
        reverse=True
    )[:2]

    channel_c = set()

    for token in ranked_tokens:

        key = f"{cntry}§{token}"

        vals = get_word_postings(key)

        if len(vals):
            channel_c.update(
                map(int, vals)
            )

    abc = (
        exact
        |
        sorted_name
        |
        channel_c
    )

    abc_counts.append(
        len(abc)
    )

    base_hits = len(
        abc & gt
    )

    abc_edges += base_hits

    postal = set()

    p = q.get("k_p")

    if p:

        postal_key = f"{cntry}§{p}"

        vals = get_postings_dict(
            buf_postal,
            off_postal,
            postal_key
        )

        if len(vals):
            postal.update(
                map(int, vals)
            )

    merged = abc | postal

    abc_postal_counts.append(
        len(merged)
    )

    merged_hits = len(
        merged & gt
    )

    abc_postal_edges += merged_hits

    delta = merged_hits - base_hits

    if delta > 0:
        new_edges += delta
        new_queries += 1

    if (qi + 1) % 5000 == 0:
        print(
            f"Processed {qi + 1:,} / {len(SAMPLE):,}"
        )

abc_recall = (
    abc_edges
    /
    total_gt_edges
)

abc_postal_recall = (
    abc_postal_edges
    /
    total_gt_edges
)

delta_recall = (
    abc_postal_recall
    -
    abc_recall
)

mean_abc = float(
    np.mean(abc_counts)
)

mean_abc_postal = float(
    np.mean(abc_postal_counts)
)

candidate_delta = (
    mean_abc_postal
    -
    mean_abc
)

eta = (
    new_edges
    /
    candidate_delta
    if candidate_delta > 0
    else 0.0
)

print("\n" + "=" * 105)
print("STAGE E0 RESULT")
print("=" * 105)

print(
    f"GT edges                        : "
    f"{total_gt_edges:,}"
)

print(
    f"ABC recovered edges             : "
    f"{abc_edges:,}"
)

print(
    f"ABC micro recall                : "
    f"{abc_recall:.4%}"
)

print(
    f"ABC+Postal recovered edges      : "
    f"{abc_postal_edges:,}"
)

print(
    f"ABC+Postal micro recall         : "
    f"{abc_postal_recall:.4%}"
)

print(
    f"Marginal recall lift            : "
    f"{delta_recall:+.4%}"
)

print(
    f"New GT edges from Postal        : "
    f"{new_edges:,}"
)

print(
    f"Queries gaining GT edge         : "
    f"{new_queries:,}"
)

print(
    f"Mean ABC candidates             : "
    f"{mean_abc:.2f}"
)

print(
    f"Mean ABC+Postal candidates      : "
    f"{mean_abc_postal:.2f}"
)

print(
    f"Mean candidate inflation        : "
    f"{candidate_delta:+.2f}"
)

print(
    f"ABC P95                         : "
    f"{np.percentile(abc_counts, 95):.0f}"
)

print(
    f"ABC+Postal P95                  : "
    f"{np.percentile(abc_postal_counts, 95):.0f}"
)

print(
