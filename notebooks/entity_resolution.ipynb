    q_len = max(
        1,
        len(q_name)
    )

    q_tok_count = max(
        1,
        len(q_tok_list)
    )

    raw_q_addr = str(
        s1_addrs_map.get(qid, "") or ""
    ).strip()

    clean_q_addr = clean_address_string(
        raw_q_addr
    )

    q_postal = extract_postal_code(
        raw_q_addr
    )

    q_addr_toks = set(
        get_meaningful_alpha_tokens(
            raw_q_addr
        )
    )

    exact_list = (
        get_postings(
            buf_exact,
            off_exact,
            q["k_ex"]
        )
        if q.get("k_ex")
        else []
    )

    sorted_list = (
        get_postings(
            buf_sorted,
            off_sorted,
            q["k_so"]
        )
        if q.get("k_so")
        else []
    )

    exact_rank_map = {
        int(cid): r
        for r, cid in enumerate(
            exact_list,
            start=1
        )
    }

    sorted_rank_map = {
        int(cid): r
        for r, cid in enumerate(
            sorted_list,
            start=1
        )
    }

    valid_tokens = [
        t
        for t in q_toks
        if f"{q_cntry}§{t}" in word_idf_map
    ]

    ranked_tokens = sorted(
        valid_tokens,
        key=lambda t:
        word_idf_map[
            f"{q_cntry}§{t}"
        ],
        reverse=True
    )[:2]

    cand_c_evidence = defaultdict(list)

    for tok in ranked_tokens:

        key = f"{q_cntry}§{tok}"

        postings = usable_postings.get(
            key
        )

        if postings is None:
            continue

        idf = float(
            word_idf_map[key]
        )

        for cid in postings:
            cand_c_evidence[
                int(cid)
            ].append(idf)

    ka = q_keys_e1a.get(qid)
    kc = q_keys_e1c.get(qid)

    e1a_cids = set(
        int(x)
        for x in (
            usable_post_e1a.get(
                ka,
                []
            )
            if ka
            else []
        )
    )

    e1c_cids = set(
        int(x)
        for x in (
            usable_post_e1c.get(
                kc,
                []
            )
            if kc
            else []
        )
    )

    base_abc = [
        int(x)
        for x in item["combined"]
    ]

    abc_rank_map = {
        cid: r
        for r, cid in enumerate(
            base_abc,
            start=1
        )
    }

    all_candidate_cids = (
        set(base_abc)
        | e1a_cids
        | e1c_cids
    )

    def candidate_priority(cid):

        in_a = cid in exact_rank_map
        in_b = cid in sorted_rank_map
        in_e1a = cid in e1a_cids
        in_e1c = cid in e1c_cids

        if (
            (in_e1a or in_e1c)
            and
            (in_a or in_b)
        ):
            tier = 0
            sub_rank = min(
                exact_rank_map.get(
                    cid,
                    999
                ),
                sorted_rank_map.get(
                    cid,
                    999
                )
            )

        elif in_a:
            tier = 1
            sub_rank = exact_rank_map[cid]

        elif in_e1a:
            tier = 1
            sub_rank = 1

        elif in_b:
            tier = 2
            sub_rank = sorted_rank_map[cid]

        elif in_e1c:
            tier = 2
            sub_rank = 1

        else:
            tier = 3
            sub_rank = abc_rank_map.get(
                cid,
                9999
            )

        return (
            tier,
            sub_rank,
            abc_rank_map.get(
                cid,
                9999
            ),
            cid
        )

    sorted_cands = sorted(
        all_candidate_cids,
        key=candidate_priority
    )[:MAX_K]

    start_pos = len(rows)

    for rank, cid in enumerate(
