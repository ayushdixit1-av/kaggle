)

def get_alpha_tokens(s):
    if not s:
        return []
    s = s.upper()
    for ch in ",.-/#;:()\"'[]":
        s = s.replace(ch, " ")
    return [t for t in s.split() if len(t) >= 3 and not t.isdigit()]

