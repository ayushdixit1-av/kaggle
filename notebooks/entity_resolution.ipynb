# --- 5. Metric Engine: Macro F0.5, Singleton FPR, & Cardinality Breakdown ---
print("\n[5/6] Evaluating Decision Surface...")

def evaluate_sweep(k_limit, threshold):
    f05_scores = []
    precisions = []
    recalls = []
    non_singleton_f05 = []
    
    singleton_empty_hits = 0
    total_singletons = 0
    
    cardinality_f05 = {
        "0": [], "1": [], "2": [], "3": [], "4": [], "5+": []
    }

    for q_idx, qid, match_count, gt_set, start, end in query_offsets:
        q_slice = df_results[start:end]
        if k_limit < MAX_K:
            q_slice = q_slice.filter(pl.col("retrieval_rank") <= k_limit)

        pred_hits = q_slice.filter(pl.col("pred_prob") >= threshold)["cid"].to_list() if q_slice.height > 0 else []
        n_pred = len(pred_hits)
        n_gt = match_count

        if n_gt == 0:
            total_singletons += 1
            if n_pred == 0:
                singleton_empty_hits += 1
                f05_scores.append(1.0)
                cardinality_f05["0"].append(1.0)
            else:
                f05_scores.append(0.0)
                cardinality_f05["0"].append(0.0)
            continue

        tp = len(set(pred_hits) & gt_set)
        fp = n_pred - tp
        fn = n_gt - tp

        p = tp / n_pred if n_pred > 0 else 0.0
        r = tp / n_gt if n_gt > 0 else 0.0
        precisions.append(p)
        recalls.append(r)

        denom = (1.25 * tp) + (0.25 * fn) + fp
        f05 = (1.25 * tp / denom) if denom > 0 else 0.0
        f05_scores.append(f05)
        non_singleton_f05.append(f05)

        if n_gt == 1: cardinality_f05["1"].append(f05)
        elif n_gt == 2: cardinality_f05["2"].append(f05)
        elif n_gt == 3: cardinality_f05["3"].append(f05)
        elif n_gt == 4: cardinality_f05["4"].append(f05)
        else: cardinality_f05["5+"].append(f05)

    macro_f05 = float(np.mean(f05_scores))
    mean_p = float(np.mean(precisions)) if precisions else 0.0
    mean_r = float(np.mean(recalls)) if recalls else 0.0
    
    singleton_acc = (singleton_empty_hits / total_singletons) if total_singletons else 0.0
    singleton_fpr = 1.0 - singleton_acc
    non_sing_f05 = float(np.mean(non_singleton_f05)) if non_singleton_f05 else 0.0

    return {
        "K": k_limit,
        "Threshold": threshold,
        "Macro F0.5": macro_f05,
        "Precision": mean_p,
        "Recall": mean_r,
        "Non-Sing F0.5": non_sing_f05,
        "Singleton Acc": singleton_acc,
        "Singleton FPR": singleton_fpr,
        "F0.5_C1": float(np.mean(cardinality_f05["1"])) if cardinality_f05["1"] else 0.0,
        "F0.5_C2": float(np.mean(cardinality_f05["2"])) if cardinality_f05["2"] else 0.0,
        "F0.5_C3": float(np.mean(cardinality_f05["3"])) if cardinality_f05["3"] else 0.0,
        "F0.5_C4": float(np.mean(cardinality_f05["4"])) if cardinality_f05["4"] else 0.0,
        "F0.5_C5+": float(np.mean(cardinality_f05["5+"])) if cardinality_f05["5+"] else 0.0,
    }

# --- 6. Execution Sweep ---
print("\n[6/6] Sweeping K in [10, 20, 30, 50] across Thresholds in [0.20, 0.35, 0.50, 0.65, 0.75, 0.85]...")
K_CHOICES = [10, 20, 30, 50]
THRESHOLDS = [0.20, 0.35, 0.50, 0.65, 0.75, 0.85]

sweep_records = []
for k_val in K_CHOICES:
    for tau in THRESHOLDS:
        res = evaluate_sweep(k_val, tau)
        sweep_records.append(res)

eval_df = pl.DataFrame(sweep_records)

print("\n" + "=" * 140)
print("BENCHMARK 4: COMPREHENSIVE END-TO-END RESULTS")
print("=" * 140)
print(
