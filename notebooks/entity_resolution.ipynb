        label=y[train_mask],
        feature_name=FEATURE_NAMES
    )

    dval = lgb.Dataset(
        X[val_mask],
        label=y[val_mask],
        reference=dtrain,
        feature_name=FEATURE_NAMES
    )

    bst = lgb.train(
        params,
