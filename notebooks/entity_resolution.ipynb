        complete_hits.append(1.0 if hits == len(gt_set) else 0.0)

    c = np.asarray(candidate_counts)
    micro_edge_recall = (total_tp / total_gt_edges) if total_gt_edges else 0.0
    micro_retention = (compressed_hits / raw_reachable_edges) if raw_reachable_edges else 0.0

    return {
        "Policy": policy,
        "K": k,
        "Macro Recall": float(np.mean(macro_edge_recalls)) if macro_edge_recalls else 0.0,
        "Micro Recall": micro_edge_recall,
        "Micro Retention": micro_retention,
        "Any Recall": float(np.mean(any_hits)),
