import gc
import json
import pickle
import re
import time
from collections import defaultdict
from pathlib import Path

import numpy as np
import polars as pl

REPO = Path("/kaggle/working/entity_resolution_repo")
OUT = REPO / "checkpoints" / "stage4_address_sample_a"
OUT.mkdir(parents=True, exist_ok=True)

DATA_DIR = Path(
    "/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train"
)

S1_PATH = DATA_DIR / "train_source1.tsv"
S2_PATH = DATA_DIR / "train_source2.tsv"
S3_PATH = DATA_DIR / "train_source3.tsv"

assert S1_PATH.exists()
assert S2_PATH.exists()
assert S3_PATH.exists()

C_DIR = REPO / "checkpoints" / "stage4_channel_c"

with open(C_DIR / "queries_sample_a.pkl", "rb") as f:
    SAMPLE = pickle.load(f)

assert len(SAMPLE) == 20_000

if "norm_country" not in globals():
    raise RuntimeError("norm_country() is missing from the current kernel")

POSTAL_REGEX = re.compile(
    r"\b(?:[0-9]{5,6}|[A-Z][0-9][A-Z]\s?[0-9][A-Z][0-9]|[A-Z]{1,2}[0-9R][0-9A-Z]?\s?[0-9][A-Z]{2})\b",
    re.IGNORECASE
)

ADDR_STOPWORDS = {
    "ROAD", "STREET", "AVENUE", "LANE", "DRIVE", "BLVD", "SUITE", "STE",
    "FLOOR", "FL", "BLOCK", "SECTOR", "PLOT", "NEAR", "OPP", "CITY", "STATE",
    "INDIA", "USA", "UNITED", "STATES", "DIST", "NAGAR", "MARG"
}

def clean_address_string(s):
    if not s:
        return ""
    s = str(s).upper()
    for ch in ",.-/#;:()\"'[]\t\n":
        s = s.replace(ch, " ")
    return " ".join(s.split())

def extract_postal_code(s):
    if not s:
        return None
    matches = POSTAL_REGEX.findall(str(s))
    return matches[-1].upper().replace(" ", "") if matches else None

def get_meaningful_alpha_tokens(s):
    if not s:
        return []
    cleaned = clean_address_string(s)
    return [
        t
        for t in cleaned.split()
        if len(t) >= 3 and not t.isdigit() and t not in ADDR_STOPWORDS
    ]

print("=" * 105)
print("STAGE E1: BUILD SAMPLE-A ADDRESS POSTINGS")
print("=" * 105)

print("\n[1/5] Loading Sample-A Source-1 addresses...")

s1_schema = pl.read_csv(
    S1_PATH,
    separator="\t",
    n_rows=1
).columns

s1_id_col = next(
    c for c in s1_schema
    if "id" in c.lower()
)

s1_addr_col = next(
    c for c in s1_schema
    if "addr" in c.lower() or "location" in c.lower()
)

df_s1 = pl.read_csv(
    S1_PATH,
    separator="\t",
    columns=[s1_id_col, s1_addr_col]
)

s1_addrs = dict(
    zip(
        df_s1[s1_id_col].to_list(),
        df_s1[s1_addr_col].fill_null("").to_list()
    )
)

del df_s1
gc.collect()

q_keys_e1a = {}
q_keys_e1c = {}

target_e1a = set()
target_e1c = set()

for q in SAMPLE:

    qid = q["qid"]
    raw_addr = str(
        s1_addrs.get(qid, "") or ""
    ).strip()

    if not raw_addr:
        continue

    cntry = norm_country(
        q["cntry"]
    )

    clean_addr = clean_address_string(
        raw_addr
    )

    if clean_addr:
        key_a = f"{cntry}§{clean_addr}"
        q_keys_e1a[qid] = key_a
        target_e1a.add(key_a)

    postal = extract_postal_code(
        raw_addr
    )

    alpha = get_meaningful_alpha_tokens(
        raw_addr
    )

    if postal and len(alpha) >= 1:

        key_c = (
            f"{cntry}§{postal}§{alpha[0]}"
        )

        q_keys_e1c[qid] = key_c
        target_e1c.add(key_c)

print(
    f"Sample-A E1a target keys: {len(target_e1a):,}"
)

print(
    f"Sample-A E1c target keys: {len(target_e1c):,}"
)

print("\n[2/5] Streaming candidate addresses...")

N_S2 = pl.read_csv(
    S2_PATH,
    separator="\t",
    columns=["entity_id"]
).height

del s1_addrs
gc.collect()

post_e1a = defaultdict(list)
post_e1c = defaultdict(list)

MAX_E1C_POSTINGS = 1000

start_time = time.time()

for source_id, path, base_idx in [
    (2, S2_PATH, 0),
    (3, S3_PATH, N_S2)
]:

    local_idx = 0

    for chunk in pl.read_csv(
        path,
        separator="\t",
        columns=["business_address", "country"]
    ).iter_slices(
        n_rows=500_000
    ):

        addresses = chunk[
            "business_address"
        ].fill_null("").to_numpy()

        countries = chunk[
            "country"
        ].fill_null("UNK").to_numpy()

        for raw_addr, country in zip(
            addresses,
            countries
        ):

            cid = base_idx + local_idx
            local_idx += 1

            if not raw_addr:
                continue

            cntry = norm_country(
                country
            )

            clean_addr = clean_address_string(
                raw_addr
            )

            if clean_addr:

                key_a = (
                    f"{cntry}§{clean_addr}"
                )

                if key_a in target_e1a:
                    post_e1a[key_a].append(cid)

            postal = extract_postal_code(
                raw_addr
            )

            if postal:

                alpha = get_meaningful_alpha_tokens(
                    raw_addr
                )

                if len(alpha) >= 1:

                    key_c = (
                        f"{cntry}§{postal}§{alpha[0]}"
                    )

                    if key_c in target_e1c:

                        vals = post_e1c[key_c]

                        if len(vals) < MAX_E1C_POSTINGS:
                            vals.append(cid)

    print(
        f"Source {source_id} complete"
    )

print(
    f"Candidate scan time: "
    f"{time.time() - start_time:.1f}s"
)

print("\n[3/5] Flattening postings...")

def flatten_postings(d):

    keys = sorted(d.keys())

    offsets = np.zeros(
        len(keys) + 1,
        dtype=np.int64
    )

    total = 0

    for i, key in enumerate(keys):

        total += len(d[key])
        offsets[i + 1] = total

    buffer = np.empty(
        total,
        dtype=np.uint32
    )

    pos = 0

    for key in keys:

        vals = d[key]
        n = len(vals)

        if n:
            buffer[
                pos:pos+n
            ] = vals

        pos += n

    return keys, offsets, buffer

keys_a, offsets_a, buffer_a = flatten_postings(
    post_e1a
)

keys_c, offsets_c, buffer_c = flatten_postings(
    post_e1c
)

print(
    f"E1a keys: {len(keys_a):,}"
)

print(
    f"E1a postings: {len(buffer_a):,}"
)

print(
    f"E1c keys: {len(keys_c):,}"
)

print(
    f"E1c postings: {len(buffer_c):,}"
)

print("\n[4/5] Saving verified artifacts...")

np.save(
    OUT / "buf_e1a.npy",
    buffer_a,
    allow_pickle=False
)

np.save(
    OUT / "buf_e1c.npy",
    buffer_c,
    allow_pickle=False
)

with open(
    OUT / "off_e1a.pkl",
    "wb"
) as f:
    pickle.dump(
        {
            "keys": keys_a,
            "offsets": offsets_a
        },
        f,
        protocol=pickle.HIGHEST_PROTOCOL
    )

with open(
    OUT / "off_e1c.pkl",
    "wb"
) as f:
    pickle.dump(
        {
            "keys": keys_c,
            "offsets": offsets_c
        },
        f,
        protocol=pickle.HIGHEST_PROTOCOL
    )

with open(
    OUT / "q_keys_e1a.pkl",
    "wb"
) as f:
    pickle.dump(
        q_keys_e1a,
        f,
        protocol=pickle.HIGHEST_PROTOCOL
    )

with open(
    OUT / "q_keys_e1c.pkl",
    "wb"
) as f:
    pickle.dump(
        q_keys_e1c,
        f,
        protocol=pickle.HIGHEST_PROTOCOL
    )

manifest = {
    "stage": "stage4_address_sample_a",
    "status": "verified",
    "sample_queries": len(SAMPLE),
    "target_e1a_keys": len(target_e1a),
    "target_e1c_keys": len(target_e1c),
    "e1a_keys": len(keys_a),
    "e1a_postings": int(len(buffer_a)),
    "e1c_keys": len(keys_c),
    "e1c_postings": int(len(buffer_c)),
    "e1c_posting_cap": MAX_E1C_POSTINGS,
    "n_s2": int(N_S2),
    "n_s3": int(pl.read_csv(
        S3_PATH,
        separator="\t",
        columns=["entity_id"]
    ).height)
}

(OUT / "manifest.json").write_text(
    json.dumps(
        manifest,
        indent=2
    )
)

print("\n[5/5] Reopening artifacts...")

buf_a_check = np.load(
    OUT / "buf_e1a.npy",
    mmap_mode="r"
)

buf_c_check = np.load(
    OUT / "buf_e1c.npy",
    mmap_mode="r"
)

with open(
    OUT / "off_e1a.pkl",
    "rb"
) as f:
    off_a_check = pickle.load(f)

with open(
    OUT / "off_e1c.pkl",
    "rb"
) as f:
    off_c_check = pickle.load(f)

assert buf_a_check.dtype == np.uint32
assert buf_c_check.dtype == np.uint32

assert len(off_a_check["keys"]) + 1 == len(
