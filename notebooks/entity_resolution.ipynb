        jaccard = (n_shared / len(union_toks)) if union_toks else 0.0
        containment = 1.0 if (q_toks and (q_toks.issubset(c_toks) or c_toks.issubset(q_toks))) else 0.0
        set_equal = 1.0 if q_toks == c_toks and q_toks else 0.0
        
        jw = jaro_winkler_safe(q_name, c_name)
        lev = levenshtein_ratio(q_name, c_name)
        tri = char_trigram_jaccard(q_name, c_name)
        is_exact_name = 1.0 if q_name == c_name else 0.0

        first_match = 1.0 if (q_tok_list and c_tok_list and q_tok_list[0] == c_tok_list[0]) else 0.0
        last_match = 1.0 if (q_tok_list and c_tok_list and q_tok_list[-1] == c_tok_list[-1]) else 0.0

        label = 1 if cid in gt_set else 0

        row = [
            q_idx,
            cid,
            label,
            # Provenance
            float(rank),
            1.0 if in_a else 0.0,
            1.0 if in_b else 0.0,
            1.0 if in_c else 0.0,
            r_a,
            r_b,
            1.0 if (in_a and in_b) else 0.0,
            1.0 if (in_a and in_c) else 0.0,
            1.0 if (in_b and in_c) else 0.0,
            1.0 if (in_a and in_b and in_c) else 0.0,
            # Channel C Signals
            c_overlap_cnt,
            c_idf_sum,
            c_max_idf,
            c_coverage,
            # String Features
            jw,
            lev,
            tri,
            is_exact_name,
            # Token Features
            jaccard,
            containment,
            set_equal,
            float(n_shared),
            first_match,
            last_match,
            float(q_tok_count),
            float(c_tok_count),
            float(abs(q_tok_count - c_tok_count)),
            float(abs(q_len - c_len) / max(q_len, c_len)),
            # Metadata
            1.0 if (q_cntry == norm_country(c_cntry)) and q_cntry != "UNK" else 0.0,
            1.0 if src == 2 else 0.0
        ]
        rows.append(row)

    end_pos = len(rows)
