from pathlib import Path
import json
import pickle
import shutil
import subprocess
import sys
import time
import numpy as np
import pandas as pd

REPO = Path("/kaggle/working/entity_resolution_repo")
CKPT = REPO / "checkpoints"
CKPT.mkdir(parents=True, exist_ok=True)

def checkpoint_path(name):
    return CKPT / name

def save_pickle(name, obj):
    path = checkpoint_path(name)
    with open(path, "wb") as f:
        pickle.dump(obj, f, protocol=pickle.HIGHEST_PROTOCOL)
    return path

def load_pickle(name):
    with open(checkpoint_path(name), "rb") as f:
        return pickle.load(f)

def save_json(name, obj):
    path = checkpoint_path(name)
    path.write_text(json.dumps(obj, indent=2, default=str))
    return path

def save_array(name, arr):
    path = checkpoint_path(name)
    np.save(path, arr, allow_pickle=False)
    return path

def save_dataframe(name, df):
    path = checkpoint_path(name)
    df.to_parquet(path, index=False)
    return path

def save_text(name, text_value):
    path = checkpoint_path(name)
    path.write_text(str(text_value))
    return path

def save_state(name, obj):
    if isinstance(obj, pd.DataFrame):
        return save_dataframe(f"{name}.parquet", obj)
    if isinstance(obj, np.ndarray):
        return save_array(f"{name}.npy", obj)
    if isinstance(obj, (dict, list, tuple, set)):
        return save_pickle(f"{name}.pkl", obj)
    if isinstance(obj, (str, int, float, bool, type(None))):
        return save_json(f"{name}.json", obj)
    return save_pickle(f"{name}.pkl", obj)

def inspect_state(names):
    rows = []
    for name in names:
        if name not in globals():
            rows.append({"name": name, "present": False, "type": None})
            continue
        obj = globals()[name]
        rows.append({
            "name": name,
            "present": True,
            "type": type(obj).__name__,
            "size": getattr(obj, "shape", None),
        })
    return pd.DataFrame(rows)

def checkpoint(names, stage):
    stage_dir = CKPT / stage
    stage_dir.mkdir(parents=True, exist_ok=True)
    manifest = {
        "stage": stage,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "python": sys.version,
        "files": {}
    }

    for name in names:
        if name not in globals():
            continue
        obj = globals()[name]
        old = CKPT
        globals()["CKPT"] = stage_dir
        try:
            path = save_state(name, obj)
            manifest["files"][name] = {
                "path": str(path.relative_to(REPO)),
                "type": type(obj).__name__
            }
        finally:
            globals()["CKPT"] = old

    save_json(f"{stage}/manifest.json", manifest)
    return manifest

def restore_stage(stage):
    stage_dir = CKPT / stage
    manifest_path = stage_dir / "manifest.json"
    if not manifest_path.exists():
        raise FileNotFoundError(manifest_path)

    manifest = json.loads(manifest_path.read_text())

    for name, meta in manifest["files"].items():
        path = REPO / meta["path"]
        suffix = path.suffix.lower()

        if suffix == ".parquet":
            globals()[name] = pd.read_parquet(path)
        elif suffix == ".npy":
            globals()[name] = np.load(path, allow_pickle=False)
        elif suffix == ".json":
            globals()[name] = json.loads(path.read_text())
        elif suffix == ".pkl":
            with open(path, "rb") as f:
                globals()[name] = pickle.load(f)

    return manifest

print("CHECKPOINT SYSTEM READY")
print("Repository:", REPO)
print("Checkpoint root:", CKPT)


src = REPO / "src" / "checkpoint.py"

src.write_text(
