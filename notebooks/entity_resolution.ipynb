    q_len = max(1, len(q_name))
    q_tok_count = max(1, len(q_tok_list))

    raw_q_addr = s1_addrs_map.get(qid, "").strip()
    clean_q_addr = clean_address_string(raw_q_addr)
    q_postal = extract_postal_code(raw_q_addr)
    q_addr_toks = set(get_meaningful_alpha_tokens(raw_q_addr))

    exact_list = get_postings(buf_exact, off_exact, q["k_ex"]) if q.get("k_ex") else []
    sorted_list = get_postings(buf_sorted, off_sorted, q["k_so"]) if q.get("k_so") else []
    exact_rank_map = {cid: r for r, cid in enumerate(exact_list, start=1)}
    sorted_rank_map = {cid: r for r, cid in enumerate(sorted_list, start=1)}

    valid_tokens = [t for t in q_toks if f"{q_cntry}§{t}" in word_idf_map]
    ranked_tokens = sorted(valid_tokens, key=lambda t: word_idf_map[f"{q_cntry}§{t}"], reverse=True)[:2]
    cand_c_evidence = defaultdict(list)
    for tok in ranked_tokens:
        key = f"{q_cntry}§{tok}"
        p = usable_postings.get(key)
        if p is not None:
            idf = word_idf_map[key]
            for cid in p:
                cand_c_evidence[int(cid)].append(idf)

    ka = q_keys_e1a_b.get(qid)
    kc = q_keys_e1c_b.get(qid)
    e1a_cids = set(usable_post_e1a_b.get(ka, [])) if ka else set()
    e1c_cids = set(usable_post_e1c_b.get(kc, [])) if kc else set()

    base_abc = list(item["combined"])
    abc_rank_map = {cid: r for r, cid in enumerate(base_abc, start=1)}
    all_candidate_cids = set(base_abc) | e1a_cids | e1c_cids

    def candidate_priority(cid):
        in_a = cid in exact_rank_map
        in_b = cid in sorted_rank_map
        in_e1a = cid in e1a_cids
        in_e1c = cid in e1c_cids
        
        if (in_e1a or in_e1c) and (in_a or in_b):
            tier = 0
            sub_rank = min(exact_rank_map.get(cid, 999), sorted_rank_map.get(cid, 999))
        elif in_a:
            tier = 1
            sub_rank = exact_rank_map[cid]
        elif in_e1a:
            tier = 1
            sub_rank = 1
        elif in_b:
            tier = 2
            sub_rank = sorted_rank_map[cid]
        elif in_e1c:
            tier = 2
            sub_rank = 1
        else:
            tier = 3
            sub_rank = abc_rank_map.get(cid, 9999)
            
        return (tier, sub_rank, abc_rank_map.get(cid, 9999), cid)

    sorted_cands = sorted(all_candidate_cids, key=candidate_priority)[:MAX_K]
    start_pos = len(rows)

    for rank, cid in enumerate(sorted_cands, start=1):
        c_raw_name, c_raw_addr, c_cntry, src = get_cand_full(cid)
        c_tok_list = canonical_tokens(c_raw_name)
        c_name = " ".join(c_tok_list)
        c_toks = set(c_tok_list)
        c_len = max(1, len(c_name))
        c_tok_count = len(c_tok_list)

        in_a = cid in exact_rank_map
        in_b = cid in sorted_rank_map
        c_idfs = cand_c_evidence.get(cid)
        in_c = c_idfs is not None
        in_e1a = cid in e1a_cids
        in_e1c = cid in e1c_cids

        r_a = float(exact_rank_map.get(cid, 0))
        r_b = float(sorted_rank_map.get(cid, 0))

        c_overlap_cnt = float(len(c_idfs)) if in_c else 0.0
        c_idf_sum = float(sum(c_idfs)) if in_c else 0.0
        c_max_idf = float(max(c_idfs)) if in_c else 0.0
        c_coverage = (c_overlap_cnt / q_tok_count) if in_c else 0.0

        shared_toks = q_toks & c_toks
        n_shared = len(shared_toks)
        union_toks = q_toks | c_toks
        jaccard = (n_shared / len(union_toks)) if union_toks else 0.0
        containment = 1.0 if (q_toks and (q_toks.issubset(c_toks) or c_toks.issubset(q_toks))) else 0.0
        set_equal = 1.0 if q_toks == c_toks and q_toks else 0.0
        
        jw = jaro_winkler_safe(q_name, c_name)
        lev = levenshtein_ratio(q_name, c_name)
        tri = char_trigram_jaccard(q_name, c_name)
        is_exact_name = 1.0 if q_name == c_name else 0.0

        first_match = 1.0 if (q_tok_list and c_tok_list and q_tok_list[0] == c_tok_list[0]) else 0.0
        last_match = 1.0 if (q_tok_list and c_tok_list and q_tok_list[-1] == c_tok_list[-1]) else 0.0

        clean_c_addr = clean_address_string(c_raw_addr)
        c_postal = extract_postal_code(c_raw_addr)
        c_addr_toks = set(get_meaningful_alpha_tokens(c_raw_addr))
        
        addr_exact = 1.0 if (clean_q_addr and clean_c_addr and clean_q_addr == clean_c_addr) else 0.0
        post_match = 1.0 if (q_postal and c_postal and q_postal == c_postal) else 0.0
        
        shared_addr = q_addr_toks & c_addr_toks
        union_addr = q_addr_toks | c_addr_toks
        addr_jaccard = (len(shared_addr) / len(union_addr)) if union_addr else 0.0

        label = 1 if cid in gt_set else 0

        # Construct dictionary per candidate to guarantee schema correctness
        feat_dict = {
            "q_idx": q_idx,
            "cid": cid,
            "label": label,
            "retrieval_rank": float(rank),
            "retrieved_by_A": 1.0 if in_a else 0.0,
            "retrieved_by_B": 1.0 if in_b else 0.0,
            "retrieved_by_C": 1.0 if in_c else 0.0,
            "retrieved_by_E_exact": 1.0 if in_e1a else 0.0,
            "retrieved_by_E_comp": 1.0 if in_e1c else 0.0,
            "A_rank": r_a,
            "B_rank": r_b,
            "A_and_B": 1.0 if (in_a and in_b) else 0.0,
            "A_and_C": 1.0 if (in_a and in_c) else 0.0,
            "B_and_C": 1.0 if (in_b and in_c) else 0.0,
            "E_and_name_consensus": 1.0 if ((in_e1a or in_e1c) and (in_a or in_b)) else 0.0,
            "c_overlap_count": c_overlap_cnt,
            "c_idf_sum": c_idf_sum,
            "c_max_idf": c_max_idf,
            "c_token_coverage": c_coverage,
            "name_jw": jw,
            "lev_ratio": lev,
            "char_tri_jaccard": tri,
            "exact_name": is_exact_name,
            "token_jaccard": jaccard,
            "token_containment": containment,
            "token_set_equal": set_equal,
            "shared_token_count": float(n_shared),
            "first_tok_match": first_match,
            "last_tok_match": last_match,
            "q_tok_len": float(q_tok_count),
            "c_tok_len": float(c_tok_count),
            "tok_len_diff": float(abs(q_tok_count - c_tok_count)),
            "char_len_diff_ratio": float(abs(q_len - c_len) / max(q_len, c_len)),
            "address_exact_match": addr_exact,
            "postal_match": post_match,
            "addr_token_jaccard": addr_jaccard,
            "shared_addr_tokens": float(len(shared_addr)),
            "country_match": 1.0 if (q_cntry == norm_country(c_cntry)) and q_cntry != "UNK" else 0.0,
            "is_s2": 1.0 if src == 2 else 0.0
        }
        rows.append(feat_dict)

    end_pos = len(rows)
    query_offsets_b.append((q_idx, qid, len(gt_set), gt_set, start_pos, end_pos))

assert len(query_offsets_b) == N_QUERIES_B, (
    f"Expected {N_QUERIES_B} queries, got {len(query_offsets_b)}"
)

df_features_b = pl.DataFrame(rows)
del rows
gc.collect()

feature_names = [c for c in df_features_b.columns if c not in ["q_idx", "cid", "label"]]
print(f"Sample B Matrix ready in {time.time() - FEAT_START:.1f}s | Rows: {df_features_b.height:,} | Features: {len(feature_names)}")
log_telemetry("Sample B Features ready")

# --- 6. Zero-Shot Out-of-Sample Inference via Frozen Models from Sample A ---
print("\n[5/7] Executing Zero-Shot Ensemble Inference using Frozen Sample A Models...")
INF_START = time.time()
X_b = df_features_b.select(feature_names).to_numpy()

# Verify that the 5-fold models from Benchmark 6 Treatment are resident in memory
assert "treatment_models_a" in globals(), "Error: 'treatment_models_a' not found. Save the 5 models from Benchmark 6."
assert "treatment_best_iters_a" in globals(), "Error: 'treatment_best_iters_a' not found."
assert len(treatment_models_a) == 5, f"Expected 5 models, found {len(treatment_models_a)}"

raw_preds = np.zeros((5, len(df_features_b)), dtype=np.float32)
for fold_idx, (bst, best_it) in enumerate(zip(treatment_models_a, treatment_best_iters_a)):
    raw_preds[fold_idx] = bst.predict(X_b, num_iteration=best_it)

# Average probabilities across the 5 frozen models
ensemble_prob_b = np.mean(raw_preds, axis=0)
print(f"Ensemble inference across {len(df_features_b):,} candidates finished in {time.time() - INF_START:.2f}s")

# --- 7. Vectorized Metric Engine on Sample B ---
print("\n[6/7] Evaluating Locked Operating Points on Sample B...")
v_q_idx = df_features_b["q_idx"].to_numpy().astype(np.int32)
v_label = df_features_b["label"].to_numpy().astype(np.int8)
v_prob  = ensemble_prob_b
v_rank  = df_features_b["retrieval_rank"].to_numpy().astype(np.int16)

query_n_gt = np.zeros(N_QUERIES_B, dtype=np.int32)
for q_idx, qid, match_count, _, _, _ in query_offsets_b:
    query_n_gt[q_idx] = match_count

is_singleton_mask = (query_n_gt == 0)
is_non_singleton_mask = ~is_singleton_mask
n_singletons = np.count_nonzero(is_singleton_mask)

def evaluate_locked_cell(k_limit, threshold):
    active = (v_rank <= k_limit) & (v_prob >= threshold)
    n_pred_per_q = np.bincount(v_q_idx[active], minlength=N_QUERIES_B)
    tp_per_q = np.bincount(v_q_idx[active & (v_label == 1)], minlength=N_QUERIES_B)
    
    singleton_hits = (n_pred_per_q[is_singleton_mask] == 0)
    singleton_acc = float(np.mean(singleton_hits)) if n_singletons > 0 else 1.0
    singleton_fpr = 1.0 - singleton_acc
    
    tp_ns = tp_per_q[is_non_singleton_mask]
    n_pred_ns = n_pred_per_q[is_non_singleton_mask]
    n_gt_ns = query_n_gt[is_non_singleton_mask]
    
    fp_ns = n_pred_ns - tp_ns
    fn_ns = n_gt_ns - tp_ns
    
    denom = (1.25 * tp_ns) + (0.25 * fn_ns) + fp_ns
    f05_ns = np.zeros_like(denom, dtype=np.float64)
    valid_denom = denom > 0
    f05_ns[valid_denom] = (1.25 * tp_ns[valid_denom]) / denom[valid_denom]
    
    all_f05 = np.empty(N_QUERIES_B, dtype=np.float64)
    all_f05[is_singleton_mask] = singleton_hits.astype(np.float64)
    all_f05[is_non_singleton_mask] = f05_ns
    
    p_denom = np.maximum(1, n_pred_ns)
    precisions = np.where(n_pred_ns > 0, tp_ns / p_denom, 0.0)
    recalls = tp_ns / n_gt_ns
    
    return {
        "K": k_limit,
        "Threshold": threshold,
        "Macro F0.5 (Sample B)": float(np.mean(all_f05)),
        "Precision": float(np.mean(precisions)),
        "Recall": float(np.mean(recalls)),
        "Non-Sing F0.5": float(np.mean(f05_ns)),
        "Singleton Acc": singleton_acc,
        "Singleton FPR": singleton_fpr
    }

# --- 8. Locked Evaluation Reports ---
print("\n" + "=" * 130)
print("BENCHMARK 7: ZERO-SHOT GENERALIZATION (SAMPLE B ON FROZEN SAMPLE A MODELS)")
print("=" * 130)

locked_cells = [
    (30, 0.50, "Conservative (Low-Latency / High Information Density)"),
    (50, 0.50, "Balanced Budget (Recommended Competition Target)"),
    (100, 0.50, "Ceiling Budget (Maximum Recall Extraction)")
]

report_rows = []
for k_val, tau, desc in locked_cells:
    res = evaluate_locked_cell(k_val, tau)
    res["Target Description"] = desc
    report_rows.append(res)

print(
    pl.DataFrame(report_rows).select([
        "Target Description", "K", "Threshold", "Macro F0.5 (Sample B)", 
        "Precision", "Recall", "Singleton Acc", "Singleton FPR"
    ])
)

# Reference Grid Pivot (Zero tuning, reporting standard operating grid)
grid_sweep = []
for k_val in [20, 30, 50, 75, 100]:
    for tau in [0.20, 0.35, 0.50, 0.65]:
        grid_sweep.append(evaluate_locked_cell(k_val, tau))

eval_grid_b = pl.DataFrame(grid_sweep)
print("\n--- SAMPLE B REFERENCE PIVOT TABLE (Macro F0.5) ---")
print(eval_grid_b.pivot(values="Macro F0.5 (Sample B)", index="Threshold", on="K").sort("Threshold"))

print("\n" + "=" * 115)
print(f"BENCHMARK 7 COMPLETE | Total Runtime: {time.time() - START_TIME:.1f}s | Peak RAM: {get_peak_ram_mb():,.0f} MB")
print("=" * 115)


