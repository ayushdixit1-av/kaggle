        "P95": int(np.percentile(c, 95)),
        "P99": int(np.percentile(c, 99)),
        "% >25": float(np.mean(c > 25)),
        "% >50": float(np.mean(c > 50)),
        "% >100": float(np.mean(c > 100)),
        "% >200": float(np.mean(c > 200)),
    }

