import polars as pl
import numpy as np
from collections import Counter, defaultdict
import re
import gc
import resource
import time
from pathlib import Path

START_TIME = time.time()

def get_peak_ram_mb():
    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0

def log_telemetry(step):
    gc.collect()
    print(f"[RAM] {step:<52} {get_peak_ram_mb():,.0f} MB")

print("=" * 110)
print("STAGE E1: CHANNEL E MARGINAL RECALL & TRUE UNION INFLATION AUDIT")
print("=" * 110)

DATA_DIR = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train")
SAMPLE = queries_sample_a
N_QUERIES = len(SAMPLE)
CHUNK_SIZE = 500_000

# --- 1. Address Normalization & Extraction Utilities ---
POSTAL_REGEX = re.compile(
    r'\b(?:[0-9]{5,6}|[A-Z][0-9][A-Z]\s?[0-9][A-Z][0-9]|[A-Z]{1,2}[0-9R][0-9A-Z]?\s?[0-9][A-Z]{2})\b', 
    re.IGNORECASE
)

ADDR_STOPWORDS = {
    "ROAD", "STREET", "AVENUE", "LANE", "DRIVE", "BLVD", "SUITE", "STE", 
    "FLOOR", "FL", "BLOCK", "SECTOR", "PLOT", "NEAR", "OPP", "CITY", "STATE",
    "INDIA", "USA", "UNITED", "STATES", "DIST", "NAGAR", "MARG"
}

def clean_address_string(s):
    if not s:
        return ""
    s = str(s).upper()
    for ch in ",.-/#;:()\"'[]\t\n":
        s = s.replace(ch, " ")
    return " ".join(s.split())

def extract_postal_code(s):
    if not s:
        return None
    matches = POSTAL_REGEX.findall(str(s))
    return matches[-1].upper().replace(" ", "") if matches else None

def get_meaningful_alpha_tokens(s):
    if not s:
        return []
    cleaned = clean_address_string(s)
    return [t for t in cleaned.split() if len(t) >= 3 and not t.isdigit() and t not in ADDR_STOPWORDS]

# --- 2. Load Raw Source 1 Schema & Query Addresses ---
print("\n[1/5] Loading Raw Source 1 Schema & Query Addresses...")
s1_tsv = DATA_DIR / "train_source1.tsv"
s1_path = s1_tsv if s1_tsv.exists() else DATA_DIR / "train_source1.csv"
sep = "\t" if s1_tsv.exists() else ","

s1_schema = pl.read_csv(s1_path, separator=sep, n_rows=1).columns
s1_addr_col = next(c for c in s1_schema if "addr" in c.lower() or "location" in c.lower())
s1_id_col = next(c for c in s1_schema if "id" in c.lower())

df_s1_full = pl.read_csv(s1_path, separator=sep, columns=[s1_id_col, s1_addr_col])
s1_addrs_map = dict(zip(
    df_s1_full[s1_id_col].to_list(),
    df_s1_full[s1_addr_col].fill_null("").to_list()
))
del df_s1_full
gc.collect()
print(f"Loaded {len(s1_addrs_map):,} Source 1 addresses from column: '{s1_addr_col}'.")

# --- 3. Build Query Target Key Maps for E1a - E1d ---
print("\n[2/5] Building Query Address Key Sets (Sample A Scope)...")
q_keys_e1a = {}  # Exact
q_keys_e1b = {}  # Country § Postal
q_keys_e1c = {}  # Country § Postal § W1
q_keys_e1d = {}  # Country § Postal § W1 § W2

target_keys_e1a = set()
target_keys_e1b = set()
target_keys_e1c = set()
target_keys_e1d = set()

q_addr_present_count = 0

for q in SAMPLE:
    qid = q["qid"]
    raw_addr = s1_addrs_map.get(qid, "").strip()
    cntry = norm_country(q["cntry"])
    
    if not raw_addr:
        continue
    q_addr_present_count += 1
    
    clean_addr = clean_address_string(raw_addr)
    postal = extract_postal_code(raw_addr)
    alpha_toks = get_meaningful_alpha_tokens(raw_addr)
    
    # E1a: Exact Normalized Address
    if clean_addr:
        k_a = f"{cntry}§{clean_addr}"
        q_keys_e1a[qid] = k_a
        target_keys_e1a.add(k_a)
        
    # Compound Postal Keys
    if postal:
        k_b = f"{cntry}§{postal}"
        q_keys_e1b[qid] = k_b
        target_keys_e1b.add(k_b)
        
        if len(alpha_toks) >= 1:
            k_c = f"{cntry}§{postal}§{alpha_toks[0]}"
            q_keys_e1c[qid] = k_c
            target_keys_e1c.add(k_c)
            
        if len(alpha_toks) >= 2:
            k_d = f"{cntry}§{postal}§{alpha_toks[0]}§{alpha_toks[1]}"
            q_keys_e1d[qid] = k_d
            target_keys_e1d.add(k_d)

print(f"Sample A Queries with Non-Empty Address: {q_addr_present_count:,} / {N_QUERIES:,} ({q_addr_present_count/N_QUERIES:.2%})")
print(f"Target Keys -> E1a: {len(target_keys_e1a):,} | E1b: {len(target_keys_e1b):,} | E1c: {len(target_keys_e1c):,} | E1d: {len(target_keys_e1d):,}")

# --- 4. Materialize Postings for S2 and S3 (10.3M Stream) ---
print("\n[3/5] Streaming 10.3M Candidate Addresses to Materialize Postings...")
postings_e1a = defaultdict(list)
postings_e1b = defaultdict(list)
postings_e1c = defaultdict(list)
postings_e1d = defaultdict(list)

MAX_POSTAL_CAP = 1000

df_s2_len = pl.read_csv(DATA_DIR / "train_source2.tsv", separator="\t", columns=["business_address"]).height

for source_id in (2, 3):
    f_path = DATA_DIR / f"train_source{source_id}.tsv"
    base_idx = 0 if source_id == 2 else df_s2_len
    local_offset = 0
    
    for slice_df in pl.read_csv(f_path, separator="\t", columns=["business_address", "country"]).iter_slices(n_rows=CHUNK_SIZE):
        addrs = slice_df["business_address"].fill_null("").to_numpy()
        cntrys = slice_df["country"].fill_null("UNK").to_numpy()
        
        for raw_addr, country in zip(addrs, cntrys):
            cid = base_idx + local_offset
            local_offset += 1
            
            if not raw_addr:
                continue
                
            cntry = norm_country(country)
            clean_addr = clean_address_string(raw_addr)
            postal = extract_postal_code(raw_addr)
            alpha_toks = get_meaningful_alpha_tokens(raw_addr)
            
            if clean_addr:
                ka = f"{cntry}§{clean_addr}"
                if ka in target_keys_e1a:
                    postings_e1a[ka].append(cid)
                    
            if postal:
                kb = f"{cntry}§{postal}"
                if kb in target_keys_e1b:
                    p = postings_e1b[kb]
                    if len(p) < MAX_POSTAL_CAP:
                        p.append(cid)
                        
                if len(alpha_toks) >= 1:
                    kc = f"{cntry}§{postal}§{alpha_toks[0]}"
                    if kc in target_keys_e1c:
                        p = postings_e1c[kc]
                        if len(p) < MAX_POSTAL_CAP:
                            p.append(cid)
                            
                if len(alpha_toks) >= 2:
                    kd = f"{cntry}§{postal}§{alpha_toks[0]}§{alpha_toks[1]}"
                    if kd in target_keys_e1d:
                        p = postings_e1d[kd]
                        if len(p) < MAX_POSTAL_CAP:
                            p.append(cid)

usable_post_e1a = {k: np.asarray(v, dtype=np.uint32) for k, v in postings_e1a.items() if len(v) > 0}
usable_post_e1b = {k: np.asarray(v, dtype=np.uint32) for k, v in postings_e1b.items() if len(v) > 0}
usable_post_e1c = {k: np.asarray(v, dtype=np.uint32) for k, v in postings_e1c.items() if len(v) > 0}
usable_post_e1d = {k: np.asarray(v, dtype=np.uint32) for k, v in postings_e1d.items() if len(v) > 0}

del postings_e1a, postings_e1b, postings_e1c, postings_e1d
gc.collect()
log_telemetry("Postings ready")

# --- 5. True Union Benchmarking ---
print("\n[4/5] Profiling Marginal Recovery and Net Candidate Inflation...")
payload_by_qid = {p["qid"]: p for p in query_payloads}

channel_pools = [
    "E1a (Exact)", 
    "E1b (Country+Postal)", 
    "E1c (Country+Postal+W1)", 
    "E1d (Country+Postal+W1+W2)", 
    "E1_Composite (Exact+E1c)"
]

# GT Hits
hits_total = defaultdict(int)
new_hits_total = defaultdict(int)
any_match_queries = defaultdict(int)
union_any_queries = defaultdict(int)

# Candidate Distributions
union_cands_all = defaultdict(list)
added_cands_all = defaultdict(list)

union_cands_sing = defaultdict(list)
added_cands_sing = defaultdict(list)

# Baseline Accumulators
total_gt_edges = 0
total_matched_queries = 0
abc_hits_total = 0
abc_any_match_queries = 0

abc_cands_all = []
abc_cands_sing = []

for q in SAMPLE:
    qid = q["qid"]
    item = payload_by_qid.get(qid)
    if not item:
        continue
        
    gt_set = item["gt_set"]
    n_gt = len(gt_set)
    is_singleton = (n_gt == 0)
    
    if not is_singleton:
        total_gt_edges += n_gt
        total_matched_queries += 1

    abc_pool = set(item["combined"])
    len_abc = len(abc_pool)
    abc_cands_all.append(len_abc)
    
    if is_singleton:
        abc_cands_sing.append(len_abc)
    else:
        abc_hits = abc_pool & gt_set
        abc_hits_total += len(abc_hits)
        if len(abc_hits) > 0:
            abc_any_match_queries += 1

    # Extract Candidates for Each Variant
    pool_dict = {}
    
    ka = q_keys_e1a.get(qid)
    pool_dict["E1a (Exact)"] = set(usable_post_e1a.get(ka, [])) if ka else set()
    
    kb = q_keys_e1b.get(qid)
    pool_dict["E1b (Country+Postal)"] = set(usable_post_e1b.get(kb, [])) if kb else set()
    
    kc = q_keys_e1c.get(qid)
    pool_dict["E1c (Country+Postal+W1)"] = set(usable_post_e1c.get(kc, [])) if kc else set()
    
    kd = q_keys_e1d.get(qid)
    pool_dict["E1d (Country+Postal+W1+W2)"] = set(usable_post_e1d.get(kd, [])) if kd else set()
    
    pool_dict["E1_Composite (Exact+E1c)"] = pool_dict["E1a (Exact)"] | pool_dict["E1c (Country+Postal+W1)"]
    
    # Evaluate Each Channel Union
    for cname in channel_pools:
        e_pool = pool_dict[cname]
        union_pool = abc_pool | e_pool
        net_added = len(union_pool) - len_abc
        
        union_cands_all[cname].append(len(union_pool))
        added_cands_all[cname].append(net_added)
        
        if is_singleton:
            union_cands_sing[cname].append(len(union_pool))
            added_cands_sing[cname].append(net_added)
        else:
            e_hits = e_pool & gt_set
            hits_total[cname] += len(e_hits)
            
            # Decisive Metric: New Edges Outside ABC
            new_edges = e_hits - abc_pool
            new_hits_total[cname] += len(new_edges)
            
            if len(e_hits) > 0:
                any_match_queries[cname] += 1
            if len(union_pool & gt_set) > 0:
                union_any_queries[cname] += 1

