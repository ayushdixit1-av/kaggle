# Stage 8: Execution Over Representative (Sample A) and Stress (Sample B)
# -------------------------------------------------------------------------
print(f"\n[Stage 4/7] Evaluating Retrieval Strategy Matrix | Peak RSS: {get_peak_ram_mb():.2f} MB")

STRATEGIES = [
    ("A: Exact Name", "A"),
    ("B: Token-Sorted Name Alone", "B"),
    ("PH: Syntactic Anchor Alone", "PH"),
    ("P: Postal Alone (Diagnostic)", "P"),
    ("Union: A + B", "A+B"),
    ("Union: A + B + PH", "A+B+PH"),
    ("Union: A + B + PH + Postal", "A+B+PH+P_DIAG")
]

eval_a_results = []
for label, tag in STRATEGIES:
    t0 = time.time()
    res = run_evaluation(queries_sample_a, tag)
    res["Label"] = label
    res["Latency_ms"] = round((time.time() - t0) * 1000 / len(queries_sample_a), 3)
    eval_a_results.append(res)

eval_b_results = []
for label, tag in STRATEGIES:
    res = run_evaluation(queries_sample_b, tag)
    res["Label"] = label
    eval_b_results.append(res)

# -------------------------------------------------------------------------
# Stage 9: Marginal Channel Gains & Lexical-Baseline Exclusivity
# -------------------------------------------------------------------------
print(f"\n[Stage 5/7] Computing Marginal Gains & Channel Venn Overlaps...")

exclusive_hits = {"A_only": 0, "B_only": 0, "PH_only_vs_names": 0, "P_only_vs_names": 0}
overlap_hits = {"A_and_B": 0, "A_and_PH": 0, "B_and_PH": 0, "A_and_B_and_PH": 0}
total_pos_edges_sample_a = sum(len(q["gt_set"]) for q in queries_sample_a if q["match_count"] > 0)

for q in queries_sample_a:
    if q["match_count"] == 0:
        continue
    gt = q["gt_set"]
    
    hits_a = set(get_postings(buf_exact, off_exact, q["k_ex"])) & gt if q["k_ex"] else set()
    hits_b = set(get_postings(buf_sorted, off_sorted, q["k_so"])) & gt if q["k_so"] else set()
    hits_ph = set(get_postings(buf_anchor, off_anchor, q["k_ph"])) & gt if q["k_ph"] else set()
    hits_p = set(get_postings(buf_postal, off_postal, q["k_p"])) & gt if q["k_p"] else set()
    
    # Exclusivity: PH evaluated strictly against the lexical name baseline (A | B)
    exclusive_hits["A_only"] += len(hits_a - (hits_b | hits_ph))
    exclusive_hits["B_only"] += len(hits_b - (hits_a | hits_ph))
    exclusive_hits["PH_only_vs_names"] += len(hits_ph - (hits_a | hits_b))
    exclusive_hits["P_only_vs_names"] += len(hits_p - (hits_a | hits_b))
    
    overlap_hits["A_and_B"] += len(hits_a & hits_b)
    overlap_hits["A_and_PH"] += len(hits_a & hits_ph)
    overlap_hits["B_and_PH"] += len(hits_b & hits_ph)
    overlap_hits["A_and_B_and_PH"] += len(hits_a & hits_b & hits_ph)

marginal_chain = [
    ("Base: A", eval_a_results[0]),
    ("Step 1: + B", eval_a_results[4]),
    ("Step 2: + PH", eval_a_results[5]),
    ("Step 3: + Postal", eval_a_results[6])
]

marginal_rows = []
for i in range(len(marginal_chain)):
    curr_label, curr = marginal_chain[i]
    if i == 0:
        marginal_rows.append({
            "Cumulative Strategy": curr_label,
            "Edge Recall": f"{curr['Mean_Query_Edge_Recall']:.2%}",
            "Delta Recall": "---",
            "Mean Cands": f"{curr['Mean_Cand']:.1f}",
            "Delta Cands": "---",
            "Positive Micro Precision": f"{curr['Positive_Micro_Cand_Precision']:.2%}",
            "Overall F0.5 Bound": f"{curr['Overall_F05_Upper_Bound']:.4f}"
        })
    else:
        prev_label, prev = marginal_chain[i - 1]
        d_rec = curr['Mean_Query_Edge_Recall'] - prev['Mean_Query_Edge_Recall']
        d_cand = curr['Mean_Cand'] - prev['Mean_Cand']
        marginal_rows.append({
            "Cumulative Strategy": curr_label,
            "Edge Recall": f"{curr['Mean_Query_Edge_Recall']:.2%}",
            "Delta Recall": f"{d_rec:+.2%}",
            "Mean Cands": f"{curr['Mean_Cand']:.1f}",
            "Delta Cands": f"{d_cand:+.1f}",
            "Positive Micro Precision": f"{curr['Positive_Micro_Cand_Precision']:.2%}",
            "Overall F0.5 Bound": f"{curr['Overall_F05_Upper_Bound']:.4f}"
        })

