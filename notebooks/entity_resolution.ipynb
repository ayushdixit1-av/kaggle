def get_strata(cntry: str, c: int) -> str:
    cntry = norm_country(cntry)
    if c == 0: b = "0_singleton"
    elif c == 1: b = "1_single"
    elif c <= 4: b = "2_to_4_plural"
    else: b = "5_plus_high"
    return f"{cntry}§{b}"

df_s1_meta = df_s1.with_columns([
    pl.Series("match_count", s1_match_lens, dtype=pl.UInt32),
    pl.Series("stratum", [get_strata(c, ml) for c, ml in zip(s1_countries, s1_match_lens)], dtype=pl.Utf8),
    (pl.col("business_address").is_not_null() & (pl.col("business_address") != "")).alias("has_address"),
    (pl.col("business_name").is_not_null() & (pl.col("business_name") != "")).alias("has_name")
])

# --- Sample A: Largest-Remainder (Hamilton-Hare) Exact N=20,000 Allocation ---
N_TARGET_A = 20000
strata_df = (
    df_s1_meta.group_by("stratum")
    .agg(pl.len().alias("count"))
    .with_columns(
        (pl.col("count") / df_s1_meta.height * N_TARGET_A).alias("exact_float")
    )
    .with_columns([
        pl.col("exact_float").floor().cast(pl.UInt32).alias("base_draw"),
        (pl.col("exact_float") - pl.col("exact_float").floor()).alias("remainder")
    ])
)

shortfall = N_TARGET_A - strata_df["base_draw"].sum()
strata_df = strata_df.sort("remainder", descending=True).with_row_index("rank")
strata_df = strata_df.with_columns(
    (pl.col("base_draw") + pl.when(pl.col("rank") < shortfall).then(1).otherwise(0)).alias("final_draw")
)
assert strata_df["final_draw"].sum() == N_TARGET_A, "Allocation bug: Sample A sum != 20,000"

sample_a_chunks = []
for r in strata_df.iter_rows(named=True):
    chunk = df_s1_meta.filter(pl.col("stratum") == r["stratum"]).sample(n=r["final_draw"], seed=42)
    sample_a_chunks.append(chunk)

df_sample_a = pl.concat(sample_a_chunks)
assert df_sample_a.height == 20000, f"Sample A height mismatch: {df_sample_a.height}"
print(f"\n  [PASS] Sample A: Exactly {df_sample_a.height:,} queries allocated via Largest Remainder.")

# --- Sample B: Balanced Cardinality Stress Sample (N=12,000: 3k each cardinality stratum) ---
sample_b_chunks = []
for b_target in ["0_singleton", "1_single", "2_to_4_plural", "5_plus_high"]:
    sub = df_s1_meta.filter(pl.col("stratum").str.ends_with(b_target))
    available = sub.height
    assert available >= 3000, f"Stress stratum {b_target} has only {available} records!"
    sample_b_chunks.append(sub.sample(n=3000, seed=1337))

df_sample_b = pl.concat(sample_b_chunks)
assert df_sample_b.height == 12000, f"Sample B height mismatch: {df_sample_b.height}"
print(f"  [PASS] Sample B: Exactly {df_sample_b.height:,} queries allocated across balanced stress strata.")

del df_s1, df_s1_meta
gc.collect()

