import pandas as pd
import re
import unicodedata

BASE = "/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset"

s1 = pd.read_csv(f"{BASE}/train/train_source1.tsv", sep="\t", dtype=str)
s2 = pd.read_csv(f"{BASE}/train/train_source2.tsv", sep="\t", dtype=str)
s3 = pd.read_csv(f"{BASE}/train/train_source3.tsv", sep="\t", dtype=str)

def normalize(x):
    x = "" if pd.isna(x) else str(x)
    x = unicodedata.normalize("NFKC", x).lower()
    x = re.sub(r"[^a-z0-9\u0900-\u097f]+", " ", x)
    return re.sub(r"\s+", " ", x).strip()

s1["name_norm"] = s1["business_name"].map(normalize)
s2["name_norm"] = s2["business_name"].map(normalize)
s3["name_norm"] = s3["business_name"].map(normalize)

s2_names = set(s2["name_norm"])
s3_names = set(s3["name_norm"])

s1["name_in_s2"] = s1["name_norm"].isin(s2_names)
s1["name_in_s3"] = s1["name_norm"].isin(s3_names)

print("S1:", len(s1))
print("Exact normalized name match in S2:", s1["name_in_s2"].sum())
print("Exact normalized name match in S3:", s1["name_in_s3"].sum())
print("Match in either:", (s1["name_in_s2"] | s1["name_in_s3"]).sum())
print("Match in both:", (s1["name_in_s2"] & s1["name_in_s3"]).sum())


import pandas as pd
import re
import unicodedata

BASE = "/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset"

s1 = pd.read_csv(f"{BASE}/train/train_source1.tsv", sep="\t", dtype=str)
s2 = pd.read_csv(f"{BASE}/train/train_source2.tsv", sep="\t", dtype=str)
s3 = pd.read_csv(f"{BASE}/train/train_source3.tsv", sep="\t", dtype=str)
gt = pd.read_csv(f"{BASE}/train/train_ground_truth.tsv", sep="\t", dtype=str)

def normalize(x):
    x = "" if pd.isna(x) else str(x)
    x = unicodedata.normalize("NFKC", x).lower()
    x = re.sub(r"[^a-z0-9\u0900-\u097f]+", " ", x)
    return re.sub(r"\s+", " ", x).strip()

s1["name_norm"] = s1["business_name"].map(normalize)
s2["name_norm"] = s2["business_name"].map(normalize)
s3["name_norm"] = s3["business_name"].map(normalize)

s2_map = {}
for eid, name in zip(s2["entity_id"], s2["name_norm"]):
    s2_map.setdefault(name, []).append(eid)

s3_map = {}
for eid, name in zip(s3["entity_id"], s3["name_norm"]):
    s3_map.setdefault(name, []).append(eid)

gt_map = dict(zip(gt["source1_entity_id"], gt["matched_entity_ids"]))

results = []

for eid, name in zip(s1["entity_id"], s1["name_norm"]):
    value = gt_map.get(eid, "")
    truth = set(str(value).split(",")) if pd.notna(value) else set()
    candidates = set(s2_map.get(name, []) + s3_map.get(name, []))
    results.append(bool(truth & candidates))

print("S1 records:", len(results))
print("Exact-name candidate contains true match:", sum(results))
print("Coverage:", round(sum(results) / len(results) * 100, 2), "%")


import pandas as pd
import re
import unicodedata

BASE = "/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset"

s1 = pd.read_csv(f"{BASE}/train/train_source1.tsv", sep="\t", dtype=str)
s2 = pd.read_csv(f"{BASE}/train/train_source2.tsv", sep="\t", dtype=str)
s3 = pd.read_csv(f"{BASE}/train/train_source3.tsv", sep="\t", dtype=str)
gt = pd.read_csv(f"{BASE}/train/train_ground_truth.tsv", sep="\t", dtype=str)

def normalize(x):
    x = "" if pd.isna(x) else str(x)
    x = unicodedata.normalize("NFKC", x).lower()
    x = re.sub(r"[^a-z0-9\u0900-\u097f]+", " ", x)
    return re.sub(r"\s+", " ", x).strip()

for df in [s1, s2, s3]:
    df["name_norm"] = df["business_name"].map(normalize)
    df["address_norm"] = df["business_address"].map(normalize)
    df["country_norm"] = df["country"].fillna("").str.upper().str.strip()

s2_name_country = {}
s3_name_country = {}

for eid, name, country in zip(s2["entity_id"], s2["name_norm"], s2["country_norm"]):
    s2_name_country.setdefault((name, country), []).append(eid)

for eid, name, country in zip(s3["entity_id"], s3["name_norm"], s3["country_norm"]):
    s3_name_country.setdefault((name, country), []).append(eid)

gt_map = dict(zip(gt["source1_entity_id"], gt["matched_entity_ids"]))

results = []

for eid, name, country in zip(s1["entity_id"], s1["name_norm"], s1["country_norm"]):
    value = gt_map.get(eid, "")
    truth = set(str(value).split(",")) if pd.notna(value) else set()
    candidates = set(
        s2_name_country.get((name, country), []) +
        s3_name_country.get((name, country), [])
    )
    results.append(bool(truth & candidates))

print("S1 records:", len(results))
print("Name + country candidate contains true match:", sum(results))
print("Coverage:", round(sum(results) / len(results) * 100, 2), "%")


