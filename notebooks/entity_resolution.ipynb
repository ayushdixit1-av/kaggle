from pathlib import Path

REPO = Path("/kaggle/working/entity_resolution_repo")
SNAPSHOT = REPO / "runtime_snapshot"

SNAPSHOT.mkdir(
    parents=True,
    exist_ok=True
)

VARIABLES = SNAPSHOT / "variables"
VARIABLES.mkdir(
    parents=True,
    exist_ok=True
)

manifest = {
    "python_version": sys.version,
    "saved": [],
    "failed": [],
    "excluded": []
}

exclude = {
    "__name__",
    "__doc__",
    "__package__",
    "__loader__",
    "__spec__",
    "__builtins__",
    "__builtin__",
    "In",
    "Out",
    "_",
    "__",
    "___"
}

for name, obj in list(globals().items()):

    if name in exclude:
        continue

    if name.startswith("__"):
        continue

    if isinstance(obj, types.ModuleType):
        manifest["excluded"].append({
            "name": name,
            "type": type(obj).__name__,
            "reason": "module"
        })
        continue

    path = VARIABLES / f"{name}.pkl"

    try:

        with open(
            path,
            "wb"
        ) as f:
            cloudpickle.dump(
                obj,
                f
            )

        manifest["saved"].append({
            "name": name,
            "type": type(obj).__name__,
            "file": path.name,
            "size_mb": round(
                path.stat().st_size / 1024**2,
                3
            )
        })

        print(
            f"[SAVED] {name:<40} "
            f"{type(obj).__name__:<25} "
            f"{path.stat().st_size / 1024**2:.2f} MB"
        )

    except Exception as e:

        manifest["failed"].append({
            "name": name,
            "type": type(obj).__name__,
            "error": repr(e)
        })

        print(
            f"[FAILED] {name:<40} "
            f"{type(obj).__name__:<25}"
        )

with open(
    SNAPSHOT / "manifest.json",
    "w"
) as f:
    json.dump(
        manifest,
        f,
        indent=2
    )

