# --- 2. Query Prefix Target Mapping (Sample A Scope with Symmetric norm_country) ---
target_query_prefixes = set()
query_target_map = {}

for q in SAMPLE:
    cntry = norm_country(q["cntry"])
    if not q.get("k_ex"):
        continue
    name_part = q["k_ex"].split("§")[-1]
    toks = set(canonical_tokens(name_part))
    
    cand_pfx = []
    for t in toks:
        if len(t) >= 5:
            key = f"{cntry}§{t[:4]}"
            if key in usable_prefix_keys:
                cand_pfx.append((key, usable_prefix_keys[key]))
                
    # Sort by lowest DF (rarest prefix first), pick top 2
    cand_pfx.sort(key=lambda x: x[1])
    selected_keys = [k for k, _ in cand_pfx[:2]]
    query_target_map[q["qid"]] = selected_keys
    for k in selected_keys:
        target_query_prefixes.add(k)

print(f"Target Prefix Keys needed for Sample A: {len(target_query_prefixes):,}")

# --- 3. Pass 2: Materialize Inverted Postings for Targeted Prefixes Only ---
print("\n[2/4] Pass 2: Materializing Targeted Postings (Zero-Waste Memory Footprint)...")
d_postings = defaultdict(list)

for source_id, df in ((2, df_s2), (3, df_s3)):
    base_idx = 0 if source_id == 2 else N_S2
    local_offset = 0
    for slice_df in df.iter_slices(n_rows=CHUNK_SIZE):
