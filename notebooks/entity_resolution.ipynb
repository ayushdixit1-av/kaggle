    new_edges_q = (d_raw_pool & gt_set) - abc_pool
    uncompressed_target_new_edges += len(new_edges_q)

print(f"Dynamically Verified Target New Edges Outside ABC: {uncompressed_target_new_edges:,} / {total_gt_sample:,} ({uncompressed_target_new_edges / total_gt_sample:.2%})")

# --- 3. Full-Population Scoring Across 100% of Channel D Candidates ---
print("\n[3/4] Executing Full-Population Scoring on All Retrieved Candidates...")
SCORE_START = time.time()
ranked_d_cands = {}

for q in SAMPLE:
    qid = q["qid"]
    selected_pfx = query_target_map.get(qid, [])
    if not selected_pfx:
        continue
        
    name_part = q.get("k_ex", "").split("§")[-1]
    q_toks = set(canonical_tokens(name_part))
    
    # 1. Accumulate prefix IDF across all matching postings
    cand_scores = defaultdict(float)
    for pfx_key in selected_pfx:
        post = usable_d_postings.get(pfx_key)
        if post is not None:
            w = pfx_idf.get(pfx_key, 1.0)
            for cid in post:
                cand_scores[int(cid)] += w
                
    if not cand_scores:
        continue
        
    # 2. Score EVERY single candidate without top-50 truncation
    final_scored = []
    for cid, base_score in cand_scores.items():
        c_toks = get_cand_tokens(cid)
        shared_toks = q_toks & c_toks
        total_score = base_score + (2.0 * len(shared_toks))
        final_scored.append((cid, total_score))
        
    # Deterministic descending sort by score, tie-broken by cid
    final_scored.sort(key=lambda x: (-x[1], x[0]))
    ranked_d_cands[qid] = [cid for cid, _ in final_scored]

print(f"Full-population scoring complete in {time.time() - SCORE_START:.1f}s")
