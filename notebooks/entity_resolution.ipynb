    separator="\t"
)

gt = pl.read_csv(
    DATA_DIR / "train_ground_truth.tsv",
    separator="\t"
)

print(
    f"S1: {s1.height:,}"
)

print(
    f"S2: {s2.height:,}"
)

print(
    f"S3: {s3.height:,}"
)

print(
    f"GT: {gt.height:,}"
)

print(
    f"RAM after loading: {ram():.1f} MB"
)

print("\nBuilding candidate corpus...")

cand_df = pl.concat(
    [
        s2.select(
            [
                "entity_id",
                "business_name",
                "business_address",
                "country"
            ]
        ),
        s3.select(
            [
                "entity_id",
                "business_name",
                "business_address",
                "country"
            ]
        )
    ],
    how="vertical"
)

N_CANDS = cand_df.height

print(
    f"Candidate universe: {N_CANDS:,}"
)

candidate_id_to_idx = {
    eid: i
    for i, eid in enumerate(
        cand_df["entity_id"].to_list()
    )
}

print(
    f"Candidate ID map built"
)

print("\nMapping ground truth...")

gt_map = defaultdict(list)

for row in gt.iter_rows(named=True):

    qid = row["source1_entity_id"]

    matches = row["matched_entity_ids"]

    if matches is None:
        continue

    if isinstance(matches, str):

        matches = matches.strip()

        if not matches:
            continue

        if matches.startswith("["):
            try:
                import json
                matches = json.loads(matches)
            except:
                matches = [
                    x.strip()
                    for x in matches.split(",")
                    if x.strip()
                ]

        else:
            matches = [
                x.strip()
                for x in matches.split(",")
                if x.strip()
            ]

    for eid in matches:

        idx = candidate_id_to_idx.get(
            eid
        )

        if idx is not None:
            gt_map[qid].append(
                idx
            )

print(
    f"GT queries mapped: {len(gt_map):,}"
)

print("\nBuilding Sample A...")

all_qids = s1["entity_id"].to_list()

rng = np.random.default_rng(42)

SAMPLE_SIZE = min(
    20000,
    len(all_qids)
)

sample_qids = rng.choice(
