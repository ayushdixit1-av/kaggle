import re
import unicodedata

RE_DELIM = re.compile(r'[\s,;/_\-\(\)\[\]]+')
RE_NON_ALPHANUM = re.compile(r'[^\w\s]', re.UNICODE)

def canonical_tokens(text: str) -> list[str]:
    if not text:
        return []
    nfkd = unicodedata.normalize("NFKD", str(text))
    ascii_norm = "".join(
        c for c in nfkd
        if not unicodedata.combining(c)
    ).upper()
    cleaned = RE_NON_ALPHANUM.sub(" ", ascii_norm)
    return [t for t in RE_DELIM.split(cleaned) if t]

def norm_country(c):
    return str(c).strip().upper() if c is not None else ""

print("[PASS] canonical_tokens restored")
print("[PASS] norm_country restored")

