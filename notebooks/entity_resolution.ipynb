        cntrys = slice_df["country"].fill_null("UNK").to_numpy()
        
        for name, country in zip(names, cntrys):
            cid = base_idx + local_offset
            local_offset += 1
            
            cntry = norm_country(country)
            toks = set(canonical_tokens(name))
            seen = set()
            for t in toks:
                if len(t) >= 5:
                    seen.add(t[:4])
            for pfx in seen:
                key = f"{cntry}§{pfx}"
                if key in target_query_prefixes:
                    p = d_postings[key]
                    if len(p) < MAX_PREFIX_DF:
                        p.append(cid)

del df_s2, df_s3
