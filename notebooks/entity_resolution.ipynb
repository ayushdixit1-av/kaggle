        )

buf_exact = flatten_store(
    builder_exact
)

del builder_exact
gc.collect()

print(
    f"A ready | RAM "
    f"{ram():.1f} MB"
)

print("\nBuilding token-sorted index B...")

builder_sorted = defaultdict(list)

for i, row in enumerate(
    cand_df.iter_rows(named=True)
):

    key = sorted_key(
        row["business_name"],
        norm_country(row["country"])
    )

    builder_sorted[key].append(i)

    if i > 0 and i % 1000000 == 0:
        print(
            f"B indexed "
            f"{i:,}/{N_CANDS:,}"
        )

buf_sorted = flatten_store(
    builder_sorted
)

del builder_sorted
gc.collect()

print(
    f"B ready | RAM "
    f"{ram():.1f} MB"
)

print("\nBuilding Channel C document frequencies...")

word_df = Counter()

for i, row in enumerate(
    cand_df.iter_rows(named=True)
):

    country = norm_country(
        row["country"]
    )

    tokens = canonical_tokens(
        row["business_name"]
    )

    for token in set(tokens):

        if len(token) < 3:
            continue

        word_df[
            f"{country}§{token}"
        ] += 1

    if i > 0 and i % 1000000 == 0:
        print(
            f"DF processed "
            f"{i:,}/{N_CANDS:,}"
        )

MAX_DF = 5000

word_idf = {
    key: math.log(
        (N_CANDS + 1.0)
        /
        (df + 1.0)
    )
    for key, df in word_df.items()
    if df <= MAX_DF
}

print(
    f"Total word keys: "
    f"{len(word_df):,}"
)

print(
    f"Active IDF keys: "
    f"{len(word_idf):,}"
)

del word_df
gc.collect()

print("\nBuilding Channel C index...")

builder_c = defaultdict(list)

for i, row in enumerate(
    cand_df.iter_rows(named=True)
):

    country = norm_country(
        row["country"]
    )

    tokens = canonical_tokens(
        row["business_name"]
    )

    for token in set(tokens):

        if len(token) < 3:
            continue

        key = (
            f"{country}§{token}"
        )

        if key in word_idf:
            builder_c[key].append(i)

    if i > 0 and i % 1000000 == 0:
        print(
            f"C indexed "
            f"{i:,}/{N_CANDS:,}"
        )

buf_c = flatten_store(
    builder_c
)

del builder_c
gc.collect()

print(
    f"C ready | RAM "
    f"{ram():.1f} MB"
)

print("\nStarting evaluation...")


def evaluate(depth):

    edge = []
    any_hit = []
    complete = []

    candidate_counts = []

    total_hits = 0
    total_candidates = 0

    start = time.time()

    for q in queries_sample_a:

        slices = []

        a = get_postings(
            buf_exact,
            q["k_ex"]
        )

        if len(a):
            slices.append(a)

        b = get_postings(
            buf_sorted,
            q["k_so"]
        )

        if len(b):
            slices.append(b)

        ranked_tokens = []

        for token in set(
            q["name_tokens"]
        ):

            key = (
                f"{q['cntry']}§{token}"
            )

            score = word_idf.get(
                key
            )

            if score is not None:
                ranked_tokens.append(
                    (
                        token,
                        score
                    )
                )

        ranked_tokens.sort(
            key=lambda x: x[1],
            reverse=True
        )

        for token, _ in ranked_tokens[:depth]:

            key = (
                f"{q['cntry']}§{token}"
            )

            c = get_postings(
                buf_c,
                key
            )

            if (
                len(c) > 0
                and len(c) <= 2000
            ):
                slices.append(c)

        if not slices:

            candidates = np.empty(
                0,
                dtype=np.uint32
            )

        elif len(slices) == 1:

            candidates = slices[0]

        else:

            candidates = np.unique(
                np.concatenate(
                    slices
                )
            )

        n = len(candidates)

        candidate_counts.append(n)

        gt_set = q["gt_set"]

        if len(gt_set) == 0:
            continue

        hits = len(
            set(
                candidates.tolist()
            )
            &
            gt_set
        )

        edge.append(
            hits / len(gt_set)
        )

        any_hit.append(
            hits > 0
        )

        complete.append(
            hits == len(gt_set)
        )

        total_hits += hits
        total_candidates += n

    elapsed = (
        time.time() - start
    )

    return {
        "depth": depth,
        "edge": np.mean(edge),
        "any": np.mean(any_hit),
        "complete": np.mean(complete),
        "precision": (
            total_hits /
            total_candidates
            if total_candidates
            else 0
        ),
        "mean": np.mean(
            candidate_counts
        ),
        "p50": np.percentile(
            candidate_counts,
            50
        ),
        "p95": np.percentile(
            candidate_counts,
            95
        ),
        "p99": np.percentile(
            candidate_counts,
            99
        ),
        "max": max(
            candidate_counts
        ),
        "seconds": elapsed
    }


results = []

for depth in [1, 2, 3, 4]:

    r = evaluate(depth)

    results.append(r)

    print(
        f"C top{depth} | "
        f"edge={r['edge']:.2%} | "
        f"any={r['any']:.2%} | "
        f"complete={r['complete']:.2%} | "
        f"precision={r['precision']:.2%} | "
        f"mean={r['mean']:.2f} | "
        f"P50={r['p50']:.0f} | "
        f"P95={r['p95']:.0f} | "
        f"P99={r['p99']:.0f} | "
        f"max={r['max']} | "
        f"time={r['seconds']:.1f}s"
    )

print("\n")
print("=" * 110)
print("BENCHMARK 2A COMPLETE")
print("=" * 110)

print(
    f"Final RAM: "
    f"{ram():.1f} MB"
)


import gc
import math
import resource
import time
from collections import Counter, defaultdict
from pathlib import Path
import numpy as np
import polars as pl

START_TIME = time.time()

def get_peak_ram_mb():
    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0

def log_telemetry(step):
    gc.collect()
    print(f"[RAM] {step:<50} {get_peak_ram_mb():,.0f} MB")

print("=" * 120)
print("BENCHMARK 2B — PRODUCTION-OPTIMIZED TWO-PASS RUNNER")
print("=" * 120)

DATA_DIR = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset/train")
SAMPLE = queries_sample_a

# --- [1/5] Load Metadata & Sizes ---
print("\n[1/5] Scanning candidate metadata sizes...")
df_s2 = pl.read_csv(DATA_DIR / "train_source2.tsv", separator="\t", columns=["business_name", "country"])
df_s3 = pl.read_csv(DATA_DIR / "train_source3.tsv", separator="\t", columns=["business_name", "country"])

N_S2 = df_s2.height
N_S3 = df_s3.height
N_CANDS = N_S2 + N_S3
print(f"S2: {N_S2:,} | S3: {N_S3:,} | Total candidates: {N_CANDS:,}")
log_telemetry("Metadata loaded")

# --- [2/5] Pass 1: Streaming Document Frequency (DF) ---
print("\n[2/5] Pass 1: Calculating corpus token DF...")
word_df = Counter()
CHUNK_SIZE = 250_000

for df in (df_s2, df_s3):
    for slice_df in df.iter_slices(n_rows=CHUNK_SIZE):
        names = slice_df["business_name"].fill_null("").to_numpy()
        countries = slice_df["country"].fill_null("").to_numpy()
        for name, country in zip(names, countries):
            cntry = norm_country(country)
            toks = set(canonical_tokens(name))
            for tok in toks:
                if len(tok) >= 3:
                    word_df[f"{cntry}§{tok}"] += 1

print(f"Total vocabulary size: {len(word_df):,}")
STOP_COUNT = max(50, int(len(word_df) * 0.002))
stop_words = {k for k, _ in word_df.most_common(STOP_COUNT)}

def calc_idf(df_val):
    return math.log((N_CANDS + 1.0) / (df_val + 1.0))

word_idf_map = {
    k: calc_idf(v)
    for k, v in word_df.items()
    if k not in stop_words and v <= 5000
}
del word_df, stop_words
gc.collect()
print(f"Usable IDF keys: {len(word_idf_map):,}")
log_telemetry("Corpus DF & IDF completed")

# --- [3/5] Determine Query-Relevant Channel C Tokens ---
print("\n[3/5] Extracting relevant query tokens...")
query_token_keys = set()
for q in SAMPLE:
    cntry = q["cntry"]
    if not q.get("k_ex"):
        continue
    name_part = q["k_ex"].split("§")[-1]
    toks = set(canonical_tokens(name_part))
    valid = [t for t in toks if f"{cntry}§{t}" in word_idf_map]
    ranked = sorted(valid, key=lambda t: word_idf_map[f"{cntry}§{t}"], reverse=True)[:2]
    for t in ranked:
        query_token_keys.add(f"{cntry}§{t}")

print(f"Target query-relevant C tokens: {len(query_token_keys):,}")
if not query_token_keys:
    raise RuntimeError("No query-relevant tokens found for Channel C.")

# Pre-gather all candidate IDs present in Channel A and Channel B to record their doc lengths
pre_required_cids = set()
for q in SAMPLE:
    if q.get("k_ex"):
        pre_required_cids.update(get_postings(buf_exact, off_exact, q["k_ex"]))
    if q.get("k_so"):
        pre_required_cids.update(get_postings(buf_sorted, off_sorted, q["k_so"]))

log_telemetry("Target tokens & A/B candidate IDs determined")

# --- [4/5] Pass 2: Selective Postings & True Candidate Doc Lengths ---
print("\n[4/5] Pass 2: Building target postings & length cache...")
relevant_postings = defaultdict(list)
candidate_lengths = {}
MAX_POSTINGS = 1500

for source_id, df in ((2, df_s2), (3, df_s3)):
    base_idx = 0 if source_id == 2 else N_S2
    local_offset = 0
    for slice_df in df.iter_slices(n_rows=CHUNK_SIZE):
        names = slice_df["business_name"].fill_null("").to_numpy()
        countries = slice_df["country"].fill_null("").to_numpy()
        
        for name, country in zip(names, countries):
            cid = base_idx + local_offset
            local_offset += 1
            
            cntry = norm_country(country)
            tok_list = canonical_tokens(name)
            num_tokens = len(tok_list)
            toks = set(tok_list)
            
            # Check if this candidate hits any active query inverted list
            matched_target = False
            for tok in toks:
                if len(tok) < 3:
                    continue
                key = f"{cntry}§{tok}"
                if key in query_token_keys:
                    postings = relevant_postings[key]
                    if len(postings) < MAX_POSTINGS:
                        postings.append(cid)
                    matched_target = True

            # Preserve exact document lengths for all participating candidates (A, B, or C)
            if matched_target or (cid in pre_required_cids):
                candidate_lengths[cid] = max(1, num_tokens)

del df_s2, df_s3, pre_required_cids
gc.collect()

usable_postings = {
    k: np.asarray(v, dtype=np.uint32)
    for k, v in relevant_postings.items()
    if 0 < len(v) <= MAX_POSTINGS
}
del relevant_postings
