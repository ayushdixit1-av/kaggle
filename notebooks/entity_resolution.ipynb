MAX_K = 100
payload_by_qid = {p["qid"]: p for p in query_payloads}

def build_feature_matrix(include_address_candidates=True):
    mode_name = "ABC + E (Treatment)" if include_address_candidates else "ABC Only (Control B)"
    print(f"\n[Featurizing] Building Matrix for: {mode_name} (MAX_K = {MAX_K})...")
    f_start = time.time()
    rows = []
    offsets = []

    for q_idx, q in enumerate(SAMPLE):
        qid = q["qid"]
        item = payload_by_qid.get(qid)
        if not item:
            continue

        gt_set = item["gt_set"]
        
        raw_q_name = q.get("k_ex", "").split("§")[-1]
        q_tok_list = canonical_tokens(raw_q_name)
        q_name = " ".join(q_tok_list)
        q_toks = set(q_tok_list)
        q_cntry = norm_country(q.get("cntry", "UNK"))
        q_len = max(1, len(q_name))
        q_tok_count = max(1, len(q_tok_list))

        raw_q_addr = s1_addrs_map.get(qid, "").strip()
        clean_q_addr = clean_address_string(raw_q_addr)
        q_postal = extract_postal_code(raw_q_addr)
        q_addr_toks = set(get_meaningful_alpha_tokens(raw_q_addr))

        exact_list = get_postings(buf_exact, off_exact, q["k_ex"]) if q.get("k_ex") else []
        sorted_list = get_postings(buf_sorted, off_sorted, q["k_so"]) if q.get("k_so") else []
        exact_rank_map = {cid: r for r, cid in enumerate(exact_list, start=1)}
        sorted_rank_map = {cid: r for r, cid in enumerate(sorted_list, start=1)}

        valid_tokens = [t for t in q_toks if f"{q_cntry}§{t}" in word_idf_map]
        ranked_tokens = sorted(valid_tokens, key=lambda t: word_idf_map[f"{q_cntry}§{t}"], reverse=True)[:2]
        cand_c_evidence = defaultdict(list)
        for tok in ranked_tokens:
            key = f"{q_cntry}§{tok}"
            p = usable_postings.get(key)
            if p is not None:
                idf = word_idf_map[key]
                for cid in p:
                    cand_c_evidence[int(cid)].append(idf)

        # Address postings
        ka = q_keys_e1a.get(qid)
        kc = q_keys_e1c.get(qid)
        e1a_cids = set(usable_post_e1a.get(ka, [])) if (ka and include_address_candidates) else set()
        e1c_cids = set(usable_post_e1c.get(kc, [])) if (kc and include_address_candidates) else set()

        base_abc = list(item["combined"])
        abc_rank_map = {cid: r for r, cid in enumerate(base_abc, start=1)}
        
        all_candidate_cids = set(base_abc) | e1a_cids | e1c_cids

        def candidate_priority(cid):
            in_a = cid in exact_rank_map
            in_b = cid in sorted_rank_map
            in_e1a = cid in e1a_cids
            in_e1c = cid in e1c_cids
            
            # Tier 0: Dual Consensus (Address match AND Name match)
            if (in_e1a or in_e1c) and (in_a or in_b):
                tier = 0
                sub_rank = min(exact_rank_map.get(cid, 999), sorted_rank_map.get(cid, 999))
            # Tier 1: Exact Name (A) OR Exact Address (E1a)
            elif in_a:
                tier = 1
                sub_rank = exact_rank_map[cid]
            elif in_e1a:
                tier = 1
                sub_rank = 1
            # Tier 2: Sorted Name (B) OR Compound Address (E1c)
            elif in_b:
                tier = 2
                sub_rank = sorted_rank_map[cid]
            elif in_e1c:
                tier = 2
                sub_rank = 1
            # Tier 3: Existing Combined ABC Pool Order
            else:
                tier = 3
                sub_rank = abc_rank_map.get(cid, 9999)
                
            return (tier, sub_rank, abc_rank_map.get(cid, 9999), cid)

        sorted_cands = sorted(all_candidate_cids, key=candidate_priority)[:MAX_K]
        start_pos = len(rows)

        for rank, cid in enumerate(sorted_cands, start=1):
            c_raw_name, c_raw_addr, c_cntry, src = get_cand_full(cid)
            c_tok_list = canonical_tokens(c_raw_name)
            c_name = " ".join(c_tok_list)
            c_toks = set(c_tok_list)
            c_len = max(1, len(c_name))
            c_tok_count = len(c_tok_list)

            in_a = cid in exact_rank_map
            in_b = cid in sorted_rank_map
            c_idfs = cand_c_evidence.get(cid)
            in_c = c_idfs is not None
            in_e1a = cid in e1a_cids
            in_e1c = cid in e1c_cids

            r_a = float(exact_rank_map.get(cid, 0))
            r_b = float(sorted_rank_map.get(cid, 0))

            c_overlap_cnt = float(len(c_idfs)) if in_c else 0.0
            c_idf_sum = float(sum(c_idfs)) if in_c else 0.0
            c_max_idf = float(max(c_idfs)) if in_c else 0.0
            c_coverage = (c_overlap_cnt / q_tok_count) if in_c else 0.0

            shared_toks = q_toks & c_toks
            n_shared = len(shared_toks)
            union_toks = q_toks | c_toks
            jaccard = (n_shared / len(union_toks)) if union_toks else 0.0
            containment = 1.0 if (q_toks and (q_toks.issubset(c_toks) or c_toks.issubset(q_toks))) else 0.0
            set_equal = 1.0 if q_toks == c_toks and q_toks else 0.0
            
            jw = jaro_winkler_safe(q_name, c_name)
            lev = levenshtein_ratio(q_name, c_name)
            tri = char_trigram_jaccard(q_name, c_name)
            is_exact_name = 1.0 if q_name == c_name else 0.0

            first_match = 1.0 if (q_tok_list and c_tok_list and q_tok_list[0] == c_tok_list[0]) else 0.0
            last_match = 1.0 if (q_tok_list and c_tok_list and q_tok_list[-1] == c_tok_list[-1]) else 0.0

            clean_c_addr = clean_address_string(c_raw_addr)
            c_postal = extract_postal_code(c_raw_addr)
            c_addr_toks = set(get_meaningful_alpha_tokens(c_raw_addr))
            
            addr_exact = 1.0 if (clean_q_addr and clean_c_addr and clean_q_addr == clean_c_addr) else 0.0
            post_match = 1.0 if (q_postal and c_postal and q_postal == c_postal) else 0.0
            
            shared_addr = q_addr_toks & c_addr_toks
            union_addr = q_addr_toks | c_addr_toks
            addr_jaccard = (len(shared_addr) / len(union_addr)) if union_addr else 0.0

            label = 1 if cid in gt_set else 0

            row = [
                q_idx,
                cid,
                label,
                float(rank),
                1.0 if in_a else 0.0,
                1.0 if in_b else 0.0,
                1.0 if in_c else 0.0,
                1.0 if in_e1a else 0.0,
                1.0 if in_e1c else 0.0,
                r_a,
                r_b,
                1.0 if (in_a and in_b) else 0.0,
                1.0 if (in_a and in_c) else 0.0,
                1.0 if (in_b and in_c) else 0.0,
                1.0 if ((in_e1a or in_e1c) and (in_a or in_b)) else 0.0,
                c_overlap_cnt,
                c_idf_sum,
                c_max_idf,
                c_coverage,
                jw,
                lev,
                tri,
                is_exact_name,
                jaccard,
                containment,
                set_equal,
                float(n_shared),
                first_match,
                last_match,
                float(q_tok_count),
                float(c_tok_count),
                float(abs(q_tok_count - c_tok_count)),
                float(abs(q_len - c_len) / max(q_len, c_len)),
                addr_exact,
                post_match,
                addr_jaccard,
                float(len(shared_addr)),
                1.0 if (q_cntry == norm_country(c_cntry)) and q_cntry != "UNK" else 0.0,
                1.0 if src == 2 else 0.0
            ]
            rows.append(row)

        end_pos = len(rows)
        offsets.append((q_idx, qid, len(gt_set), gt_set, start_pos, end_pos))

    col_names = ["q_idx", "cid", "label"] + feature_names
    df_feat = pl.DataFrame(rows, schema=col_names, orient="row")
    del rows
    gc.collect()
    print(f"  Matrix ready in {time.time() - f_start:.1f}s | Rows: {df_feat.height:,}")
    log_telemetry(f"Feature matrix built ({mode_name})")
    return df_feat, offsets

# --- 5. Unified Fast Cross-Validation & Metric Engine ---
def run_cv_and_sweep(df_feat, offsets, label_name):
    print(f"\n[Training] 5-Fold Query-Grouped LightGBM ({label_name})...")
    X = df_feat.select(feature_names).to_numpy()
    y = df_feat["label"].to_numpy()
    q_indices = df_feat["q_idx"].to_numpy()

    oof_preds = np.zeros(len(df_feat), dtype=np.float32)
    accum_gain = np.zeros(len(feature_names), dtype=np.float64)

    kf = KFold(n_splits=5, shuffle=True, random_state=42)
    unique_q = np.unique(q_indices)

    params = {
        "objective": "binary",
        "metric": "binary_logloss",
        "boosting_type": "gbdt",
        "learning_rate": 0.08,
        "num_leaves": 31,
        "max_depth": 6,
        "min_child_samples": 50,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "verbosity": -1,
        "n_jobs": -1
    }

    for fold, (train_q_idx, val_q_idx) in enumerate(kf.split(unique_q)):
        train_queries = set(unique_q[train_q_idx])
        val_queries = set(unique_q[val_q_idx])

        train_mask = np.isin(q_indices, list(train_queries))
        val_mask = np.isin(q_indices, list(val_queries))

        dtrain = lgb.Dataset(X[train_mask], label=y[train_mask])
        dval = lgb.Dataset(X[val_mask], label=y[val_mask], reference=dtrain)

        bst = lgb.train(
            params,
            dtrain,
            num_boost_round=500,
            valid_sets=[dval],
            callbacks=[lgb.early_stopping(50, verbose=False)]
        )

        oof_preds[val_mask] = bst.predict(X[val_mask], num_iteration=bst.best_iteration)
        accum_gain += bst.feature_importance(importance_type="gain")

    mean_gain = accum_gain / 5.0
    imp_df = pl.DataFrame({
        "Feature": feature_names,
        "5Fold_Mean_Gain": mean_gain
    }).sort("5Fold_Mean_Gain", descending=True)

    # Vectorized Metric Evaluation
    v_q_idx = df_feat["q_idx"].to_numpy().astype(np.int32)
    v_label = df_feat["label"].to_numpy().astype(np.int8)
    v_prob  = oof_preds
    v_rank  = df_feat["retrieval_rank"].to_numpy().astype(np.int16)

    query_n_gt = np.zeros(N_QUERIES, dtype=np.int32)
    for q_idx, qid, match_count, _, _, _ in offsets:
        query_n_gt[q_idx] = match_count

    is_singleton_mask = (query_n_gt == 0)
    is_non_singleton_mask = ~is_singleton_mask
    n_singletons = np.count_nonzero(is_singleton_mask)

    def eval_fast(k_limit, threshold):
        active = (v_rank <= k_limit) & (v_prob >= threshold)
        n_pred_per_q = np.bincount(v_q_idx[active], minlength=N_QUERIES)
        tp_per_q = np.bincount(v_q_idx[active & (v_label == 1)], minlength=N_QUERIES)
        
        singleton_hits = (n_pred_per_q[is_singleton_mask] == 0)
        singleton_acc = float(np.mean(singleton_hits)) if n_singletons > 0 else 1.0
        singleton_fpr = 1.0 - singleton_acc
        
        tp_ns = tp_per_q[is_non_singleton_mask]
        n_pred_ns = n_pred_per_q[is_non_singleton_mask]
        n_gt_ns = query_n_gt[is_non_singleton_mask]
        
        fp_ns = n_pred_ns - tp_ns
        fn_ns = n_gt_ns - tp_ns
        
        denom = (1.25 * tp_ns) + (0.25 * fn_ns) + fp_ns
        f05_ns = np.zeros_like(denom, dtype=np.float64)
        valid_denom = denom > 0
        f05_ns[valid_denom] = (1.25 * tp_ns[valid_denom]) / denom[valid_denom]
        
        all_f05 = np.empty(N_QUERIES, dtype=np.float64)
        all_f05[is_singleton_mask] = singleton_hits.astype(np.float64)
        all_f05[is_non_singleton_mask] = f05_ns
        
        p_denom = np.maximum(1, n_pred_ns)
        precisions = np.where(n_pred_ns > 0, tp_ns / p_denom, 0.0)
        recalls = tp_ns / n_gt_ns
        
        return {
            "Branch": label_name,
            "K": k_limit,
            "Threshold": threshold,
            "Macro F0.5": float(np.mean(all_f05)),
            "Precision": float(np.mean(precisions)),
            "Recall": float(np.mean(recalls)),
            "Non-Sing F0.5": float(np.mean(f05_ns)),
            "Singleton Acc": singleton_acc,
            "Singleton FPR": singleton_fpr
        }

    records = []
    for k_val in [20, 30, 50, 75, 100]:
        for tau in [0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.50]:
            records.append(eval_fast(k_val, tau))

    return pl.DataFrame(records), imp_df

