        "P90": np.percentile(true_pair_scores, 90) if true_pair_scores else None,
        "Mean": float(np.mean(true_pair_scores)) if true_pair_scores else None,
    },
    {
        "Cohort": "Hard Negatives",
        "Count": len(hard_negative_scores),
        "P10": np.percentile(hard_negative_scores, 10) if hard_negative_scores else None,
        "P50": np.percentile(hard_negative_scores, 50) if hard_negative_scores else None,
        "P90": np.percentile(hard_negative_scores, 90) if hard_negative_scores else None,
        "Mean": float(np.mean(hard_negative_scores)) if hard_negative_scores else None,
    },
    {
        "Cohort": "Singleton Candidates",
        "Count": len(singleton_scores),
        "P10": np.percentile(singleton_scores, 10) if singleton_scores else None,
        "P50": np.percentile(singleton_scores, 50) if singleton_scores else None,
        "P90": np.percentile(singleton_scores, 90) if singleton_scores else None,
        "Mean": float(np.mean(singleton_scores)) if singleton_scores else None,
    }
])
print("\n--- SCORE DISTRIBUTIONS ---")
print(dist)
del true_pair_scores, hard_negative_scores, singleton_scores, candidate_lengths
gc.collect()

# --- Benchmarking Engine ---
def benchmark(policy, k):
    macro_edge_recalls, any_hits, complete_hits = [], [], []
    candidate_counts, singleton_contam, singleton_counts = [], [], []
    total_tp, total_candidates, compressed_hits = 0, 0, 0

    for item in query_payloads:
        gt_set = item["gt_set"]
        is_singleton = item["match_count"] == 0

        if k == 0:
            final_ids = []
        elif policy == "global":
            final_ids = item["combined"][:k]
        else:
            s2 = item["s2"]
            s3 = item["s3"]
            half = k // 2
            s2_sel = s2[:half]
            s3_sel = s3[:half]

            rem = k - len(s2_sel) - len(s3_sel)
            if rem > 0:
                s2_extra = s2[half:half + rem]
                rem -= len(s2_extra)
                s3_extra = s3[half:half + rem]
                s2_sel = s2_sel + s2_extra
                s3_sel = s3_sel + s3_extra
            final_ids = s2_sel + s3_sel

        nc = len(final_ids)
        candidate_counts.append(nc)

        if is_singleton:
            singleton_contam.append(1 if nc > 0 else 0)
            singleton_counts.append(nc)
            continue

        total_candidates += nc
        hits = len(set(final_ids) & gt_set)
        total_tp += hits
        compressed_hits += hits

        macro_edge_recalls.append(hits / len(gt_set))
        any_hits.append(1.0 if hits > 0 else 0.0)
        complete_hits.append(1.0 if hits == len(gt_set) else 0.0)

    c = np.asarray(candidate_counts)
    micro_edge_recall = (total_tp / total_gt_edges) if total_gt_edges else 0.0
    micro_retention = (compressed_hits / raw_reachable_edges) if raw_reachable_edges else 0.0

    return {
        "Policy": policy,
        "K": k,
        "Macro Recall": float(np.mean(macro_edge_recalls)) if macro_edge_recalls else 0.0,
        "Micro Recall": micro_edge_recall,
        "Micro Retention": micro_retention,
        "Any Recall": float(np.mean(any_hits)),
        "Complete Recall": float(np.mean(complete_hits)),
        "Precision": (total_tp / total_candidates) if total_candidates else 0.0,
        "Singleton Contam": float(np.mean(singleton_contam)),
        "Singleton Mean": float(np.mean(singleton_counts)),
        "Mean": float(np.mean(c)),
        "P50": int(np.percentile(c, 50)),
        "P95": int(np.percentile(c, 95)),
        "P99": int(np.percentile(c, 99)),
        "% >25": float(np.mean(c > 25)),
        "% >50": float(np.mean(c > 50)),
        "% >100": float(np.mean(c > 100)),
        "% >200": float(np.mean(c > 200)),
    }

print("\nRunning compression sweep...")
K_VALUES = [5, 10, 15, 20, 30, 40, 50, 75, 100]
results = []

for policy in ("global", "balanced"):
    for k in K_VALUES:
        print(f"  {policy:<10} K={k:<3}", end=" ", flush=True)
        res = benchmark(policy, k)
        results.append(res)
        print(
            f"MacroRec={res['Macro Recall']:.2%} "
            f"MicroRec={res['Micro Recall']:.2%} "
            f"Ret={res['Micro Retention']:.2%} "
            f"Prec={res['Precision']:.2%}"
        )

print("\n" + "=" * 160)
print("BENCHMARK 2B — FINAL VALIDATED RESULTS")
print("=" * 160)
print(pl.DataFrame(results))
print("\n" + "=" * 120)
print(f"COMPLETE | Runtime: {time.time() - START_TIME:.1f}s | Peak RAM: {get_peak_ram_mb():,.0f} MB")
print("=" * 120)


