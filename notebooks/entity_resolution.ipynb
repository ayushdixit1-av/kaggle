        "Count": len(true_pair_scores),
        "P10": np.percentile(true_pair_scores, 10) if true_pair_scores else None,
        "P50": np.percentile(true_pair_scores, 50) if true_pair_scores else None,
        "P90": np.percentile(true_pair_scores, 90) if true_pair_scores else None,
        "Mean": float(np.mean(true_pair_scores)) if true_pair_scores else None,
    },
