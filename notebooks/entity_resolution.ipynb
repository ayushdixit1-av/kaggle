        if post is not None:
            d_pool.update(post)
            
    union_pool = abc_pool | d_pool
    
    # Candidate lengths
    len_abc = len(abc_pool)
    len_d = len(d_pool)
    len_union = len(union_pool)
    
    abc_cands_all.append(len_abc)
    d_cands_all.append(len_d)
    union_cands_all.append(len_union)
    
    if is_singleton:
        abc_cands_singletons.append(len_abc)
        d_cands_singletons.append(len_d)
        union_cands_singletons.append(len_union)
    else:
        abc_hits = abc_pool & gt_set
        d_hits = d_pool & gt_set
        union_hits = union_pool & gt_set
        
        shared_hits = abc_hits & d_hits
        new_d_hits = d_hits - abc_hits  # Genuinely new ground-truth edges
        
        abc_hits_total += len(abc_hits)
        d_hits_total += len(d_hits)
        shared_hits_total += len(shared_hits)
        new_d_hits_total += len(new_d_hits)
        union_hits_total += len(union_hits)
        
        if len(abc_hits) > 0: abc_any_match_queries += 1
        if len(d_hits) > 0: d_any_match_queries += 1
        if len(union_hits) > 0: union_any_match_queries += 1

# --- 5. Generate Comprehensive Pareto & Tail Metrics ---
def get_distribution_stats(arr):
    a = np.asarray(arr, dtype=np.int32)
    return {
        "Mean": f"{np.mean(a):.1f}",
        "P50": f"{int(np.percentile(a, 50))}",
        "P95": f"{int(np.percentile(a, 95))}",
        "P99": f"{int(np.percentile(a, 99))}",
        "Max": f"{int(np.max(a))}",
        "% Zero": f"{np.mean(a == 0):.2%}",
        ">25": f"{np.sum(a > 25):,} ({np.mean(a > 25):.2%})",
        ">50": f"{np.sum(a > 50):,} ({np.mean(a > 50):.2%})",
        ">100": f"{np.sum(a > 100):,} ({np.mean(a > 100):.2%})",
        ">200": f"{np.sum(a > 200):,} ({np.mean(a > 200):.2%})"
    }

print("\n" + "=" * 110)
print("1. GROUND-TRUTH EDGE RECOVERY (EXPLICIT VENN DECOMPOSITION)")
