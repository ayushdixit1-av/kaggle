        num_boost_round=500,
        valid_sets=[dval],
        callbacks=[
            lgb.early_stopping(
                50,
                verbose=False
            )
        ]
    )

    assert bst.num_feature() == 36
    assert list(
        bst.feature_name()
    ) == FEATURE_NAMES

    treatment_models_a.append(
        bst
    )

    treatment_best_iters_a.append(
        int(bst.best_iteration)
    )

    bst.save_model(
        f"/kaggle/working/"
        f"treatment_fold_{fold}.txt",
        num_iteration=bst.best_iteration
    )

    print(
        f"Fold {fold} locked | "
        f"Best iteration: {bst.best_iteration} | "
        f"Features: {bst.num_feature()}"
    )

