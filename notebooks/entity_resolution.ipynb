        "P50": np.percentile(hard_negative_scores, 50) if hard_negative_scores else None,
        "P90": np.percentile(hard_negative_scores, 90) if hard_negative_scores else None,
        "Mean": float(np.mean(hard_negative_scores)) if hard_negative_scores else None,
    },
    {
