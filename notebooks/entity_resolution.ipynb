def get_postings(buffer: np.ndarray, offsets: dict, key: str) -> np.ndarray:
    entry = offsets.get(key)
    if entry is None:
        return np.empty(0, dtype=np.uint32)
    start, length = entry
    return buffer[start : start + length]

