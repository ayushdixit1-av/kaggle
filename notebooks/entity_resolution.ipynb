# Stage 6: Preprocessing Sample Queries (Done Once)
# -------------------------------------------------------------------------
def prepare_preprocessed_queries(df_sample: pl.DataFrame) -> list[dict]:
    q_ids = df_sample["entity_id"].to_list()
    q_names = df_sample["business_name"].fill_null("").to_list()
    q_addrs = df_sample["business_address"].fill_null("").to_list()
    q_countries = df_sample["country"].to_list()
    q_has_addr = df_sample["has_address"].to_list()
    q_has_name = df_sample["has_name"].to_list()
    q_match_lens = df_sample["match_count"].to_list()
    
    prepared = []
    for i in range(df_sample.height):
        cntry = norm_country(q_countries[i])
        n_tok = canonical_tokens(q_names[i])
        a_tok = canonical_tokens(q_addrs[i])
        p, h = extract_syntactic_address(a_tok, q_addrs[i]) if a_tok else ("", "")
        
        gt_arr = gt_int_map.get(q_ids[i], np.empty(0, dtype=np.uint32))
        
        prepared.append({
            "qid": q_ids[i],
            "cntry": cntry,
            "has_addr": q_has_addr[i],
            "has_name": q_has_name[i],
            "match_count": q_match_lens[i],
            "gt_arr": gt_arr,
            "gt_set": set(gt_arr),
            "k_ex": f"{cntry}§{exact_key(n_tok)}" if n_tok else "",
            "k_so": f"{cntry}§{token_sorted_key(n_tok)}" if n_tok else "",
            "k_p": f"{cntry}§{p}" if p else "",
            "k_ph": f"{cntry}§{p}§{h}" if (p and h) else ""
        })
    return prepared

print(f"  Preprocessing Sample A queries... | Peak RSS: {get_peak_ram_mb():.2f} MB")
queries_sample_a = prepare_preprocessed_queries(df_sample_a)
print(f"  Preprocessing Sample B queries... | Peak RSS: {get_peak_ram_mb():.2f} MB")
queries_sample_b = prepare_preprocessed_queries(df_sample_b)

# -------------------------------------------------------------------------
# Stage 7: Core Retrieval Evaluation Engine
# -------------------------------------------------------------------------
def run_evaluation(queries: list[dict], strategy: str) -> dict:
    total_q = len(queries)
    
    cand_counts = np.empty(total_q, dtype=np.uint32)
    query_edge_recalls = []
    query_any_hits = []
    query_complete_hits = []
    singleton_flags = []
    cand_precisions_macro = []
    
    total_tp = 0
    total_gt = 0
    total_positive_cands = 0
    
    cat_A = 0 # Complete recall, <=50 candidates
    cat_B = 0 # Complete recall, >50 candidates
    cat_C = 0 # Partial recall
    cat_D = 0 # Zero hits on positive query
    cat_E = 0 # Singleton contaminated
    
    card_recalls = defaultdict(list)
    s2_edge_recalls = []
    s3_edge_recalls = []
    s2_any_hits = []
    s3_any_hits = []
    s2_comp_hits = []
    s3_comp_hits = []
    
    joint_recalls = []
    joint_any_hits = []
    joint_comp_hits = []
    
    missing_recalls = {
        "Both_Present": [],
        "Addr_Missing": [],
        "Name_Missing": [],
        "Both_Missing": []
    }
    
    positive_f05_bounds = []
    overall_f05_bounds = []

    for i, q in enumerate(queries):
        slices = []
        if "A" in strategy and q["k_ex"]:
            sl = get_postings(buf_exact, off_exact, q["k_ex"])
            if len(sl) > 0: slices.append(sl)
        if "B" in strategy and q["k_so"]:
            sl = get_postings(buf_sorted, off_sorted, q["k_so"])
            if len(sl) > 0: slices.append(sl)
        if "PH" in strategy and q["k_ph"]:
            sl = get_postings(buf_anchor, off_anchor, q["k_ph"])
            if len(sl) > 0: slices.append(sl)
        if strategy == "P" and q["k_p"]:
            sl = get_postings(buf_postal, off_postal, q["k_p"])
            if len(sl) > 0: slices.append(sl)
        elif "P_DIAG" in strategy and q["k_p"]:
            sl = get_postings(buf_postal, off_postal, q["k_p"])
            if len(sl) > 0: slices.append(sl)

        # Zero-copy optimization for single-slice retrieval
        if len(slices) == 0:
            cands = np.empty(0, dtype=np.uint32)
        elif len(slices) == 1:
            cands = slices[0]
        else:
            cands = np.unique(np.concatenate(slices))

        nc = len(cands)
        cand_counts[i] = nc
        
        is_singleton = (q["match_count"] == 0)
        
        if is_singleton:
            if nc > 0:
                singleton_flags.append(1)
                cat_E += 1
            else:
                singleton_flags.append(0)
            overall_f05_bounds.append(1.0)
        else:
            # Positive Query
            total_positive_cands += nc
            gt_set = q["gt_set"]
            n_gt = len(gt_set)
            total_gt += n_gt
            
            cand_set = set(cands)
            hits = cand_set & gt_set
            n_hits = len(hits)
            total_tp += n_hits
            
            rec = n_hits / n_gt
            query_edge_recalls.append(rec)
            query_any_hits.append(1.0 if n_hits > 0 else 0.0)
            query_complete_hits.append(1.0 if n_hits == n_gt else 0.0)
            
            prec = (n_hits / nc) if nc > 0 else 0.0
            cand_precisions_macro.append(prec)
            
            if n_hits == 0:
                cat_D += 1
            elif n_hits < n_gt:
                cat_C += 1
            else:
                if nc > 50:
                    cat_B += 1
                else:
                    cat_A += 1
            
            f05_val = (1.25 * rec) / (0.25 + rec) if rec > 0 else 0.0
            positive_f05_bounds.append(f05_val)
            overall_f05_bounds.append(f05_val)
            
            c_tag = "1_single" if n_gt == 1 else ("2_to_4_plural" if n_gt <= 4 else "5_plus_high")
            card_recalls[c_tag].append(rec)
            
            s2_targets = [cid for cid in q["gt_arr"] if cand_source_arr[cid] == 2]
            s3_targets = [cid for cid in q["gt_arr"] if cand_source_arr[cid] == 3]
            
            if s2_targets:
                s2_hits = len(cand_set & set(s2_targets))
                s2_rec = s2_hits / len(s2_targets)
                s2_edge_recalls.append(s2_rec)
                s2_any_hits.append(1.0 if s2_hits > 0 else 0.0)
                s2_comp_hits.append(1.0 if s2_hits == len(s2_targets) else 0.0)
                
            if s3_targets:
                s3_hits = len(cand_set & set(s3_targets))
                s3_rec = s3_hits / len(s3_targets)
                s3_edge_recalls.append(s3_rec)
                s3_any_hits.append(1.0 if s3_hits > 0 else 0.0)
                s3_comp_hits.append(1.0 if s3_hits == len(s3_targets) else 0.0)
                
            if s2_targets and s3_targets:
                joint_recalls.append(rec)
                joint_any_hits.append(1.0 if n_hits > 0 else 0.0)
                joint_comp_hits.append(1.0 if n_hits == n_gt else 0.0)
                
            if q["has_name"] and q["has_addr"]:
                missing_recalls["Both_Present"].append(rec)
            elif q["has_name"] and not q["has_addr"]:
                missing_recalls["Addr_Missing"].append(rec)
            elif not q["has_name"] and q["has_addr"]:
                missing_recalls["Name_Missing"].append(rec)
            else:
                missing_recalls["Both_Missing"].append(rec)

    c_hist = {
        "0": float(np.mean(cand_counts == 0)),
        "1-5": float(np.mean((cand_counts >= 1) & (cand_counts <= 5))),
        "6-20": float(np.mean((cand_counts >= 6) & (cand_counts <= 20))),
        "21-100": float(np.mean((cand_counts >= 21) & (cand_counts <= 100))),
        "101-1k": float(np.mean((cand_counts >= 101) & (cand_counts <= 1000))),
        ">1k": float(np.mean(cand_counts > 1000)),
    }

    return {
        "Strategy": strategy,
        "Mean_Query_Edge_Recall": float(np.mean(query_edge_recalls)),
        "Sample_Micro_Edge_Recall": float(total_tp / total_gt) if total_gt > 0 else 0.0,
        "Any_Match_Recall": float(np.mean(query_any_hits)),
        "Complete_Recall": float(np.mean(query_complete_hits)),
        "Positive_F05_Bound": float(np.mean(positive_f05_bounds)),
        "Overall_F05_Upper_Bound": float(np.mean(overall_f05_bounds)),
        "Singleton_Contam_Rate": float(np.mean(singleton_flags)) if singleton_flags else 0.0,
        "Macro_Cand_Precision": float(np.mean(cand_precisions_macro)),
        "Positive_Micro_Cand_Precision": float(total_tp / total_positive_cands) if total_positive_cands > 0 else 0.0,
        "Zero_Cand_Rate": float(np.mean(cand_counts == 0)),
        "Mean_Cand": float(np.mean(cand_counts)),
        "P50_Cand": int(np.percentile(cand_counts, 50)),
        "P75_Cand": int(np.percentile(cand_counts, 75)),
        "P95_Cand": int(np.percentile(cand_counts, 95)),
        "P99_Cand": int(np.percentile(cand_counts, 99)),
        "Max_Cand": int(np.max(cand_counts)),
        "Histogram": c_hist,
        "Taxonomy": {
            "Cat_A_Clean": cat_A, "Cat_B_HighCand": cat_B, "Cat_C_Partial": cat_C,
            "Cat_D_Zero": cat_D, "Cat_E_SingletonContam": cat_E
        },
        "Card_Recalls": {k: float(np.mean(v)) for k, v in card_recalls.items()},
        "Source_Splits": {
            "S2_Edge_Rec": float(np.mean(s2_edge_recalls)) if s2_edge_recalls else 0.0,
            "S2_Any_Rec": float(np.mean(s2_any_hits)) if s2_any_hits else 0.0,
            "S2_Comp_Rec": float(np.mean(s2_comp_hits)) if s2_comp_hits else 0.0,
            "S3_Edge_Rec": float(np.mean(s3_edge_recalls)) if s3_edge_recalls else 0.0,
            "S3_Any_Rec": float(np.mean(s3_any_hits)) if s3_any_hits else 0.0,
            "S3_Comp_Rec": float(np.mean(s3_comp_hits)) if s3_comp_hits else 0.0,
            "Joint_Edge_Rec": float(np.mean(joint_recalls)) if joint_recalls else 0.0,
            "Joint_Any_Rec": float(np.mean(joint_any_hits)) if joint_any_hits else 0.0,
            "Joint_Comp_Rec": float(np.mean(joint_comp_hits)) if joint_comp_hits else 0.0,
        },
        "Missing_Recalls": {k: float(np.mean(v)) if v else 0.0 for k, v in missing_recalls.items()},
    }

