    jw_name = jaro_winkler_similarity(q_name, c_name)
    
    if len(shared_name_tokens) > 0:
        name_signals["Shared Name Token (>=1 token)"] += 1
    if q_toks and c_toks and (q_toks.issubset(c_toks) or c_toks.issubset(q_toks)):
        name_signals["Full Token Containment (Subset/Superset)"] += 1
    if jw_name >= 0.88:
        name_signals["High Jaro-Winkler (JW >= 0.88)"] += 1
    if jw_name >= 0.80:
        name_signals["Moderate Jaro-Winkler (JW >= 0.80)"] += 1
    if any(len(t) >= 4 and any(t in ct or ct in t for ct in c_toks) for t in q_toks):
        name_signals["Subword / Prefix Match (len >= 4)"] += 1

