        )
    )

    queries_sample_a.append(
        {
            "qid": qid,
            "cntry": country,
            "business_name": name,
            "k_ex": exact_key(
                name,
                country
            ),
            "k_so": sorted_key(
                name,
                country
            ),
            "name_tokens": canonical_tokens(
                name
            ),
            "gt_set": gt_set
        }
    )

print(
    f"Sample A queries: "
    f"{len(queries_sample_a):,}"
)

print("\nBuilding exact-name index A...")

builder_exact = defaultdict(list)

for i, row in enumerate(
    cand_df.iter_rows(named=True)
):

    key = exact_key(
        row["business_name"],
        norm_country(row["country"])
    )

    builder_exact[key].append(i)

    if i > 0 and i % 1000000 == 0:
        print(
            f"A indexed "
