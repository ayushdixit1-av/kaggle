import os
import re
import json
from pathlib import Path
from collections import Counter
import polars as pl
import numpy as np

# -------------------------------------------------------------------------
# Path Configuration
# -------------------------------------------------------------------------
BASE_DIR = Path("/kaggle/input/datasets/ayushdixit1/ayushd/student_resource/dataset")
TRAIN_DIR = BASE_DIR / "train"
TEST_DIR = BASE_DIR / "test"
OUT_DIR = Path("/kaggle/working/audit_reports")
OUT_DIR.mkdir(parents=True, exist_ok=True)

print("=" * 80)
print("STARTING DEEP FORENSIC AUDIT OF ENTITY RESOLUTION DATASET")
print("=" * 80)

# -------------------------------------------------------------------------
# Helper Functions
# -------------------------------------------------------------------------
RE_CLEAN = re.compile(r'[^A-Za-z0-9\s]')
RE_SPACES = re.compile(r'\s+')
RE_PIN_IN = re.compile(r'\b\d{6}\b')
RE_ZIP_US = re.compile(r'\b\d{5}(?:-\d{4})?\b')
RE_POSTAL_FR = re.compile(r'\b\d{5}\b')
RE_HOUSE = re.compile(
    r'(?i)\b(?:plot|house|bldg|building|shop|door|flat|bungalow|survey|khasra|gala|khata|h\.?\s*no\.?|rue|avenue|bd|boulevard)\b[:\s#.-]*([0-9]+[a-z0-9\/-]*)'
)
RE_HOUSE_LEAD = re.compile(r'^([0-9]{1,4}[a-z]?)\b', re.IGNORECASE)

def norm_str(s: str) -> str:
    if not s:
        return ""
    return RE_SPACES.sub(" ", RE_CLEAN.sub(" ", str(s).upper())).strip()

def sort_tokens(s: str) -> str:
    return " ".join(sorted(norm_str(s).split()))

# -------------------------------------------------------------------------
# 1. Ingest Data
# -------------------------------------------------------------------------
print("\n[1/7] Ingesting files...")
df_s1 = pl.read_csv(TRAIN_DIR / "train_source1.tsv", separator="\t")
df_s2 = pl.read_csv(TRAIN_DIR / "train_source2.tsv", separator="\t")
df_s3 = pl.read_csv(TRAIN_DIR / "train_source3.tsv", separator="\t")
df_gt = pl.read_csv(TRAIN_DIR / "train_ground_truth.tsv", separator="\t")

has_test = (TEST_DIR / "test_source1.tsv").exists()
if has_test:
    df_test_s1 = pl.read_csv(TEST_DIR / "test_source1.tsv", separator="\t")
    print("Test set located successfully.")
else:
    df_test_s1 = None
    print("Test set not found at path, skipping direct test inspection.")

dossier = {}

# -------------------------------------------------------------------------
# 2. Text Drift & Qualitative Pair Extraction
# -------------------------------------------------------------------------
print("\n[2/7] Profiling Text Drift on 50 Random True Ground-Truth Pairs...")
gt_exploded = (
    df_gt.with_columns(
        pl.col("matched_entity_ids").fill_null("").str.split(",")
    )
    .explode("matched_entity_ids")
    .filter(pl.col("matched_entity_ids") != "")
)

df_candidates = pl.concat([df_s2, df_s3])

# Sample 50 edges stratified across US and India
sample_edges = (
    gt_exploded.sample(n=50, seed=1337)
    .join(df_s1, left_on="source1_entity_id", right_on="entity_id")
    .rename({"business_name": "s1_name", "business_address": "s1_address", "country": "country"})
    .join(df_candidates, left_on="matched_entity_ids", right_on="entity_id")
    .rename({"business_name": "cand_name", "business_address": "cand_address"})
    .select([
        "country", "source1_entity_id", "s1_name", "s1_address",
        "matched_entity_ids", "cand_name", "cand_address"
    ])
)

drift_records = sample_edges.to_dicts()
