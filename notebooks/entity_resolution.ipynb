    a = np.asarray(arr, dtype=np.int32)
    return {
        "Mean": f"{np.mean(a):.2f}",
        "P50": int(np.percentile(a, 50)),
        "P95": int(np.percentile(a, 95)),
        "P99": int(np.percentile(a, 99)),
        "Max": int(np.max(a)),
        ">25": int(np.sum(a > 25)),
        ">50": int(np.sum(a > 50)),
        ">100": int(np.sum(a > 100)),
        ">200": int(np.sum(a > 200))
    }

for k_d in K_D_CHOICES:
    recovered_new_edges = 0
    cands_added_all = []
    cands_added_sing = []
    
    for q in SAMPLE:
        qid = q["qid"]
        item = payload_by_qid.get(qid)
        if not item:
            continue
            
        gt_set = item["gt_set"]
        is_singleton = (len(gt_set) == 0)
        abc_pool = set(item["combined"])
        
        # Take at most k_d candidates from ranked D
        d_top = set(ranked_d_cands.get(qid, [])[:k_d])
        
        # Marginal additions strictly outside ABC
        truly_added_cands = d_top - abc_pool
        n_added = len(truly_added_cands)
        
        cands_added_all.append(n_added)
        
        if is_singleton:
            cands_added_sing.append(n_added)
        else:
            new_hits = truly_added_cands & gt_set
            recovered_new_edges += len(new_hits)
            
    stats_all = calc_tail_stats(cands_added_all)
    stats_sing = calc_tail_stats(cands_added_sing)
    
    total_added = int(np.sum(cands_added_all))
    
    sweep_rows.append({
        "K_D": k_d,
        "Recovered Edges": recovered_new_edges,
        "% Target Captured": f"{(recovered_new_edges / max(1, uncompressed_target_new_edges)):.2%}",
        "Global GT Lift": f"+{(recovered_new_edges / max(1, total_gt_sample)):.3%}",
        "Mean Added/Q": stats_all["Mean"],
        "P50": stats_all["P50"],
        "P95": stats_all["P95"],
        "P99": stats_all["P99"],
        "Max": stats_all["Max"],
        ">25": stats_all[">25"],
        ">50": stats_all[">50"],
        ">100": stats_all[">100"],
        "Conversion Ratio (η)": f"{(recovered_new_edges / max(1, total_added)):.5f}",
        "Sing Mean Added": stats_sing["Mean"],
        "Sing Contam Rate": f"{np.mean(np.asarray(cands_added_sing) > 0):.2%}"
    })

report_d2 = pl.DataFrame(sweep_rows)

