        rows.append(row)

    end_pos = len(rows)
    query_offsets.append((q_idx, qid, len(gt_set), gt_set, start_pos, end_pos))

col_names = ["q_idx", "cid", "label"] + feature_names
df_features = pl.DataFrame(rows, schema=col_names, orient="row")
del rows
gc.collect()

print(f"Dataset Built in {time.time() - FEAT_START:.1f}s | Rows (K=100): {df_features.height:,}")
log_telemetry("Feature matrix ready")

# --- 4. 5-Fold Query-Grouped LightGBM ---
print("\n[3/6] Training LightGBM on Enriched Features...")
MODEL_START = time.time()
X = df_features.select(feature_names).to_numpy()
y = df_features["label"].to_numpy()
q_indices = df_features["q_idx"].to_numpy()

oof_preds = np.zeros(len(df_features), dtype=np.float32)

kf = KFold(n_splits=5, shuffle=True, random_state=42)
unique_q = np.unique(q_indices)

params = {
    "objective": "binary",
    "metric": "binary_logloss",
    "boosting_type": "gbdt",
    "learning_rate": 0.08,
    "num_leaves": 31,
    "max_depth": 6,
    "min_child_samples": 50,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "verbosity": -1,
    "n_jobs": -1
}

for fold, (train_q_idx, val_q_idx) in enumerate(kf.split(unique_q)):
    train_queries = set(unique_q[train_q_idx])
    val_queries = set(unique_q[val_q_idx])

    train_mask = np.isin(q_indices, list(train_queries))
    val_mask = np.isin(q_indices, list(val_queries))

    dtrain = lgb.Dataset(X[train_mask], label=y[train_mask])
    dval = lgb.Dataset(X[val_mask], label=y[val_mask], reference=dtrain)

    bst = lgb.train(
        params,
        dtrain,
        num_boost_round=500,
        valid_sets=[dval],
        callbacks=[lgb.early_stopping(50, verbose=False)]
    )

    oof_preds[val_mask] = bst.predict(X[val_mask], num_iteration=bst.best_iteration)
    print(f"  Fold {fold + 1} Done | Best Iteration: {bst.best_iteration}")

print(f"Model Training Runtime: {time.time() - MODEL_START:.1f}s")

df_results = df_features.select(["q_idx", "cid", "label"]).with_columns([
    pl.Series("pred_prob", oof_preds),
    pl.Series("retrieval_rank", df_features["retrieval_rank"])
])

print("\n--- TOP 15 FEATURE IMPORTANCES (GAIN) ---")
imp_df = pl.DataFrame({
    "Feature": feature_names,
    "Gain": bst.feature_importance(importance_type="gain")
}).sort("Gain", descending=True)
print(imp_df.head(15))

# --- 5. Vectorized Metric Engine Setup ---
print("\n[4/6] Initializing High-Speed Vectorized Metric Engine...")
v_q_idx = df_results["q_idx"].to_numpy().astype(np.int32)
v_label = df_results["label"].to_numpy().astype(np.int8)
v_prob  = df_results["pred_prob"].to_numpy().astype(np.float32)
v_rank  = df_results["retrieval_rank"].to_numpy().astype(np.int16)

query_n_gt = np.zeros(N_QUERIES, dtype=np.int32)
for q_idx, qid, match_count, _, _, _ in query_offsets:
    query_n_gt[q_idx] = match_count

is_singleton_mask = (query_n_gt == 0)
is_non_singleton_mask = ~is_singleton_mask
n_singletons = np.count_nonzero(is_singleton_mask)

c_masks = {
    "1": (query_n_gt == 1),
    "2": (query_n_gt == 2),
    "3": (query_n_gt == 3),
    "4": (query_n_gt == 4),
    "5+": (query_n_gt >= 5)
}

def evaluate_fast_vectorized(k_limit, threshold):
    active = (v_rank <= k_limit) & (v_prob >= threshold)
    
    n_pred_per_q = np.bincount(v_q_idx[active], minlength=N_QUERIES)
    tp_per_q = np.bincount(v_q_idx[active & (v_label == 1)], minlength=N_QUERIES)
    
    singleton_hits = (n_pred_per_q[is_singleton_mask] == 0)
    singleton_acc = float(np.mean(singleton_hits)) if n_singletons > 0 else 1.0
    singleton_fpr = 1.0 - singleton_acc
    
    tp_ns = tp_per_q[is_non_singleton_mask]
    n_pred_ns = n_pred_per_q[is_non_singleton_mask]
    n_gt_ns = query_n_gt[is_non_singleton_mask]
    
    fp_ns = n_pred_ns - tp_ns
    fn_ns = n_gt_ns - tp_ns
    
    denom = (1.25 * tp_ns) + (0.25 * fn_ns) + fp_ns
    f05_ns = np.zeros_like(denom, dtype=np.float64)
    valid_denom = denom > 0
    f05_ns[valid_denom] = (1.25 * tp_ns[valid_denom]) / denom[valid_denom]
    
    all_f05 = np.empty(N_QUERIES, dtype=np.float64)
    all_f05[is_singleton_mask] = singleton_hits.astype(np.float64)
    all_f05[is_non_singleton_mask] = f05_ns
    
    card_scores = {}
    for c_key, mask in c_masks.items():
        card_scores[f"F0.5_C{c_key}"] = float(np.mean(all_f05[mask])) if np.any(mask) else 0.0
            
    p_denom = np.maximum(1, n_pred_ns)
    precisions = np.where(n_pred_ns > 0, tp_ns / p_denom, 0.0)
    recalls = tp_ns / n_gt_ns
    
    res = {
        "K": k_limit,
        "Threshold": threshold,
        "Macro F0.5": float(np.mean(all_f05)),
        "Precision": float(np.mean(precisions)),
        "Recall": float(np.mean(recalls)),
        "Non-Sing F0.5": float(np.mean(f05_ns)),
        "Singleton Acc": singleton_acc,
        "Singleton FPR": singleton_fpr
    }
    res.update(card_scores)
    return res

# --- 6. Extended Surface Sweep ---
print("\n[5/6] Executing Extended Sweep: K in [20, 30, 50, 75, 100], Thresholds in [0.15 - 0.65]...")
EVAL_START = time.time()
K_CHOICES = [20, 30, 50, 75, 100]
THRESHOLDS = [0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.50, 0.65]

sweep_records = []
for k_val in K_CHOICES:
    for tau in THRESHOLDS:
        res = evaluate_fast_vectorized(k_val, tau)
        sweep_records.append(res)

eval_df = pl.DataFrame(sweep_records)
print(f"Swept {len(sweep_records)} Configurations in {time.time() - EVAL_START:.2f}s!")

# --- 7. Final Output Reports ---
print("\n" + "=" * 140)
print("BENCHMARK 5A: MACRO F0.5 PIVOT TABLE (Threshold vs Candidate Budget K)")
print("=" * 140)
print(eval_df.pivot(values="Macro F0.5", index="Threshold", on="K").sort("Threshold"))

print("\n--- SINGLETON ACCURACY PIVOT TABLE (Threshold vs Candidate Budget K) ---")
print(eval_df.pivot(values="Singleton Acc", index="Threshold", on="K").sort("Threshold"))

print("\n--- TOP 10 CONFIGURATIONS OVERALL ---")
print(
    eval_df.select([
        "K", "Threshold", "Macro F0.5", "Precision", "Recall", 
        "Non-Sing F0.5", "Singleton Acc", "Singleton FPR"
    ])
    .sort("Macro F0.5", descending=True)
    .head(10)
)

print("\n" + "=" * 110)
print(f"BENCHMARK 5A COMPLETE | Runtime: {time.time() - START_TIME:.1f}s | Peak RAM: {get_peak_ram_mb():,.0f} MB")
print("=" * 110)


import numpy as np
import polars as pl
import time

print("=" * 110)
print("BENCHMARK 5B: BUDGET-CONSTRAINED CONFIDENCE-GATED ABSTENTION SWEEP")
print("=" * 110)

EVAL_START = time.time()

# 1. Pre-extract Contiguous 1D Arrays from df_results
v_q_idx = df_results["q_idx"].to_numpy().astype(np.int32)
v_label = df_results["label"].to_numpy().astype(np.int8)
v_prob  = df_results["pred_prob"].to_numpy().astype(np.float32)
v_rank  = df_results["retrieval_rank"].to_numpy().astype(np.int16)

# Extract ground-truth counts per query
query_n_gt = np.zeros(N_QUERIES, dtype=np.int32)
for q_idx, qid, match_count, _, _, _ in query_offsets:
    query_n_gt[q_idx] = match_count

is_singleton_mask = (query_n_gt == 0)
is_non_singleton_mask = ~is_singleton_mask
n_singletons = np.count_nonzero(is_singleton_mask)
n_non_singletons = np.count_nonzero(is_non_singleton_mask)

print(f"Total Queries: {N_QUERIES:,} | Singletons: {n_singletons:,} ({n_singletons/N_QUERIES:.2%}) | Non-Singletons: {n_non_singletons:,}")

# 2. Fast Evaluation Engine with K-Scoped Query Gate
def evaluate_abstention_k_bounded(k_limit, tau_emit, T_abstain, query_p_max_k):
    # Query passes the existence gate based ONLY on candidates inside top-K
    query_active_gate = (query_p_max_k >= T_abstain)
    
    # Candidate eligibility: within top-K AND above emission threshold
    k_mask = (v_rank <= k_limit)
    cand_eligible = k_mask & (v_prob >= tau_emit)
    
    # Final candidate emission: eligible AND parent query passed the gate
    cand_active = cand_eligible & query_active_gate[v_q_idx]
    
    # Aggregate predictions & true positives per query
    n_pred_per_q = np.bincount(v_q_idx[cand_active], minlength=N_QUERIES)
    tp_per_q = np.bincount(v_q_idx[cand_active & (v_label == 1)], minlength=N_QUERIES)
    
    # 1. Singleton Evaluation (n_gt == 0)
    singleton_hits = (n_pred_per_q[is_singleton_mask] == 0)
    singleton_acc = float(np.mean(singleton_hits)) if n_singletons > 0 else 1.0
    singleton_fpr = 1.0 - singleton_acc
    
    # 2. Non-Singleton Evaluation (n_gt > 0)
    tp_ns = tp_per_q[is_non_singleton_mask]
    n_pred_ns = n_pred_per_q[is_non_singleton_mask]
    n_gt_ns = query_n_gt[is_non_singleton_mask]
    
    fp_ns = n_pred_ns - tp_ns
    fn_ns = n_gt_ns - tp_ns
    
    # Metric: Rate of matchable queries completely starved of predictions
    ns_empty_rate = float(np.mean(n_pred_ns == 0)) if n_non_singletons > 0 else 0.0
    
    # Vectorized F0.5 calculation
    denom = (1.25 * tp_ns) + (0.25 * fn_ns) + fp_ns
    f05_ns = np.zeros_like(denom, dtype=np.float64)
    valid_denom = denom > 0
    f05_ns[valid_denom] = (1.25 * tp_ns[valid_denom]) / denom[valid_denom]
    
    # Macro F0.5 across the entire corpus
    all_f05 = np.empty(N_QUERIES, dtype=np.float64)
    all_f05[is_singleton_mask] = singleton_hits.astype(np.float64)
    all_f05[is_non_singleton_mask] = f05_ns
    
    p_denom = np.maximum(1, n_pred_ns)
    precisions = np.where(n_pred_ns > 0, tp_ns / p_denom, 0.0)
    recalls = tp_ns / n_gt_ns
    
    return {
        "K": k_limit,
        "tau_emit": tau_emit,
        "T_abstain": T_abstain,
        "Macro F0.5": float(np.mean(all_f05)),
        "Precision": float(np.mean(precisions)),
        "Recall": float(np.mean(recalls)),
        "Non-Sing F0.5": float(np.mean(f05_ns)),
        "NS Empty %": ns_empty_rate,
        "Singleton Acc": singleton_acc,
        "Singleton FPR": singleton_fpr
    }

# 3. Execution Grid
K_VALS = [20, 30, 50, 75, 100]
TAU_EMIT_VALS = [0.15, 0.20, 0.25, 0.30, 0.35, 0.40]
T_ABSTAIN_VALS = [0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75]

records = []

for k in K_VALS:
    # Compute query_p_max strictly within the candidate budget K
    k_mask = (v_rank <= k)
    query_p_max_k = np.zeros(N_QUERIES, dtype=np.float32)
    np.maximum.at(query_p_max_k, v_q_idx[k_mask], v_prob[k_mask])
    
    for tau in TAU_EMIT_VALS:
        for t_abs in T_ABSTAIN_VALS:
            if t_abs < tau:
                continue  # T_abstain must be >= tau_emit
            res = evaluate_abstention_k_bounded(k, tau, t_abs, query_p_max_k)
            records.append(res)

sweep_df = pl.DataFrame(records)
print(f"Swept {len(records)} K-bounded configurations in {time.time() - EVAL_START:.2f}s!")

# --- 4. Results Reporting ---

print("\n" + "=" * 140)
print("TOP 15 CONFIGURATIONS OVERALL (MACRO F0.5)")
print("=" * 140)
print(
    sweep_df.select([
        "K", "tau_emit", "T_abstain", "Macro F0.5", "Precision", "Recall", 
        "Non-Sing F0.5", "NS Empty %", "Singleton Acc", "Singleton FPR"
    ])
    .sort("Macro F0.5", descending=True)
    .head(15)
)

print("\n" + "=" * 140)
print("HEAD-TO-HEAD: UNGATED BASELINE (T_abs = tau) VS BEST DUAL-GATED AT EACH K")
print("=" * 140)

comparisons = []
for k in K_VALS:
    # Ungated baseline at tau=0.25 (Benchmark 5A peak region)
    base_row = sweep_df.filter((pl.col("K") == k) & (pl.col("tau_emit") == 0.25) & (pl.col("T_abstain") == 0.25))
    best_row = sweep_df.filter(pl.col("K") == k).sort("Macro F0.5", descending=True).head(1)
    
    comparisons.append(base_row.with_columns(pl.lit("Ungated Baseline").alias("Type")))
    comparisons.append(best_row.with_columns(pl.lit("Best Gated").alias("Type")))

print(
    pl.concat(comparisons).select([
        "Type", "K", "tau_emit", "T_abstain", "Macro F0.5", "Precision", "Recall", 
        "NS Empty %", "Singleton Acc", "Singleton FPR"
    ])
    .sort(["K", "Type"], descending=[False, True])
)

# Macro F0.5 Pivot View at K=50 across tau_emit and T_abstain
print("\n--- MACRO F0.5 DECISION SURFACE AT K=50 (Rows: tau_emit, Cols: T_abstain) ---")
print(
    sweep_df.filter(pl.col("K") == 50)
            .pivot(values="Macro F0.5", index="tau_emit", on="T_abstain")
            .sort("tau_emit")
)


import polars as pl
