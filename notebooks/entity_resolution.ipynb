    scored.sort(
        key=lambda x: (-x[1], x[0])
    )

    s2_ids = [
        cid
        for cid, score, src in scored
        if src == 2
    ]

    s3_ids = [
        cid
        for cid, score, src in scored
        if src == 3
    ]

    combined_ids = [
        cid
        for cid, score, src in scored
    ]

    query_payloads_b.append(
        {
            "qid": q["qid"],
            "match_count": int(
                q["match_count"]
            ),
            "gt_set": gt_set,
            "combined": combined_ids,
            "s2": s2_ids,
            "s3": s3_ids
        }
    )

assert len(query_payloads_b) == 12000

payload_lengths = np.asarray(
    [
        len(x["combined"])
        for x in query_payloads_b
    ],
    dtype=np.int32
)

raw_recall_b = (
    raw_reachable_edges_b
    / total_gt_edges_b
)

print("\n" + "=" * 100)
print("SAMPLE B A+B+C PAYLOAD REBUILD")
