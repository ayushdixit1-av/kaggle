venn_df = pl.DataFrame([
    {
        "Set / Signal": "Total Ground-Truth Edges in Sample",
        "Edges": total_gt_edges,
        "% of Total GT": "100.00%",
        "Notes": "Theoretical Recall Ceiling"
    },
