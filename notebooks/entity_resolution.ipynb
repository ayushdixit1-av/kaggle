        for name, country in zip(names, cntrys):
            cntry = norm_country(country)
            toks = set(canonical_tokens(name))
            seen_pfx = set()
            for t in toks:
                if len(t) >= 5:
                    seen_pfx.add(t[:4])
            for pfx in seen_pfx:
                pfx_df_counter[f"{cntry}§{pfx}"] += 1

print(f"Total Unique Country§Prefix Keys Generated: {len(pfx_df_counter):,}")

# Filter strictly to bounded rare prefixes
usable_prefix_keys = {
    k: v for k, v in pfx_df_counter.items() 
    if MIN_PREFIX_DF <= v <= MAX_PREFIX_DF
}
del pfx_df_counter
gc.collect()
print(f"Retained Usable Prefix Keys ({MIN_PREFIX_DF} <= DF <= {MAX_PREFIX_DF}): {len(usable_prefix_keys):,}")
