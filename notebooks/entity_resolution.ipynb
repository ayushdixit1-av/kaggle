import gc
import pickle
import numpy as np
from pathlib import Path

REPO = Path("/kaggle/working/entity_resolution_repo")
CK = REPO / "checkpoints"

A_DIR = CK / "stage3_exact"
B_DIR = CK / "stage3_sorted"
P_DIR = CK / "stage3_postal"
C_DIR = CK / "stage4_channel_c"

print("=" * 100)
print("STAGE E0: POSTAL MARGINAL RETRIEVAL VALIDATION")
print("=" * 100)

required = [
    A_DIR / "buf_exact.npy",
    A_DIR / "off_exact.pkl",
    B_DIR / "buf_sorted.npy",
    B_DIR / "off_sorted.pkl",
    P_DIR / "buf_postal.npy",
    P_DIR / "off_postal.pkl",
    C_DIR / "queries_sample_a.pkl",
]

missing = []

for p in required:
    if p.exists():
        print(f"OK   {p.relative_to(REPO)}")
    else:
        print(f"MISS {p.relative_to(REPO)}")
        missing.append(str(p))

assert not missing, f"Missing checkpoint files: {missing}"

with open(C_DIR / "queries_sample_a.pkl", "rb") as f:
    SAMPLE = pickle.load(f)

assert len(SAMPLE) == 20_000

sample_keys = set(SAMPLE[0].keys())

print("\nSample A keys:")
print(sorted(sample_keys))

postal_key_count = sum(
    1 for q in SAMPLE
    if q.get("k_p")
)

print(
    f"Queries with postal key: "
    f"{postal_key_count:,} / {len(SAMPLE):,}"
)

assert postal_key_count > 0, "No k_p values found in Sample A"

with open(A_DIR / "off_exact.pkl", "rb") as f:
    off_exact = pickle.load(f)

with open(B_DIR / "off_sorted.pkl", "rb") as f:
    off_sorted = pickle.load(f)

with open(P_DIR / "off_postal.pkl", "rb") as f:
    off_postal = pickle.load(f)

buf_exact = np.load(
    A_DIR / "buf_exact.npy",
    mmap_mode="r"
)

buf_sorted = np.load(
    B_DIR / "buf_sorted.npy",
    mmap_mode="r"
)

buf_postal = np.load(
    P_DIR / "buf_postal.npy",
    mmap_mode="r"
)

assert isinstance(off_exact, dict)
assert isinstance(off_sorted, dict)
assert isinstance(off_postal, dict)

assert buf_exact.dtype == np.uint32
assert buf_sorted.dtype == np.uint32
assert buf_postal.dtype == np.uint32

print("\nIndex preflight passed.")

total_gt_edges = sum(
    len(q["gt_set"])
    for q in SAMPLE
    if q["match_count"] > 0
)

abc_edges = 0
abc_postal_edges = 0

new_edges = 0
new_queries = 0

abc_counts = []
abc_postal_counts = []

postal_only_counts = []

for qi, q in enumerate(SAMPLE):

    if q["match_count"] == 0:
        continue

    exact = set()

    if q.get("k_ex"):
        entry = off_exact.get(q["k_ex"])

        if entry is not None:
            start, length = entry
            vals = buf_exact[
                start:start + length
            ]
            exact.update(map(int, vals))

    sorted_name = set()

    if q.get("k_so"):
        entry = off_sorted.get(q["k_so"])

        if entry is not None:
            start, length = entry
            vals = buf_sorted[
                start:start + length
            ]
            sorted_name.update(map(int, vals))

    abc = exact | sorted_name

    gt = q["gt_set"]

    base_hits = len(
        abc & gt
    )

    abc_edges += base_hits
    abc_counts.append(len(abc))

    postal = set()

    postal_key = q.get("k_p")

    if postal_key:
        key = f"{q['cntry']}§{postal_key}"

        entry = off_postal.get(key)

        if entry is not None:
            start, length = entry
            vals = buf_postal[
                start:start + length
            ]
            postal.update(map(int, vals))

    merged = abc | postal

    merged_hits = len(
        merged & gt
    )

    abc_postal_edges += merged_hits
    abc_postal_counts.append(len(merged))

    delta = merged_hits - base_hits

    if delta > 0:
        new_edges += delta
        new_queries += 1
        postal_only_counts.append(len(postal))

    if (qi + 1) % 5000 == 0:
        print(
            f"Processed {qi + 1:,} / {len(SAMPLE):,}"
        )

abc_micro = (
    abc_edges / total_gt_edges
)

abc_postal_micro = (
    abc_postal_edges / total_gt_edges
)

delta_recall = (
    abc_postal_micro - abc_micro
)

marginal_efficiency = (
    new_edges
    /
    max(
        1,
        np.mean(abc_postal_counts)
        -
        np.mean(abc_counts)
    )
)

print("\n" + "=" * 100)
print("STAGE E0 RESULT")
print("=" * 100)

print(
    f"GT edges                         : "
    f"{total_gt_edges:,}"
)

print(
    f"A+B+C recovered edges            : "
    f"{abc_edges:,}"
)

print(
    f"A+B+C micro recall               : "
    f"{abc_micro:.4%}"
)

print(
    f"A+B+C+Postal recovered edges     : "
    f"{abc_postal_edges:,}"
)

print(
    f"A+B+C+Postal micro recall        : "
    f"{abc_postal_micro:.4%}"
)

print(
    f"Marginal recall lift              : "
    f"{delta_recall:+.4%}"
)

print(
    f"New GT edges from Postal          : "
    f"{new_edges:,}"
)

print(
    f"Queries gaining a GT edge         : "
    f"{new_queries:,}"
)

print(
    f"Mean ABC candidates               : "
    f"{np.mean(abc_counts):.2f}"
)

print(
    f"Mean ABC+Postal candidates        : "
    f"{np.mean(abc_postal_counts):.2f}"
)

print(
    f"Candidate inflation               : "
    f"{np.mean(abc_postal_counts) - np.mean(abc_counts):+.2f}"
)

print(
