import gc
import json
import pickle
import re
import time
import unicodedata
from pathlib import Path

import numpy as np
import polars as pl

REPO = Path("/kaggle/working/entity_resolution_repo")

STAGE1_DIR = REPO / "checkpoints" / "stage1"
STAGE2_DIR = REPO / "checkpoints" / "stage2"
STAGE4_DIR = REPO / "checkpoints" / "stage4_channel_c"

STAGE4_DIR.mkdir(parents=True, exist_ok=True)

print("=" * 100)
print("STAGE 4A — CANONICAL SAMPLE A RECOVERY")
print("=" * 100)

RE_DELIM = re.compile(r'[\s,;/_\-\(\)\[\]]+')
RE_NON_ALPHANUM = re.compile(r'[^\w\s]', re.UNICODE)
RE_SYNTACTIC_ANCHOR = re.compile(
    r'(?i)\b(?:PLOT|SHOP|BLDG|BUILDING|FLAT|DOOR|HOUSE|H\.?\s*NO|NO|RUE|AVENUE)\b[:\s#-]*([0-9]+[A-Z]*)'
)

def canonical_tokens(text: str) -> list[str]:
    if not text:
        return []
    nfkd = unicodedata.normalize("NFKD", str(text))
    ascii_norm = "".join(
        c for c in nfkd
        if not unicodedata.combining(c)
    ).upper()
    cleaned = RE_NON_ALPHANUM.sub(" ", ascii_norm)
    return [
        t for t in RE_DELIM.split(cleaned)
        if t
    ]

def norm_country(c) -> str:
    return str(c).strip().upper() if c is not None else ""

def extract_syntactic_address(tokens: list[str], raw_text: str) -> tuple[str, str]:
    postal = ""
    house = ""

    for t in reversed(tokens):
        if t.isdigit() and len(t) in (5, 6):
            postal = t
            break

    if raw_text:
        m = RE_SYNTACTIC_ANCHOR.search(str(raw_text).upper())
        if m:
            d = re.search(r"\d+", m.group(1))
            if d:
                house = d.group(0)

    return postal, house

assert (STAGE1_DIR / "df_s1_meta.parquet").exists()
assert (STAGE2_DIR / "gt_edges_idx.parquet").exists()

df_s1_meta = pl.read_parquet(
    STAGE1_DIR / "df_s1_meta.parquet"
)

print(f"S1 metadata rows: {df_s1_meta.height:,}")

assert df_s1_meta.height == 2_206_821

required_cols = [
    "entity_id",
    "business_name",
    "business_address",
    "country",
    "match_count",
    "card_bin",
    "has_address",
    "has_name"
]

for col in required_cols:
    assert col in df_s1_meta.columns, f"Missing column: {col}"

df_s1_meta = df_s1_meta.with_columns(
    (
        pl.col("country")
        .cast(pl.Utf8)
        .str.strip_chars()
        .str.to_uppercase()
        + "§"
        + pl.col("card_bin")
    ).alias("stratum")
)

N_TARGET_A = 20_000

strata = (
    df_s1_meta
    .group_by("stratum")
    .agg(pl.len().alias("count"))
    .with_columns(
        (
            pl.col("count") /
            df_s1_meta.height *
            N_TARGET_A
        ).alias("exact_float")
    )
    .with_columns([
        pl.col("exact_float")
        .floor()
        .cast(pl.UInt32)
        .alias("base_draw"),

        (
            pl.col("exact_float")
            - pl.col("exact_float").floor()
        ).alias("remainder")
    ])
)

shortfall = int(
    N_TARGET_A -
    int(strata["base_draw"].sum())
)

strata = (
    strata
    .sort("remainder", descending=True)
    .with_row_index("rank")
    .with_columns(
        (
            pl.col("base_draw")
            +
            pl.when(pl.col("rank") < shortfall)
            .then(1)
            .otherwise(0)
        ).alias("final_draw")
    )
)

assert int(strata["final_draw"].sum()) == N_TARGET_A

sample_chunks = []

for row in strata.iter_rows(named=True):
    sub = df_s1_meta.filter(
        pl.col("stratum") == row["stratum"]
    )

    draw_n = int(row["final_draw"])

    if draw_n > 0:
        sample_chunks.append(
            sub.sample(
                n=draw_n,
                seed=42
            )
        )

df_sample_a = pl.concat(sample_chunks)

assert df_sample_a.height == 20_000

print(f"Sample A rows: {df_sample_a.height:,}")

sample_ids = df_sample_a.select([
    "entity_id",
    "match_count",
    "has_address",
    "has_name",
    "country",
    "business_name",
    "business_address"
])

gt_edges = pl.read_parquet(
    STAGE2_DIR / "gt_edges_idx.parquet"
)

assert gt_edges.height == 7_638_365

sample_gt = (
    gt_edges
    .join(
        sample_ids.select(["entity_id"]),
        left_on="source1_entity_id",
        right_on="entity_id",
        how="inner"
    )
    .group_by("source1_entity_id")
    .agg(
        pl.col("cand_idx")
    )
)

gt_lookup = {}

for row in sample_gt.iter_rows(named=True):
    gt_lookup[row["source1_entity_id"]] = np.asarray(
        row["cand_idx"],
        dtype=np.uint32
    )

queries_sample_a = []

for row in sample_ids.iter_rows(named=True):
    qid = row["entity_id"]

    country = norm_country(
        row["country"]
    )

    name_tokens = canonical_tokens(
        row["business_name"] or ""
    )

    addr_tokens = canonical_tokens(
        row["business_address"] or ""
    )

    postal, house = (
        extract_syntactic_address(
            addr_tokens,
            row["business_address"] or ""
        )
        if addr_tokens
        else ("", "")
    )

    gt_arr = gt_lookup.get(
        qid,
        np.empty(0, dtype=np.uint32)
    )

    gt_set = set(
        gt_arr.tolist()
    )

    expected_match_count = int(
        row["match_count"]
    )

    assert len(gt_arr) == expected_match_count, (
        f"GT cardinality mismatch for {qid}: "
        f"expected {expected_match_count}, "
        f"got {len(gt_arr)}"
    )

    queries_sample_a.append({
        "qid": qid,
        "cntry": country,
        "has_addr": bool(row["has_address"]),
        "has_name": bool(row["has_name"]),
        "match_count": expected_match_count,
        "gt_arr": gt_arr,
        "gt_set": gt_set,
        "k_ex": (
            f"{country}§{' '.join(name_tokens)}"
            if name_tokens
            else ""
        ),
        "k_so": (
            f"{country}§{' '.join(sorted(name_tokens))}"
            if name_tokens
            else ""
        ),
        "k_p": (
            f"{country}§{postal}"
            if postal
            else ""
        ),
        "k_ph": (
            f"{country}§{postal}§{house}"
            if postal and house
            else ""
        )
    })

assert len(queries_sample_a) == 20_000

gt_edges_a = sum(
    len(q["gt_set"])
    for q in queries_sample_a
    if q["match_count"] > 0
)

cardinality_counts = {
    "0_singleton": sum(
        q["match_count"] == 0
        for q in queries_sample_a
    ),
    "1_single": sum(
        q["match_count"] == 1
        for q in queries_sample_a
    ),
    "2_to_4_plural": sum(
        2 <= q["match_count"] <= 4
        for q in queries_sample_a
    ),
    "5_plus_high": sum(
        q["match_count"] >= 5
        for q in queries_sample_a
    )
}

assert sum(cardinality_counts.values()) == 20_000

with open(
    STAGE4_DIR / "queries_sample_a.pkl",
    "wb"
) as f:
    pickle.dump(
        queries_sample_a,
        f,
        protocol=pickle.HIGHEST_PROTOCOL
    )

df_sample_a.write_parquet(
    STAGE4_DIR / "df_sample_a.parquet",
    compression="zstd"
)

manifest = {
    "stage": "stage4_sample_a",
    "status": "verified",
    "queries": 20_000,
    "gt_edges": int(gt_edges_a),
    "seed": 42,
    "sampling": "largest_remainder_country_card_bin",
    "cardinality_counts": cardinality_counts,
    "timestamp_utc": time.strftime(
        "%Y-%m-%dT%H:%M:%SZ",
        time.gmtime()
    )
}

manifest_path = (
    STAGE4_DIR /
    "sample_a_manifest.json"
)

manifest_path.write_text(
    json.dumps(
        manifest,
        indent=2
    )
)

test_df = pl.read_parquet(
    STAGE4_DIR / "df_sample_a.parquet"
)

with open(
    STAGE4_DIR / "queries_sample_a.pkl",
    "rb"
) as f:
    test_queries = pickle.load(f)

assert test_df.height == 20_000
assert len(test_queries) == 20_000

assert sum(
    len(q["gt_set"])
    for q in test_queries
) == gt_edges_a

assert {
    "0_singleton",
    "1_single",
    "2_to_4_plural",
    "5_plus_high"
} == set(cardinality_counts.keys())

print()
print("=" * 100)
print("STAGE 4A RESULT")
print("=" * 100)
print(f"Queries:          {len(test_queries):,}")
print(f"GT edges:         {gt_edges_a:,}")
print(f"Cardinality:      {cardinality_counts}")
print()
print("Saved:")
print(STAGE4_DIR / "queries_sample_a.pkl")
print(STAGE4_DIR / "df_sample_a.parquet")
print(STAGE4_DIR / "sample_a_manifest.json")
print()
print("[PASS] SAMPLE A CHECKPOINT VERIFIED")


