def flatten_store(builder_dict: dict) -> tuple[np.ndarray, dict]:
    total_postings = sum(len(v) for v in builder_dict.values())
    buffer = np.empty(total_postings, dtype=np.uint32)
    offsets = {}
    curr = 0
    for k, v_list in builder_dict.items():
        v_len = len(v_list)
        buffer[curr : curr + v_len] = v_list
        offsets[k] = (curr, v_len)
        curr += v_len
    return buffer, offsets

