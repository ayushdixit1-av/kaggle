        )

        c_tok_list = canonical_tokens(
            c_raw_name
        )

        c_name = " ".join(
            c_tok_list
        )

        c_toks = set(
            c_tok_list
        )

        c_len = max(
            1,
            len(c_name)
        )

        c_tok_count = len(
            c_tok_list
        )

        in_a = cid in exact_rank_map
        in_b = cid in sorted_rank_map

        c_idfs = cand_c_evidence.get(cid)

        in_c = (
            c_idfs is not None
        )

        in_e1a = cid in e1a_cids
        in_e1c = cid in e1c_cids

        r_a = float(
            exact_rank_map.get(
                cid,
                0
            )
        )

        r_b = float(
            sorted_rank_map.get(
                cid,
                0
            )
        )

        c_overlap_cnt = (
            float(len(c_idfs))
            if in_c
            else 0.0
        )

        c_idf_sum = (
            float(sum(c_idfs))
            if in_c
            else 0.0
        )

        c_max_idf = (
            float(max(c_idfs))
            if in_c
            else 0.0
        )

        c_coverage = (
            c_overlap_cnt
            / q_tok_count
            if in_c
            else 0.0
        )

        shared_toks = (
            q_toks & c_toks
        )

        n_shared = len(
            shared_toks
        )

        union_toks = (
            q_toks | c_toks
        )

        token_jaccard = (
            n_shared
            / len(union_toks)
            if union_toks
            else 0.0
        )

        token_containment = (
            1.0
            if (
                q_toks
                and (
                    q_toks.issubset(c_toks)
                    or
                    c_toks.issubset(q_toks)
                )
            )
            else 0.0
        )

        token_set_equal = (
            1.0
            if (
                q_toks == c_toks
                and q_toks
            )
            else 0.0
        )

        jw = jaro_winkler_safe(
            q_name,
            c_name
        )

        lev = levenshtein_ratio(
            q_name,
            c_name
        )

        tri = char_trigram_jaccard(
            q_name,
            c_name
        )

        is_exact_name = (
            1.0
            if q_name == c_name
            else 0.0
        )

        first_match = (
            1.0
            if (
                q_tok_list
                and c_tok_list
                and
                q_tok_list[0]
                ==
                c_tok_list[0]
            )
            else 0.0
        )

        last_match = (
            1.0
            if (
                q_tok_list
                and c_tok_list
                and
                q_tok_list[-1]
                ==
                c_tok_list[-1]
            )
            else 0.0
        )

        clean_c_addr = clean_address_string(
            c_raw_addr
        )

        c_postal = extract_postal_code(
            c_raw_addr
        )

        c_addr_toks = set(
            get_meaningful_alpha_tokens(
                c_raw_addr
            )
        )

        address_exact_match = (
            1.0
            if (
                clean_q_addr
                and clean_c_addr
                and
                clean_q_addr
                ==
                clean_c_addr
            )
            else 0.0
        )

        postal_match = (
            1.0
            if (
                q_postal
                and c_postal
                and
                q_postal
                ==
                c_postal
            )
            else 0.0
        )

        shared_addr = (
            q_addr_toks
            &
            c_addr_toks
        )

        union_addr = (
            q_addr_toks
            |
            c_addr_toks
        )

        addr_token_jaccard = (
            len(shared_addr)
            /
            len(union_addr)
            if union_addr
            else 0.0
        )

        country_match = (
            1.0
            if (
                q_cntry
                ==
                norm_country(
                    c_cntry
                )
                and
                q_cntry != "UNK"
            )
            else 0.0
        )

        e_name_match = (
            1.0
            if (
                (in_e1a or in_e1c)
                and
                (
                    is_exact_name == 1.0
                    or
                    jw >= 0.85
                )
            )
            else 0.0
        )

        feature_values = [
            float(rank),
            1.0 if in_a else 0.0,
            1.0 if in_b else 0.0,
            1.0 if in_c else 0.0,
            1.0 if in_e1a else 0.0,
            1.0 if in_e1c else 0.0,
            r_a,
            r_b,
            1.0 if (in_a and in_b) else 0.0,
            1.0 if (in_a and in_c) else 0.0,
            1.0 if (in_b and in_c) else 0.0,
            e_name_match,
            c_overlap_cnt,
            c_idf_sum,
            c_max_idf,
            c_coverage,
            jw,
            lev,
            tri,
            is_exact_name,
            token_jaccard,
            token_containment,
            token_set_equal,
            float(n_shared),
            first_match,
            last_match,
            float(q_tok_count),
            float(c_tok_count),
            float(
                abs(
                    q_tok_count
                    -
                    c_tok_count
                )
            ),
            float(
                abs(
                    q_len
                    -
                    c_len
                )
                /
                max(
                    q_len,
                    c_len
                )
            ),
            address_exact_match,
            postal_match,
            addr_token_jaccard,
            float(
                len(shared_addr)
            ),
            country_match,
            1.0 if src == 2 else 0.0
        ]

        if len(feature_values) != 36:
            raise RuntimeError(
                f"Feature count failure: "
                f"{len(feature_values)}"
            )

        rows.append(
            [
                q_idx,
                cid,
                1 if cid in gt_set else 0,
                *feature_values
            ]
        )

    end_pos = len(rows)

    query_offsets_treatment.append(
        (
            q_idx,
            qid,
            len(gt_set),
            gt_set,
            start_pos,
            end_pos
        )
    )

    if (q_idx + 1) % 2000 == 0:
        print(
            f"Processed {q_idx + 1:,}/{N_QUERIES:,} queries | "
            f"Rows: {len(rows):,}"
        )

feature_columns = [
