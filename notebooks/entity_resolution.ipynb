    abc_rank_map = {cid: r for r, cid in enumerate(base_abc, start=1)}
    all_candidate_cids = set(base_abc)

    # Deterministic Multi-Tier Ranking (Control B Logic, Zero Address Signals)
    def candidate_priority(cid):
        in_a = cid in exact_rank_map
        in_b = cid in sorted_rank_map
        
        if in_a:
            tier = 1
            sub_rank = exact_rank_map[cid]
        elif in_b:
            tier = 2
            sub_rank = sorted_rank_map[cid]
        else:
            tier = 3
            sub_rank = abc_rank_map.get(cid, 9999)
            
        return (tier, sub_rank, abc_rank_map.get(cid, 9999), cid)

    sorted_cands = sorted(all_candidate_cids, key=candidate_priority)[:MAX_K]
    start_pos = len(rows)

    for rank, cid in enumerate(sorted_cands, start=1):
        c_raw_name, c_cntry, src = get_cand_name_cntry(cid)
        c_tok_list = canonical_tokens(c_raw_name)
        c_name = " ".join(c_tok_list)
        c_toks = set(c_tok_list)
        c_len = max(1, len(c_name))
        c_tok_count = len(c_tok_list)

        in_a = cid in exact_rank_map
        in_b = cid in sorted_rank_map
        c_idfs = cand_c_evidence.get(cid)
        in_c = c_idfs is not None

        r_a = float(exact_rank_map.get(cid, 0))
        r_b = float(sorted_rank_map.get(cid, 0))

        c_overlap_cnt = float(len(c_idfs)) if in_c else 0.0
        c_idf_sum = float(sum(c_idfs)) if in_c else 0.0
        c_max_idf = float(max(c_idfs)) if in_c else 0.0
        c_coverage = (c_overlap_cnt / q_tok_count) if in_c else 0.0

        shared_toks = q_toks & c_toks
        n_shared = len(shared_toks)
